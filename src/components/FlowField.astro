---
// Animated particle scene, optionally over looping nature footage. Use as:
//   <FlowField mode="converge" video="river" layout="background" />  fills its positioned parent
//   <FlowField mode="braid" video="grass"> text </FlowField>          a full width band with content on top
// The video and canvas are decorative; any content passed in stays real, readable text.
import type { FlowMode, Footage } from './flowfield';
interface Props {
  mode: FlowMode;
  video?: Footage;
  layout?: 'background' | 'band';
  class?: string;
}
const { mode, video, layout = 'band', class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class:list={['flowfield', `layout-${layout}`, `mode-${mode}`, className]} data-flowfield={mode}>
  {video && (
    <div class="footage" aria-hidden="true">
      <video
        muted
        loop
        playsinline
        preload="none"
        poster={`${base}esg-${video}.jpg`}
        data-src={`${base}esg-${video}.mp4`}
        tabindex="-1"
      ></video>
    </div>
  )}
  <canvas aria-hidden="true"></canvas>
  {layout === 'band' && <div class="flow-content"><slot /></div>}
</div>

<style>
  .flowfield { position: relative; }
  .layout-background { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .layout-band { min-height: 520px; display: grid; align-items: center; overflow: hidden; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
  .flow-content { position: relative; z-index: 1; }

  /* Footage sits low and dark so particles glow on top and text stays readable */
  .footage { position: absolute; inset: 0; pointer-events: none; }
  .footage video { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) brightness(0.62) contrast(1.05); }
  .footage::after { content: ''; position: absolute; inset: 0; }

  /* Hero: dark on the left where the title sits, fading into the page at the bottom */
  .mode-converge .footage::after {
    background:
      linear-gradient(to right, rgba(15, 18, 22, 0.94) 0%, rgba(15, 18, 22, 0.78) 38%, rgba(15, 18, 22, 0.25) 75%, rgba(15, 18, 22, 0.35) 100%),
      linear-gradient(to bottom, rgba(15, 18, 22, 0.7) 0%, rgba(15, 18, 22, 0) 22%, rgba(15, 18, 22, 0) 70%, #0f1216 100%);
  }
  /* Bands: both sides and both edges melt into the page */
  .mode-braid .footage::after {
    background:
      radial-gradient(ellipse 70% 80% at 50% 50%, rgba(15, 18, 22, 0.45), rgba(15, 18, 22, 0.88)),
      linear-gradient(to bottom, #0f1216 0%, rgba(15, 18, 22, 0) 20%, rgba(15, 18, 22, 0) 80%, #0f1216 100%),
      linear-gradient(to right, #0f1216 0%, rgba(15, 18, 22, 0) 18%, rgba(15, 18, 22, 0) 82%, #0f1216 100%);
  }
  .mode-cycle .footage::after {
    background:
      linear-gradient(to right, rgba(15, 18, 22, 0.95) 0%, rgba(15, 18, 22, 0.8) 35%, rgba(15, 18, 22, 0.3) 70%, rgba(15, 18, 22, 0.55) 100%),
      linear-gradient(to bottom, #0f1216 0%, rgba(15, 18, 22, 0) 22%, rgba(15, 18, 22, 0) 78%, #0f1216 100%);
  }

  /* Particles stay soft behind the hero title */
  .mode-converge canvas {
    -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.55) 40%, #000 62%);
    mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.55) 40%, #000 62%);
  }

  @media (max-width: 760px) {
    .layout-band { min-height: 440px; }
    .mode-converge .footage::after {
      background: linear-gradient(to bottom, rgba(15, 18, 22, 0.9) 0%, rgba(15, 18, 22, 0.75) 45%, rgba(15, 18, 22, 0.3) 75%, #0f1216 100%);
    }
    .mode-converge canvas {
      -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.5) 45%, #000 70%);
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.5) 45%, #000 70%);
    }
    .mode-cycle .footage::after {
      background: linear-gradient(to bottom, #0f1216 0%, rgba(15, 18, 22, 0.85) 20%, rgba(15, 18, 22, 0.75) 45%, rgba(15, 18, 22, 0.3) 70%, #0f1216 100%);
    }
  }
</style>

<script>
  import { startFlowField } from './flowfield';
  import type { FlowMode } from './flowfield';
  import { isPaused, prefersReducedMotion } from './motion';

  // Footage loads only when its section is near the screen, plays only while
  // visible, and follows the page pause button. Reduced motion keeps the still.
  function wireFootage(host: HTMLElement, video: HTMLVideoElement) {
    if (prefersReducedMotion()) return;
    let visible = false;
    const sync = () => {
      if (visible && !isPaused()) {
        if (!video.src && video.dataset.src) video.src = video.dataset.src;
        video.play().catch(() => { /* autoplay blocked: the poster still shows */ });
      } else if (!video.paused) {
        video.pause();
      }
    };
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { rootMargin: '200px' }).observe(host);
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['data-motion'] });
  }

  document.querySelectorAll<HTMLElement>('[data-flowfield]').forEach((host) => {
    const canvas = host.querySelector('canvas');
    if (canvas) startFlowField(host, canvas, host.dataset.flowfield as FlowMode);
    const video = host.querySelector('video');
    if (video) wireFootage(host, video);
  });
</script>
