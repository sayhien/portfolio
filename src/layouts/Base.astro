---
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { site, projects } from '../data/site';
import Rocket from '../components/Rocket.astro';
import BeeGarden from '../components/BeeGarden.astro';
import StarSky from '../components/StarSky.astro';
import ContactMenu from '../components/ContactMenu.astro';

interface Props {
  title: string;
  description?: string;
  /** Long pages: the header hides while scrolling down and slides back in, slimmer, when scrolling up. */
  revealHeader?: boolean;
}
const { title, description = site.intro, revealHeader = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = base;
const year = new Date().getFullYear();
const caseStudies = projects.filter((p) => p.href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <StarSky />
    <a class="skip" href="#main">Skip to content</a>
    <div class="header-slot">
    <header class="site-header" data-reveal-header={revealHeader ? '' : undefined}>
      <div class="wrap bar">
        <a class="brand" href={home}><span class="brand-dot" aria-hidden="true"></span>{site.name}</a>
        <nav aria-label="Primary">
          <ul>
            <li><a href={`${home}#work`}>Case Studies</a></li>
            <li><a href={site.resume} target="_blank" rel="noopener">Resume</a></li>
            <ContactMenu />
            <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          </ul>
        </nav>
      </div>
      <hr class="rule" />
    </header>
    </div>

    <main id="main">
      <slot />
    </main>

    <Rocket />

    <footer class="site-footer">
      <BeeGarden line={site.footerLine}>
        <p class="copyright">&copy; {year} {site.name}</p>
        <nav slot="links" class="footer-links" aria-label="Footer">
          <div>
            <h2 class="foot-head">Case studies</h2>
            <ul class="foot-cases" style={`--rows: ${Math.ceil(caseStudies.length / 2)}`}>
              {caseStudies.map((p) => <li><a href={base + p.href}>{p.title}</a></li>)}
            </ul>
          </div>
          <div>
            <h2 class="foot-head">Resume</h2>
            <ul>
              <li><a href={site.resume} target="_blank" rel="noopener">View my resume</a></li>
            </ul>
          </div>
          <div>
            <h2 class="foot-head">Get in touch</h2>
            <ul>
              <li><a href={`mailto:${site.email}`}>Email</a></li>
              <li><a href={site.whatsappLink} target="_blank" rel="noopener">WhatsApp</a></li>
              <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
            </ul>
          </div>
        </nav>
      </BeeGarden>
    </footer>
    <script>
      import { startHeaderReveal } from '../components/header-reveal';
      const revealing = document.querySelector<HTMLElement>('[data-reveal-header]');
      const slot = revealing?.parentElement;
      if (revealing && slot) startHeaderReveal(revealing, slot);
    </script>
    <script>
      // Ghost loading: shimmer until each image arrives, then fade it in.
      document.querySelectorAll('img').forEach((img) => {
        if (img.complete && img.naturalWidth > 0) return;
        img.classList.add('is-loading');
        const done = () => {
          img.classList.remove('is-loading');
          img.classList.add('is-loaded');
        };
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', () => img.classList.remove('is-loading'), { once: true });
      });
    </script>
  </body>
</html>

<style>
  .site-header .bar {
    display: flex;
    align-items: center;
    min-height: 88px;
    gap: 24px;
  }
  .brand {
    margin-right: auto;
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .brand-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  nav ul {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 15px;
    color: var(--text-2);
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 1px solid transparent;
  }
  nav a:hover { color: var(--text); border-bottom-color: var(--accent); }
  .site-header { position: relative; z-index: 2; }
  /* The floating header: off screen while reading down, a slim glass bar when scrolling up. */
  .site-header.is-floating {
    position: fixed; top: 0; left: 0; right: 0; z-index: 30;
    background: rgba(15, 18, 22, 0.9); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    transform: translateY(-100%); transition: transform 0.3s ease;
  }
  .site-header.is-floating.is-shown { transform: none; }
  .site-header.is-floating .bar { min-height: 60px; }
  @media (prefers-reduced-motion: reduce) { .site-header.is-floating { transition: none; } }
  .site-header nav { position: relative; }
  /* page content sits above the fixed star sky */
  main, .site-footer { position: relative; z-index: 1; }

  @media (max-width: 720px) {
    .site-header .bar { flex-wrap: wrap; gap: 4px 12px; padding-top: 18px; padding-bottom: 10px; min-height: 0; }
    nav { order: 3; width: 100%; }
    nav ul { gap: 20px; flex-wrap: wrap; }
    nav a { font-size: 14px; }
  }

  .site-footer { margin-top: var(--space-2); }
  .copyright { font-size: 14px; color: var(--text); }
  /* Footer links sit in the upper sky of the meadow. A soft dark pool behind
     them keeps light text readable even in the brighter daytime sky. */
  .footer-links {
    display: grid; grid-template-columns: auto auto auto; gap: var(--space-3) var(--space-5);
    padding: var(--space-3) var(--space-4); text-align: left;
    background: radial-gradient(closest-side, rgba(15, 18, 22, 0.55), rgba(15, 18, 22, 0));
  }
  .foot-head { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
  .footer-links ul { list-style: none; margin: 0; padding: 0; display: block; }
  /* Two columns filled top to bottom, laid out as a grid so they can line up with the footer's own columns. */
  .footer-links .foot-cases { display: grid; grid-auto-flow: column; grid-template-rows: repeat(var(--rows), auto); align-content: start; gap: 0 var(--space-4); }
  .footer-links a {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 15px; color: var(--text); text-decoration: none; padding: 0;
    border-bottom: 0; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }
  .footer-links a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 720px) {
    /* Two equal columns with the same gap as the case study list's own two columns, so both line up. */
    .footer-links { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2) var(--space-4); padding: var(--space-2); }
    .footer-links > div:first-child { grid-column: 1 / -1; }
    .footer-links .foot-cases { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .footer-links a { font-size: 14px; }
  }
</style>
