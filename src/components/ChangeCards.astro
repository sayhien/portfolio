---
// Problem and fix cards, one per row. Each card names the problem and the
// fix, then shows a large cutout of the new design with a smaller cutout of
// the old one overlapping its lower left corner. A fix with several pictures
// gets previous and next buttons (see Slides). A problem with nothing to show
// on the old site gets an empty frame that says so.
import SmartImage from './SmartImage.astro';
import Slides from './Slides.astro';
import type { Slide } from './Slides.astro';

type Picture = Slide;
export type Change = {
  problem: string;
  title: string;
  text: string;
  /** Leave out when the old site had nothing, and say why in beforeEmpty. */
  before?: Picture;
  beforeEmpty?: string;
  after: Picture[];
};
interface Props {
  items: Change[];
}
const { items } = Astro.props;
---
<ul class="changes">
  {items.map((c) => (
    <li class="change">
      <div class="c-copy">
        <p class="c-problem"><span>Problem</span>{c.problem}</p>
        <h3>{c.title}</h3>
        <p class="c-text">{c.text}</p>
      </div>
      <div class="c-visual">
        <figure class="c-after">
          <Slides slides={c.after} label={`pictures of ${c.title}`} sizes="(max-width: 700px) 92vw, 720px" />
          <figcaption class="chip">After</figcaption>
        </figure>
        <figure class="c-before">
          {c.before
            ? <SmartImage src={c.before.src} alt={c.before.alt} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 380px" />
            : <div class="c-empty"><p>{c.beforeEmpty ?? 'Not on the old site'}</p></div>}
          <figcaption class="chip chip-before">Before</figcaption>
        </figure>
      </div>
    </li>
  ))}
</ul>

<style>
  .changes { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: grid; gap: var(--gap-card); }
  .change { display: grid; gap: var(--space-3); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-4); }
  .c-copy { display: grid; gap: 10px; max-width: 720px; }
  .c-problem { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 15px; color: var(--text-2); }
  .c-problem span { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .change h3 { font-size: 28px; color: var(--accent); }
  .c-text { font-size: 17px; line-height: 1.6; color: var(--text); }

  /* The new design sits large on the right; the old one tucks under its lower left corner, overlapping a little. */
  .c-visual { position: relative; padding: 0 0 18% 0; }
  .c-visual::before { content: ''; position: absolute; inset: -4% 0 0 20%; border-radius: 50%; background: radial-gradient(circle, var(--accent-soft), transparent 68%); pointer-events: none; }
  figure { position: relative; margin: 0; }
  .c-after { width: 76%; margin-left: auto; }
  .c-before { position: absolute; left: 0; bottom: 0; width: 38%; }
  .c-visual figure :global(img), .c-empty { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top center; border-radius: 10px; border: 1px solid var(--line-2); background: #fff; }
  .c-after :global(img) { box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35); }
  .c-before :global(img), .c-empty { box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5); }
  .c-empty { display: grid; place-items: center; background: var(--surface-2); border: 1px dashed var(--muted); }
  .c-empty p { font-size: 15px; color: var(--text-2); text-align: center; padding: 0 12px; }
  .chip { position: absolute; top: 10px; left: 10px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; background: var(--accent); color: var(--on-accent); }
  .chip-before { background: #2a2f36; color: var(--text); border: 1px solid var(--line-2); }

  @media (max-width: 700px) {
    .change { padding: var(--space-2); }
    .change h3 { font-size: 22px; }
    .c-after { width: 88%; }
    .c-before { width: 50%; }
    .c-visual { padding-bottom: 24%; }
  }
</style>

