---
// Particle earth scene. Use as:
//   <EarthScene mode="globe" layout="background" />   fills its positioned parent
//   <EarthScene mode="arcs"> text </EarthScene>       a full width band with content on top
// The canvas is decorative; any content passed in stays real, readable text.
import type { EarthMode } from './earth-scenes';
interface Props {
  mode: EarthMode;
  layout?: 'background' | 'band';
  class?: string;
}
const { mode, layout = 'band', class: className } = Astro.props;
---
<div class:list={['earth', `layout-${layout}`, `mode-${mode}`, className]} data-earth={mode}>
  <canvas aria-hidden="true"></canvas>
  {layout === 'band' && <div class="earth-content"><slot /></div>}
</div>

<style>
  .earth { position: relative; }
  .layout-background { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  .layout-band { min-height: 640px; display: grid; align-items: start; overflow: hidden; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
  .earth-content { position: relative; z-index: 1; }

  /* Band edges melt into the page */
  .layout-band canvas {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 14%, #000 86%, transparent 100%);
  }
  /* The hero stays dim behind the title on the left and fades out at the bottom */
  .mode-globe canvas {
    -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.45) 45%, #000 72%), linear-gradient(to bottom, #000 78%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.45) 45%, #000 72%), linear-gradient(to bottom, #000 78%, transparent 100%);
    mask-composite: intersect;
  }
  @media (max-width: 760px) {
    .mode-globe canvas {
      -webkit-mask-image: linear-gradient(to bottom, transparent 40%, #000 70%, #000 88%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 40%, #000 70%, #000 88%, transparent 100%);
    }
  }

  @media (max-width: 760px) {
    .layout-band { min-height: 560px; }
  }
</style>

<script>
  import { startEarth } from './earth';
  import type { EarthMode } from './earth';

  document.querySelectorAll<HTMLElement>('[data-earth]').forEach((host) => {
    const canvas = host.querySelector('canvas');
    if (!canvas) return;
    // Without graphics support the scene is simply left out; the content still reads fine.
    if (!startEarth(host, canvas, host.dataset.earth as EarthMode)) host.classList.add('no-earth');
  });
</script>
