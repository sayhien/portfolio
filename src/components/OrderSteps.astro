---
// A short flow told like a mission trajectory. Numbered waypoints sit on a
// line; as the reader scrolls, the line fills to the step in view, that
// step lights up and the screen beside it changes to match. On small screens
// each step shows its own screen above its text instead.
import SmartImage from './SmartImage.astro';
import type { ImageSource } from './SmartImage.astro';

export type OrderStep = { title: string; text: string; img: ImageSource; alt: string };
interface Props {
  steps: OrderStep[];
  cta: { label: string; href: string };
}
const { steps, cta } = Astro.props;
---
<div class="mission" data-mission>
  <div class="m-path">
    <span class="m-track" aria-hidden="true"><span class="m-fill"></span><span class="m-craft"></span></span>
    <ol class="m-steps">
      {steps.map((s, i) => (
        <li class:list={['m-step', { 'is-on': i === 0 }]}>
          <span class="m-num" aria-hidden="true">{i + 1}</span>
          <div class="m-pic">
            <SmartImage src={s.img} alt={s.alt} widths={[640, 960]} sizes="92vw" />
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
      <li class="m-end">
        <a class="o-cta" href={cta.href} target="_blank" rel="noopener">{cta.label}<span class="visually-hidden"> (opens in a new tab)</span><span class="o-arrow" aria-hidden="true">&#8599;</span></a>
      </li>
    </ol>
  </div>
  <div class="m-screen" aria-hidden="true">
    <div class="m-frame">
      {steps.map((s, i) => (
        <div class:list={['m-shot', { 'is-on': i === 0 }]}>
          <SmartImage src={s.img} alt="" widths={[960, 1280, 1920]} sizes="55vw" />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .mission { display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: var(--space-5); margin-top: var(--space-4); }

  /* The trajectory: a faint dashed track, a solid fill up to the step in view, and a glowing craft at its tip. */
  .m-path { position: relative; padding-left: 56px; }
  .m-steps { list-style: none; margin: 0; padding: 0; }
  .m-track { position: absolute; left: 17px; top: 18px; bottom: 60px; width: 2px; background: repeating-linear-gradient(to bottom, var(--line-2) 0 6px, transparent 6px 12px); }
  .m-fill { position: absolute; inset: 0 0 auto 0; height: var(--progress, 0%); background: var(--accent); }
  .m-craft { position: absolute; left: 50%; top: var(--progress, 0%); width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft), 0 0 18px var(--accent); }

  .m-step { position: relative; min-height: 62vh; display: grid; align-content: start; gap: 8px; padding-top: 4px; opacity: 0.45; transition: opacity 0.4s; }
  .m-step.is-on { opacity: 1; }
  .m-num { position: absolute; left: -56px; top: 0; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-family: var(--mono); font-size: 14px; font-weight: 600; color: var(--text); background: var(--surface-2); border: 1px solid var(--line-2); transition: background-color 0.4s, color 0.4s, border-color 0.4s; }
  .m-step.is-on .m-num { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  .m-step h3 { font-size: 26px; }
  .m-step p { font-size: 17px; line-height: 1.6; color: var(--text-2); max-width: 420px; }
  .m-pic { display: none; }
  .m-end { padding-top: var(--space-2); }

  .m-screen { position: relative; }
  .m-frame { position: sticky; top: calc(50vh - min(19vw, 300px)); display: grid; }
  .m-shot { grid-area: 1 / 1; opacity: 0; transition: opacity 0.5s ease; }
  .m-shot.is-on { opacity: 1; }
  .m-shot :global(img), .m-pic :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top center; border-radius: var(--radius); border: 1px solid var(--line-2); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45); }

  .o-cta { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 8px 0 22px; border-radius: 999px; background: var(--text); color: var(--bg); font-weight: 600; text-decoration: none; }
  .o-arrow { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); }
  .o-cta:hover .o-arrow { translate: 2px -2px; }

  /* Small screens: one column, each step carries its own screen above its text. */
  @media (max-width: 860px) {
    .mission { grid-template-columns: minmax(0, 1fr); }
    .m-screen { display: none; }
    .m-path { padding-left: 48px; }
    .m-track { left: 15px; }
    .m-num { left: -48px; width: 32px; height: 32px; }
    .m-step { min-height: 0; padding-bottom: var(--space-5); }
    .m-pic { display: block; margin-bottom: 8px; }
    .m-step h3 { font-size: 22px; }
  }
  @media (prefers-reduced-motion: no-preference) { .o-arrow { transition: translate 0.2s; } }
</style>

<script>
  // A step is in view once its title passes the reading line, a little below the middle. The
  // line fills to the reading point, so it moves smoothly in both directions.
  document.querySelectorAll<HTMLElement>('[data-mission]').forEach((root) => {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.m-step'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('.m-shot'));
    const track = root.querySelector<HTMLElement>('.m-track');
    let active = 0;
    let queued = false;

    const update = () => {
      queued = false;
      const line = innerHeight * 0.62;
      let next = 0;
      steps.forEach((step, i) => { if (step.getBoundingClientRect().top <= line) next = i; });
      if (next !== active) {
        active = next;
        steps.forEach((step, i) => step.classList.toggle('is-on', i === active));
        shots.forEach((shot, i) => shot.classList.toggle('is-on', i === active));
      }
      if (track) {
        const box = track.getBoundingClientRect();
        const progress = Math.min(1, Math.max(0, (line - box.top) / box.height));
        track.style.setProperty('--progress', `${(progress * 100).toFixed(1)}%`);
      }
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  });
</script>
