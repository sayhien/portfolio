---
import Base from './Base.astro';
import '../styles/case-study.css';
import CaseIcon from '../components/CaseIcon.astro';
import EarthScene from '../components/EarthScene.astro';
import CaseSky from '../components/CaseSky.astro';
import type { CaseSkyName } from '../components/case-sky';
import type { EarthMode } from '../components/earth-scenes';
import type { CaseIconKind } from '../components/CaseIcon.astro';

export type Meta = { label: string; value: string };
export type Section = { id: string; title: string };
export type NextLink = { title: string; blurb: string; href: string; icon?: CaseIconKind };

interface Props {
  title: string;
  kicker: string;
  heading: string;
  lede: string;
  meta: Meta[];
  sections: Section[];
  next?: NextLink[];
  heroScene?: EarthMode;
  /** A particle sky for the hero instead of the earth scene (for the other case studies). */
  heroSky?: CaseSkyName;
}
const { title, kicker, heading, lede, meta, sections, next = [], heroScene, heroSky } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<Base title={title} description={lede} revealHeader>
  <article>
    <div class="hero-zone">
    {heroScene && <EarthScene mode={heroScene} layout="background" />}
    {heroSky && <CaseSky name={heroSky} />}
    <header class="wrap cs-hero">
      <p class="eyebrow">{kicker}</p>
      <h1>{heading}</h1>
      <p class="lede">{lede}</p>
      <dl class="meta">
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    </header>
    </div>

    {Astro.slots.has('hero') && (
      <div class="wrap hero-media">
        <slot name="hero" />
      </div>
    )}

    <div class="wrap cs-body">
      <aside class="toc-wrap">
        <details class="toc" open>
          <summary>
            <span class="toc-label">On this page</span>
            <span class="toc-now" data-toc-now></span>
          </summary>
          <nav aria-label="Case study sections">
            <ol>
              {sections.map((s, i) => (
                <li><a href={`#${s.id}`}><span class="n">{pad(i)}</span><span>{s.title}</span></a></li>
              ))}
            </ol>
          </nav>
        </details>
        <div class="toc-progress" aria-hidden="true"><span data-toc-progress></span></div>
      </aside>
      <div class="content cs-content">
        <slot />
      </div>
    </div>

    {next.length > 0 && (
      <section class="wrap more" aria-labelledby="more-title">
        <h2 id="more-title">More case studies</h2>
        <div class="more-grid">
          {next.map((n) => (
            <a class="more-card" href={n.href} rel="noopener">
              <div class="more-head">
                {n.icon && <CaseIcon kind={n.icon} />}
                <h3>{n.title}</h3>
              </div>
              <p>{n.blurb}</p>
              <span class="go">Read case study <span aria-hidden="true">&rarr;</span></span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .hero-zone { position: relative; }
  .cs-hero { position: relative; z-index: 1; padding-top: 96px; padding-bottom: 96px; }
  @media (max-width: 760px) { .cs-hero { padding-top: 64px; padding-bottom: 300px; } }
  .cs-hero .eyebrow { margin-bottom: var(--space-3); }
  h1 { font-size: clamp(40px, 5.2vw, 76px); line-height: 1.02; max-width: 1040px; }
  .lede { font-size: clamp(18px, 1.6vw, 22px); line-height: 1.55; color: var(--text-2); max-width: 780px; margin-top: var(--space-3); }
  .meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
  }
  dt { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  dd { margin: 0; font-size: 16px; line-height: 1.45; }

  .hero-media { margin-bottom: var(--space-5); }

  .cs-body {
    display: grid;
    grid-template-columns: 195px minmax(0, 1fr);
    column-gap: 64px;
    align-items: start;
  }
  /* The side menu moves down while the floating header is showing (see header-reveal.ts). */
  .toc-wrap { position: sticky; top: calc(32px + var(--nav-offset, 0px)); transition: top 0.3s ease; }
  .toc summary {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
    list-style: none;
    cursor: default;
  }
  .toc summary::-webkit-details-marker { display: none; }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc a {
    display: flex;
    gap: 12px;
    padding: 8px 0 8px 16px;
    font-size: 15px;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: none;
    border-left: 2px solid var(--line);
    transition: color 0.2s, border-color 0.2s;
  }
  .toc a:hover { color: var(--text); }
  .toc a[aria-current='true'] { color: var(--text); border-left-color: var(--accent); font-weight: 500; }
  .toc-now, .toc-progress { display: none; }
  .toc .n { font-size: 12px; color: var(--muted); padding-top: 2px; min-width: 20px; font-variant-numeric: tabular-nums; }
  .toc a[aria-current='true'] .n { color: var(--accent); }

  .content { min-width: 0; max-width: 1040px; }

  .more { margin-top: 64px; }
  .more h2 { font-size: clamp(28px, 3vw, 36px); margin-bottom: var(--space-3); }
  .more-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap-card); }
  .more-card {
    display: flex; flex-direction: column; gap: var(--space-1);
    padding: var(--space-3); border-radius: var(--radius);
    background: var(--surface); border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.3s;
  }
  .more-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .more-head { display: flex; align-items: center; gap: var(--space-2); }
  .more-card h3 { font-size: 22px; }
  .more-card p { color: var(--text-2); font-size: 15px; line-height: 1.5; }
  .more-card .go { margin-top: auto; padding-top: var(--space-1); }
  .go { color: var(--accent); font-weight: 600; font-size: 15px; }

  @media (max-width: 1000px) {
    .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs-body { grid-template-columns: minmax(0, 1fr); }
    .toc-wrap {
      top: var(--nav-offset, 0px);
      z-index: 20;
      background: var(--bg);
      margin: 0 calc(var(--gutter) * -1) 24px;
      padding: 0 var(--gutter);
    }
    .toc summary {
      cursor: pointer;
      min-height: 56px;
      padding: 10px 0;
      margin: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-content: center;
      column-gap: 16px;
    }
    .toc-label { grid-column: 1; font-size: 11px; color: var(--muted); }
    .toc-now {
      display: block; grid-column: 1;
      font-family: var(--display); font-size: 17px; letter-spacing: 0; text-transform: none; color: var(--text);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .toc-now:empty { display: none; }
    .toc summary::after {
      content: ''; grid-column: 2; grid-row: 1 / span 2; align-self: center;
      width: 9px; height: 9px; border-right: 2px solid var(--text); border-bottom: 2px solid var(--text);
      transform: translateY(-3px) rotate(45deg); transition: transform 0.2s;
    }
    .toc[open] summary::after { transform: translateY(2px) rotate(-135deg); }
    .toc-progress { display: block; height: 2px; margin: 0 calc(var(--gutter) * -1); background: var(--line); }
    .toc-progress span { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
    .toc nav { max-height: 60vh; overflow: auto; padding-bottom: 12px; }
    .hero-media { margin-bottom: var(--space-4); }
  }
  @media (max-width: 560px) {
    .more-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .meta { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  }
</style>

<script>
  // Opening a case study from a link always starts at the top, unless the link
  // points to a section. Back and forward keep the reader's place.
  const [navigation] = performance.getEntriesByType('navigation') as PerformanceNavigationTiming[];
  if (!location.hash && navigation?.type !== 'back_forward') {
    history.scrollRestoration = 'manual';
    window.scrollTo({ top: 0, behavior: 'instant' });
    // When the site is shown inside a frame (such as a preview window), the frame's
    // own container may keep its old scroll position, so bring the page's top into view there too.
    if (window.self !== window.top) document.documentElement.scrollIntoView({ block: 'start', behavior: 'instant' });
  }

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const toc = document.querySelector<HTMLDetailsElement>('.toc');
  const narrow = window.matchMedia('(max-width: 1000px)');
  const syncOpen = () => { if (toc) toc.open = !narrow.matches; };
  syncOpen();
  narrow.addEventListener('change', syncOpen);

  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const nowLabel = document.querySelector<HTMLElement>('[data-toc-now]');
  const progress = document.querySelector<HTMLElement>('[data-toc-progress]');
  const setCurrent = (id: string) => {
    links.forEach((a) => a.setAttribute('aria-current', String(a.hash.slice(1) === id)));
    const active = byId.get(id);
    if (nowLabel && active) nowLabel.textContent = active.textContent?.replace(/^(\d+)/, '$1 ') ?? '';
  };
  const updateProgress = () => {
    if (!progress) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
  };

  // Pictures above a section may still be loading while the page glides to it,
  // and each one pushes the section further down. After a menu click, start
  // loading those pictures at once, then keep nudging the section back to the
  // top until the reader scrolls on their own or a few seconds pass.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const CHECK_MS = 150, WATCH_MS = 8000, TOLERANCE_PX = 4;
  let lockedId: string | null = null;
  let checkTimer = 0;

  function releaseLock() {
    lockedId = null;
    window.clearInterval(checkTimer);
  }

  function glideTo(target: HTMLElement) {
    target.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
  }

  function loadPicturesAbove(target: HTMLElement) {
    document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => {
      if (img.compareDocumentPosition(target) & Node.DOCUMENT_POSITION_FOLLOWING) img.loading = 'eager';
    });
  }

  /** How far the section is from where it should rest at the top. */
  function driftOf(target: HTMLElement) {
    const offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    return Math.abs(target.getBoundingClientRect().top - offset);
  }

  const atBottom = () => window.scrollY >= document.documentElement.scrollHeight - window.innerHeight - 1;

  function scrollToSection(target: HTMLElement) {
    releaseLock();
    lockedId = target.id;
    loadPicturesAbove(target);
    glideTo(target);
    const started = performance.now();
    let lastY = window.scrollY;
    checkTimer = window.setInterval(() => {
      if (performance.now() - started > WATCH_MS) return releaseLock();
      const moving = Math.abs(window.scrollY - lastY) >= 1;
      lastY = window.scrollY;
      // A short last section rests lower when the page ends, so only nudge when there is room.
      if (!moving && !atBottom() && driftOf(target) > TOLERANCE_PX) glideTo(target);
    }, CHECK_MS);
  }

  ['wheel', 'touchstart', 'keydown'].forEach((type) => window.addEventListener(type, releaseLock, { passive: true }));

  links.forEach((a) => a.addEventListener('click', (event) => {
    const target = document.getElementById(a.hash.slice(1));
    if (!target) return;
    event.preventDefault();
    window.dispatchEvent(new CustomEvent('header:hold', { detail: 1800 })); // keep the header out of the way while gliding
    history.pushState(null, '', a.hash);
    setCurrent(target.id);
    if (narrow.matches && toc) toc.open = false;
    scrollToSection(target);
    // Move keyboard focus to the section too, as a normal in-page link would.
    target.setAttribute('tabindex', '-1');
    target.focus({ preventScroll: true });
  }));

  const sections = Array.from(byId.keys())
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];
  const onScroll = () => {
    updateProgress();
    if (lockedId) { setCurrent(lockedId); return; }
    let current = sections[0]?.id;
    for (const s of sections) {
      if (s.getBoundingClientRect().top <= window.innerHeight * 0.3) current = s.id;
    }
    if (current) setCurrent(current);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
