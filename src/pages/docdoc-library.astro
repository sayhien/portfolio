---
import CaseStudy from '../layouts/CaseStudy.astro';
import SpaceBand from '../components/SpaceBand.astro';
import CardGrid from '../components/CardGrid.astro';
import type { Card } from '../components/CardGrid.astro';
import StepList from '../components/StepList.astro';
import type { Step, Stage } from '../components/StepList.astro';
import Shot from '../components/Shot.astro';
import { nextCaseLinks } from '../data/site';
import { framerImage } from '../data/framer-images';

const sections = [
  { id: 'introduction', title: 'Introduction' },
  { id: 'decision', title: 'Design System Decision' },
  { id: 'alignment', title: 'Company Documentation Alignment' },
  { id: 'expansion', title: 'Library Expansion Process' },
  { id: 'criteria', title: 'Component Criteria' },
  { id: 'core', title: 'The Core of the Library' },
  { id: 'impact', title: 'Impact' },
];

const reasons: Card[] = [
  { icon: 'badge', title: 'Widely used and reliable', text: 'Google supports it and many developers use it, so it is reliable and well maintained.' },
  { icon: 'book', title: 'Clear guidelines', text: 'Detailed documentation helps prevent problems with new components, so everything works smoothly.' },
  { icon: 'code', title: 'Open source', text: 'It is free to use and backed by Google, a trustworthy choice for big projects.' },
];

const specs: Card[] = [
  { icon: 'layers', title: 'User Interface Specification', text: 'A consistent approach to page types like lists, forms and dialogs, describing the components and how they behave.' },
  { icon: 'table', title: 'Logical Data Model', text: 'A detailed picture of the platform’s data structure. Every component had to reflect it accurately.' },
  { icon: 'compass', title: 'Navigation Specification', text: 'The navigation structure of the product: page types and user flows. Components were designed to support them.' },
];

const expansion: Step[] = [
  { icon: 'table', title: 'Logical Data Model', text: 'I studied the data model to find the attributes the policy function card and its details needed. The component had to match this structure.', img: framerImage('91Qgz8lIxNHqvblx45e0ex3U2Q.png'), alt: 'A section of the logical data model' },
  { icon: 'compass', title: 'Navigation Specification', text: 'Building on the data model, this spec set out how the policy function would show its summary and details.', img: framerImage('N0jpRP0vMk6b1EobQh07Ydmi4A.png'), alt: 'A section of the navigation specification' },
  { icon: 'layers', title: 'User Interface Specification', text: 'This set out how the summary and details would appear inside the card, keeping looks and behaviour consistent.', img: framerImage('ivG4ocYsbDxjz8k1ElPHtEsGw.png'), alt: 'A section of the user interface specification' },
  { title: 'Card variant creation', text: 'I created several card variants with their properties in the design library, then checked them against the testing criteria.', img: framerImage('tuYWn3kzqkleFtAZ1U1jHdBEShA.png'), alt: 'Card variants in the design library' },
  { title: 'Design integration and testing', text: 'I placed the card in the design flow and tested it with other components in different layouts. This showed where it could improve.', img: framerImage('jQi8RN4XfbyUVFSGzmZZAMb7vI.png'), alt: 'The card inside a full page layout' },
];

// Component criteria: three stages on one rail. Each step has a spot illustration of the card (card-scenes.ts).
const criteria: (Step | Stage)[] = [
  { stage: 'Set the criteria', text: 'I set up criteria so every new component was useful, efficient and consistent with the design system.' },
  { title: 'Angular design system', text: 'Does the component fit the DocDoc design system, built on Angular Material, both technically and visually?', vignette: 'angularFit' },
  { title: 'Audience', text: 'Who is it for, so we can shape it around their needs?', vignette: 'audienceFaces' },
  { title: 'Responsiveness', text: 'Does it work well on screens of different sizes?', vignette: 'deviceWiden' },
  { title: 'Functionality', text: 'What does it do, what can users do with it, and how does it fit the layout?', vignette: 'layoutParts' },
  { title: 'Best practices', text: 'Which proven methods improve its design and how it works?', vignette: 'familiarPatterns' },
  { title: 'Decision maker', text: 'Feedback from our CTO was key, as he made the final call on design changes.', vignette: 'ctoApproval' },

  { stage: 'Apply them to the card', text: 'See how the criteria shaped the card component. The Material 2 card began plain, then gained what each criterion asked for.' },
  { title: 'Scalability', text: 'What if a component has to hold more data? The Material 2 card only held a title and a paragraph, so we customised it into rows of labels and values. Rows switch on or off, so the card grows or shrinks with the data.', vignette: 'scalableRows' },
  { title: 'Target audience', text: 'Tables were an option, but cards were easier to scan in the member app. That suits healthcare users who need information fast.', vignette: 'tableToCards' },
  { title: 'Responsiveness', text: 'Labels and values keep a 0.7 to 1 ratio on both mobile and desktop.', vignette: 'ratioStretch' },
  { title: 'Functionality', text: 'Tapping the card opens more information on another page. An ellipsis button in the top right offers more options.', vignette: 'tapToOpen' },
  { title: 'Best practices', text: 'Text in both columns is left aligned for easier reading. On desktop, values stay within 50 to 75 characters to reduce eye strain. The layout was inspired by Amazon’s product details, which users already know.', vignette: 'leftAlignedText' },

  { stage: 'Test before release', text: 'Before any component went out, it had to pass ten checks.' },
  { title: 'Width adjustability', text: 'Is the component’s width fixed, fill, or both?', vignette: 'widthStretch' },
  { title: 'Element stability', text: 'Do elements keep their place when the size changes?', vignette: 'stableIcons' },
  { title: 'Content consistency', text: 'Does the content stay the same across variants like default, hover and active?', vignette: 'cardStates' },
  { title: 'Contextual integration', text: 'Does it work with the other components around it?', vignette: 'contextFit' },
  { title: 'Link consistency', text: 'Are components linked to the latest libraries, not old versions?', vignette: 'latestLibrary' },
  { title: 'Style link', text: 'Are colours, icons and fonts linked to the style guide?', vignette: 'styleLinks' },
  { title: 'Dynamic sizing', text: 'Does the component resize itself to fit its content?', vignette: 'dynamicHeight' },
  { title: 'Layer toggling', text: 'Can layers be turned on or off as the context needs?', vignette: 'layerToggles' },
  { title: 'Visibility and dimensions', text: 'When a layer is hidden, does its space disappear too?', vignette: 'hiddenSpace' },
  { title: 'Layer naming', text: 'Are all layers named clearly for the team?', vignette: 'layerNames' },
];

const impact: Card[] = [
  { icon: 'check', title: 'Fewer change requests', text: 'People asked for fewer changes over time, a sign the components were complete and worked well.' },
  { icon: 'link', title: 'Seamless integration', text: 'Everything fits together smoothly, like good service you don’t notice. The system made the team’s work faster and easier.' },
  { icon: 'users', title: 'Team efficiency', text: 'Ready made, clear components let designers and developers focus on user problems instead of rebuilding buttons and menus.' },
  { icon: 'layers', title: 'Consistency at scale', text: 'As the product grew, new parts looked and worked like the rest, keeping the experience clear and unified.' },
];

const next = nextCaseLinks('docdoc-library');
---
<CaseStudy
  title="DocDoc Design Library, a UX case study by Loo Say Hien"
  kicker="Case study, DocDoc"
  heading="One source of truth, every product in its orbit."
  lede="How I built and looked after a design library on Angular Material for a healthcare platform, so the team spent less on upkeep and users got the same experience everywhere."
  meta={[
    { label: 'Role', value: 'UX Designer, leading the design library' },
    { label: 'Timeline', value: '2 years 3 months, Jan 2022 to Apr 2024' },
    { label: 'Responsibilities', value: 'Built and kept the library, co-maintained the UI specifications' },
    { label: 'Product', value: 'DocDoc enterprise healthcare platform' },
  ]}
  sections={sections}
  next={next}
  heroSky="library"
>
  <section id="introduction" class="sec">
    <h2>Introduction</h2>
    <p class="big">A comprehensive design library on Angular Material, made to cut maintenance costs and keep the experience consistent across a healthcare platform.</p>
    <p>Over two years and three months, I led the creation and upkeep of the library, co-maintained the UI specifications, and made sure every component matched the company documentation and Material Design principles.</p>
  </section>

  <section id="decision" class="sec">
    <h2>Design System Decision</h2>
    <p>Our Chief Technology Officer (CTO) wanted a widely used, credible, open source design system. Custom patterns with no technical documentation had kept pushing maintenance costs up.</p>
    <CardGrid items={reasons} />
    <div class="takeaway">
      <b>Impact</b>
      <p>With Angular Material as the base, we got battle tested components and patterns. Development time and upkeep went down, so features shipped faster.</p>
    </div>
  </section>

  <section id="alignment" class="sec">
    <h2>Company Documentation Alignment</h2>
    <p>The library had to stay in line with three core specifications.</p>
    <CardGrid items={specs} />
    <div class="takeaway">
      <b>Why alignment matters</b>
      <p>Every design decision was grounded in what engineering could build. That removed costly rework, shortened development cycles, and gave the whole product team one source of truth.</p>
    </div>
  </section>

  <section id="expansion" class="sec">
    <h2>Library Expansion Process</h2>
    <div class="side">
      <p>Our roadmap decided which functions we worked on, and new components often came out of that work. The card component shows how.</p>
      <Shot src={framerImage('SFbYDxZu9K5jNXgSH6M1d8Bjj9E.png')} alt="The card component used across different screens" />
    </div>
    <StepList items={expansion} />
  </section>

  <section id="criteria" class="sec">
    <SpaceBand name="zodiac" />
    <h2>Component Criteria</h2>
    <p>Every new component went through the same three stages. I set the criteria, applied them to the card, then tested the result before release.</p>
    <StepList items={criteria} />
    <div class="takeaway">
      <b>Production ready components</b>
      <p>Every component the team received was ready for production, with fewer bugs and inconsistencies.</p>
    </div>
  </section>

  <section id="core" class="sec">
    <h2>The Core of the Library</h2>
    <p>Each component was built as variants for its different states, like default, hover and pressed, and conditions such as active and inactive.</p>
    <Shot src={framerImage('lHlJOPp11dQuYWAq5JnAWdxLXnc.png')} alt="Variants of the table elements in the library" />
    <div class="takeaway">
      <b>Why variants matter</b>
      <p>Designers and developers had every state at hand, without rebuilding or changing base components. Design time dropped and interactions stayed consistent.</p>
    </div>
  </section>

  <section id="impact" class="sec">
    <h2>Impact</h2>
    <CardGrid items={impact} columns={2} />
  </section>
</CaseStudy>

<style>
  /* Intro text beside its picture, so the picture stays a supporting size. */
  .side { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-4); align-items: center; }
  .side p { color: var(--text-2); font-size: 18px; line-height: 1.7; }
  .side :global(figure) { margin-top: 0; }
  @media (max-width: 760px) { .side { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); } }

</style>
