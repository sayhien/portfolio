---
// A grid of short cards: an optional icon or small label, a title and a line
// of text. Used for findings, principles, criteria and outcomes.
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';
import type { ImageSource } from './SmartImage.astro';
import type { IconName } from './Icon.astro';
import Vignette from './Vignette.astro';
import type { VignetteName } from './vignettes';

/** `img` shows a small round photo and `vignette` a small UI scene in place of the icon; the card text says the same, so both are decorative. */
export type Card = { title: string; text?: string; icon?: IconName; label?: string; img?: ImageSource; vignette?: VignetteName };
interface Props {
  items: Card[];
  /** Smallest card width before the grid drops a column. */
  min?: number;
  /** A fixed column count on wide screens, to avoid a lone card on the last row. */
  columns?: number;
}
const { items, min = 240, columns } = Astro.props;
---
<ul class:list={['cards', { fixed: columns }]} style={`--min:${min}px;--cols:${columns ?? 1}`}>
  {items.map((card, index) => (
    <li style={`--n:${index}`}>
      {card.img && <SmartImage class="photo" src={card.img} alt="" widths={[160]} sizes="80px" />}
      {card.vignette && <Vignette name={card.vignette} />}
      {!card.img && !card.vignette && card.icon && <span class="tile" aria-hidden="true"><Icon name={card.icon} size={20} /></span>}
      {card.label && <p class="label">{card.label}</p>}
      <h3>{card.title}</h3>
      {card.text && <p class="text">{card.text}</p>}
    </li>
  ))}
</ul>

<style>
  .cards { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min)), 1fr)); gap: var(--gap-card); }
  @media (min-width: 761px) { .fixed { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); } }
  li { display: flex; flex-direction: column; gap: var(--space-1); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-3); }
  .tile { width: 44px; height: 44px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; margin-bottom: 4px; }
  li :global(.photo) { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent-line); margin-bottom: 4px; }
  li :global(.uv) { background: var(--bg); margin-bottom: 8px; }
  .label { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  h3 { font-size: 20px; line-height: 1.3; }
  .text { font-size: 15px; line-height: 1.55; color: var(--text-2); }
</style>
