---
// The rocket film between the page and the footer garden: rockets climbing
// into the top of the atmosphere, then a big one rushes past and its first
// stage falls onto the camera. It plays by itself and is decorative. Without
// graphics support the whole section is removed.
---
<section class="launch" data-launch aria-label="Rocket launch animation">
  <canvas data-launch-canvas aria-hidden="true"></canvas>
</section>

<style>
  /* Room above, and soft top and bottom edges so the film fades in and out instead of being cut off. */
  .launch { position: relative; height: 60vh; min-height: 320px; margin-top: calc(var(--space-5) * 2); overflow: hidden; }
  .launch canvas {
    width: 100%; height: 100%; display: block;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
  }
</style>

<script>
  import { startRocket } from './rocket';

  const section = document.querySelector<HTMLElement>('[data-launch]');
  const canvas = section?.querySelector<HTMLCanvasElement>('[data-launch-canvas]');
  if (section && canvas && !startRocket(section, canvas)) section.remove();
</script>
