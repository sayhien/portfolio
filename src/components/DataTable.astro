---
// A real table for research findings. The first cell of each row is its
// header, with an optional icon that hints at what the row means. Wide tables
// scroll sideways inside a focusable box on small screens.
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import RowArt from './RowArt.astro';
import type { RowArtName } from './row-art';
import Vignette from './Vignette.astro';
import type { VignetteName } from './vignettes';

interface Props {
  caption: string;
  head: string[];
  rows: string[][];
  /** One icon per row, in the same order as the rows. */
  icons?: IconName[];
  /** Or one larger animated picture per row, which explains the row better than an icon. */
  art?: RowArtName[];
  /** Or one small UI scene per row, shown above the row name. Best when the row is about a piece of interface. */
  vignettes?: VignetteName[];
  /** One criticality tag per row, shown under the row name. The words carry the meaning, the colour only helps. */
  tags?: { label: string; level: 'critical' | 'high' | 'medium' | 'low' }[];
}
const { caption, head, rows, icons, art, vignettes, tags } = Astro.props;
const pictures = icons ?? art ?? vignettes;
if (pictures && pictures.length !== rows.length) throw new Error(`DataTable "${caption}" needs one picture per row`);
---
<div class="table-wrap" tabindex="0" role="region" aria-label={caption}>
  <table>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>{head.map((cell) => <th scope="col">{cell}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map(([first, ...rest], index) => (
        <tr style={`--n:${index}`} data-row={index}>
          <th scope="row">
            {vignettes ? (
              <span class="row-head stacked"><Vignette name={vignettes[index]} /><span class="row-text">{first}{tags && <span class={`tag tag-${tags[index].level}`}>{tags[index].label}</span>}</span></span>
            ) : art ? (
              <span class="row-head"><RowArt name={art[index]} /><span class="row-text">{first}{tags && <span class={`tag tag-${tags[index].level}`}>{tags[index].label}</span>}</span></span>
            ) : icons ? (
              <span class="row-head"><span class="tile" aria-hidden="true"><Icon name={icons[index]} size={18} /></span>{first}</span>
            ) : first}
          </th>
          {rest.map((cell) => <td>{cell}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap { margin-top: var(--space-3); overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: 15px; line-height: 1.5; }
  th, td { text-align: left; vertical-align: top; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); background: var(--surface-2); }
  tbody th { color: var(--accent); font-weight: 600; font-size: 14px; letter-spacing: 0.02em; min-width: 150px; }
  td { color: var(--text-2); }
  .row-head { display: flex; align-items: center; gap: 14px; }
  .tile { flex: none; width: 34px; height: 34px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; }
  tbody th:has(.row-head) { min-width: 200px; }
  tbody th:has(.row-art) { min-width: 250px; }
  /* A UI scene sits above the row name */
  .row-head.stacked { flex-direction: column; align-items: flex-start; gap: 12px; }
  .row-head.stacked :global(.uv) { width: 168px; }
  /* In rows with an icon or picture, the text beside it must hold its own: brighter, larger and roomier than a plain table. */
  tbody tr:has(.row-head) > * { vertical-align: middle; padding-block: 22px; }
  tbody tr:has(.row-art) > * { padding-block: 30px; }
  tbody tr:has(.stacked) > * { vertical-align: top; padding-block: 26px; }
  tbody tr:has(.row-head) > td { color: var(--text); font-size: 17px; line-height: 1.6; }
  tbody tr:has(.row-head) > th { font-size: 16px; }
  thead th { white-space: nowrap; }
  .row-text { display: grid; gap: 8px; justify-items: start; }
  .tag { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; border: 1px solid currentColor; }
  .tag-critical { color: var(--danger); background: var(--danger-soft); }
  .tag-high { color: var(--warn); background: var(--warn-soft); }
  .tag-medium { color: var(--accent); background: var(--accent-soft); }
  .tag-low { color: var(--muted); background: transparent; }
</style>
