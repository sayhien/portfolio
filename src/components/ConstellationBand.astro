---
// A short film that opens the design library's Component Criteria: one shared set
// of stars makes ten constellations, like components that make every layout.
// It sits where a space band would, so it is sized and faded the same way.
// Purely decorative: the section below explains the idea in words.
---
<div class="band" data-constellations aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .band { position: relative; height: 460px; margin: 0 0 var(--space-3); }
  canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none;
    /* all four edges melt into the page */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent), linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent), linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .band.no-film { display: none; }
  @media (max-width: 760px) {
    .band { height: 340px; }
  }
</style>

<script>
  import { startConstellations } from './constellation-band';

  document.querySelectorAll<HTMLElement>('[data-constellations]').forEach((band) => {
    const canvas = band.querySelector('canvas');
    if (!canvas || !startConstellations(band, canvas)) band.classList.add('no-film');
  });
</script>
