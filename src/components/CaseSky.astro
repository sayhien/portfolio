---
// A case study's hero sky: a particle scene behind the headline that tells
// the project's story. Use as <CaseSky name="remit" /> inside a positioned
// parent. Decorative only; the headline above it stays real text.
import type { CaseSkyName } from './case-sky';
interface Props {
  name: CaseSkyName;
  /** Height in pixels of the space under the text where the scene shows on phones. */
  band?: number;
}
const { name, band = 300 } = Astro.props;
---
<div class="case-sky" data-case-sky={name} data-band={band} style={`--sky-band: ${band}px`}>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .case-sky { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
  /* dim behind the title on the left, fade out at the bottom */
  canvas {
    -webkit-mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.5) 40%, #000 66%), linear-gradient(to bottom, #000 80%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.5) 40%, #000 66%), linear-gradient(to bottom, #000 80%, transparent 100%);
    mask-composite: intersect;
  }
  @media (max-width: 760px) {
    canvas {
      /* On phones the scene sits in the space under the text (the hero keeps this band free for it), so it never runs behind the words. */
      -webkit-mask-image: linear-gradient(to bottom, transparent calc(100% - var(--sky-band) - 30px), #000 calc(100% - var(--sky-band) + 50px), #000 calc(100% - 40px), transparent 100%);
      mask-image: linear-gradient(to bottom, transparent calc(100% - var(--sky-band) - 30px), #000 calc(100% - var(--sky-band) + 50px), #000 calc(100% - 40px), transparent 100%);
    }
  }
</style>

<script>
  import { startCaseSky } from './case-sky';
  import type { CaseSkyName } from './case-sky';

  document.querySelectorAll<HTMLElement>('[data-case-sky]').forEach((host) => {
    const canvas = host.querySelector('canvas');
    // Without graphics support the sky is left out; the headline still reads fine.
    if (!canvas || !startCaseSky(host, canvas, host.dataset.caseSky as CaseSkyName, Number(host.dataset.band))) host.remove();
  });
</script>
