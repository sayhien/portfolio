---
import CaseStudy from '../layouts/CaseStudy.astro';
import SpaceBand from '../components/SpaceBand.astro';
import DataTable from '../components/DataTable.astro';
import CardGrid from '../components/CardGrid.astro';
import ChangeCards from '../components/ChangeCards.astro';
import OrderSteps from '../components/OrderSteps.astro';
import Shot from '../components/Shot.astro';
import type { Card } from '../components/CardGrid.astro';
import type { Change } from '../components/ChangeCards.astro';
import type { RowArtName } from '../components/row-art';
import { nextCaseLinks } from '../data/site';
import { sectionNumber } from '../layouts/sections';

import afterHome from '../assets/four-leaves/after-home.webp';
import stepsCake from '../assets/four-leaves/steps-cake.webp';
import beforeOrder from '../assets/four-leaves/before-order.webp';
import beforeLook from '../assets/four-leaves/before-look.webp';
import beforeOrigin from '../assets/four-leaves/before-origin.webp';
import beforeLocation from '../assets/four-leaves/before-location.webp';
import beforePoints from '../assets/four-leaves/before-points.webp';
import beforeMailing from '../assets/four-leaves/before-mailing.webp';
import beforeApply from '../assets/four-leaves/before-apply.webp';
import fixOrder from '../assets/four-leaves/fix-order.webp';
import fixLook from '../assets/four-leaves/fix-look.webp';
import fixOrigin from '../assets/four-leaves/fix-origin.webp';
import fixLocation from '../assets/four-leaves/fix-location.webp';
import fixPoints from '../assets/four-leaves/fix-points.webp';
import fixMailing from '../assets/four-leaves/fix-mailing.webp';
import fixApply from '../assets/four-leaves/fix-apply.webp';

const liveSite = 'https://sayhien.github.io/four-leaves-redesign/';

const sections = [
  { id: 'introduction', title: 'Introduction' },
  { id: 'discover', title: 'Discover' },
  { id: 'fixes', title: 'Problems and Fixes' },
  { id: 'ordering', title: 'Ordering a Cake' },
  { id: 'measures', title: 'How I Would Measure It' },
  { id: 'learnings', title: 'Limits and Learnings' },
];
const n = sectionNumber(sections);

const findings: string[][] = [
  ['Ordering is buried', '“Shop Online” is one of eight links of the same size. There is no main button. The link opens a second website. Cakes earn the most money, so each lost visitor is a lost sale.', '7. Flexibility and efficiency of use'],
  ['Disjointed and dated look', 'The main site and the shop look like two different brands. The mix of colours, bars, footers and typefaces makes the site look old and patched together.', '4. Consistency and standards'],
  ['Nothing makes you want the cake', 'The site does not say where the strawberries, cream or flour come from, or who bakes the cake. So people compare on price only, and cheaper shops win.', 'Beyond the ten rules: trust'],
  ['Location is hard to use', 'The “click here to find location” link does not work. Each outlet shows only a street address, so people must copy it into a map app.', '6. Recognition rather than recall'],
  ['Points are hard to value', '“$2 spent = 1 point” and “60 points = $5” make people do the maths. The site does not say this is about 4 to 6% back.', '2. Match between the system and the real world'],
  ['Mailing list is not inviting', 'The sign up is only an email box on a photo. It does not show what people get, such as new cakes or outlet openings.', 'Beyond the ten rules: motivation'],
  ['Apply is far from the role', 'To apply for a job, people must find the form button at the bottom of the page. The button is not next to the role.', '7. Flexibility and efficiency of use'],
  ['Too many typefaces', 'I counted ten different typefaces on the two sites. This makes the brand look less consistent.', '4. Consistency and standards'],
  ['Weak contrast', 'White text on the tan cake tabs has a contrast of about 3.2 to 1. The minimum for small text is 4.5 to 1.', 'Beyond the ten rules: accessibility'],
];
const findingTags: { label: string; level: 'critical' | 'high' | 'medium' | 'low' }[] = [
  { label: 'Critical', level: 'critical' },
  { label: 'High', level: 'high' }, { label: 'High', level: 'high' },
  { label: 'Medium', level: 'medium' }, { label: 'Medium', level: 'medium' }, { label: 'Medium', level: 'medium' },
  { label: 'Medium', level: 'medium' }, { label: 'Medium', level: 'medium' }, { label: 'Medium', level: 'medium' },
];
const findingArt: RowArtName[] = ['buriedOrder', 'twoSites', 'noProof', 'mapPin', 'pointsValue', 'mailList', 'applyFar', 'typefaces', 'lowContrast'];

const changes: Change[] = [
  {
    problem: 'Ordering is buried',
    title: 'One Order button on every page',
    text: 'People browse and buy on one website. The “Order cakes” button stays in the header on every page.',
    before: beforeOrder, beforeAlt: 'Old header: eight links of the same size around the logo, with Shop Online among them',
    after: fixOrder, afterAlt: 'New header with an Order cakes button, above an Order a cake button on the home page',
  },
  {
    problem: 'Disjointed and dated look',
    title: 'One warm patisserie look',
    text: 'A French patisserie style with Asian nostalgia. One serif for headings and one rounded Japanese font for text.',
    before: beforeLook, beforeAlt: 'Old online shop: a black top bar, small grey menu and a flat green banner',
    after: fixLook, afterAlt: 'New cake cards on a cream page, each with sizes, prices and points',
  },
  {
    problem: 'Nothing makes you want the cake',
    title: 'Stories of where it begins',
    text: 'Short films and photos show the growers and farms. A face and a place make quality easy to believe.',
    before: beforeOrigin, beforeAlt: 'Old cake grid: a photo and a name only',
    after: fixOrigin, afterAlt: 'New Where it begins section with a strawberry greenhouse and a peach grower',
  },
  {
    problem: 'Location is hard to use',
    title: 'Outlets on a map',
    text: 'A map of Singapore shows each region. Every outlet has a Directions link that opens the map app.',
    before: beforeLocation, beforeAlt: 'Old outlet list: names only, in two long columns',
    after: fixLocation, afterAlt: 'New outlet finder with a map of Singapore and a Directions link for each outlet',
  },
  {
    problem: 'Points are hard to value',
    title: 'Points shown as money',
    text: 'Each voucher shows its points and how much money comes back, up to 6%.',
    before: beforePoints, beforeAlt: 'Old rewards page: $2 spent equals 1 point, and a table of points for vouchers',
    after: fixPoints, afterAlt: 'New rewards page: three vouchers, each with the percentage returned',
  },
  {
    problem: 'Mailing list is not inviting',
    title: 'A mailing list with reasons',
    text: 'Small drawings show what people get: new cakes, seasonal bakes and outlet openings.',
    before: beforeMailing, beforeAlt: 'Old mailing list: an email box on a photo of cakes',
    after: fixMailing, afterAlt: 'New mailing list with drawings of new cakes, seasonal bakes and outlet openings',
  },
  {
    problem: 'Apply is far from the role',
    title: 'Apply inside each role',
    text: 'Each role has its own “Apply for this role” button, right below the role details.',
    before: beforeApply, beforeAlt: 'Old careers page: role details with no apply button nearby',
    after: fixApply, afterAlt: 'New role card with an Apply for this role button under the details',
  },
];

const orderSteps = [
  { title: 'Choose', text: 'Pick a cake and a size. The price changes at once.' },
  { title: 'Personalise', text: 'Add a free message to the cake.' },
  { title: 'Collection', text: 'Choose an outlet, a date and a two hour slot.' },
  { title: 'Collect', text: 'Show your order at the outlet. You do not need an account.' },
];

const measures: string[][] = [
  ['Online cake orders', 'Orders completed each week', 'Cakes earn the most money.'],
  ['Drop off before payment', 'People who open a cake page but do not pay', 'Shows where the path still loses people.'],
  ['Membership sign ups', 'New members each week', 'Shows if the points table works.'],
  ['Time to order a cake', 'Seconds from the first page to the order confirmation', 'A shorter path should be faster.'],
];
const measureArt: RowArtName[] = ['cakeOrders', 'dropOff', 'signUps', 'orderTime'];

const limits: Card[] = [
  { title: 'No customer research', text: 'I did not talk to customers. The problems come from my review against the ten usability rules.', label: 'Method' },
  { title: 'Most media is AI generated', text: 'Only the cake, career and company photos are real. The films, grower photos and quote are AI generated to show the idea.', label: 'Media' },
  { title: 'The points terms do not match', text: 'The terms say 120 points for a $20 voucher. The rewards page says 160. I would tell the client before launch.', label: 'Found' },
  { title: 'Next step', text: 'Test with five customers. Ask where they would order a cake, and time the first order.', label: 'Learning' },
];

const next = nextCaseLinks('four-leaves');
---
<CaseStudy
  title="Four Leaves Redesign, a UX case study by Loo Say Hien"
  kicker="Concept project, a bakery in Singapore"
  heading="Cakes earn the most money. But the order button was hard to find."
  lede="I redesigned the Four Leaves bakery website. Now people can order a cake from every page."
  meta={[
    { label: 'Role', value: 'UX Designer, sole designer on the project' },
    { label: 'Type', value: 'Self started concept redesign' },
    { label: 'Method', value: 'Double Diamond and Nielsen’s ten usability rules' },
    { label: 'Result', value: 'A working website you can try' },
  ]}
  sections={sections}
  next={next}
  heroSky="chatbot"
>
  <section id="introduction" class="sec">
    <p class="sn">{n('introduction')}</p>
    <h2>Introduction</h2>
    <p class="big">Four Leaves has baked in Singapore since 1981. Cakes earn most of its money. But to order a cake, people must leave the main website for a second shop.</p>
    <p>I redesigned the website to fix this. This is a concept. I have no link with the company, and I did not talk to customers.</p>
    <p><a href={liveSite} target="_blank" rel="noopener">Try the redesigned website</a></p>
    <Shot src={afterHome} alt="The new Four Leaves home page: a green header with a scalloped edge, a film of the bakers, and an Order a cake button" caption="The new home page. The Order cakes button is in the header on every page." frame />
  </section>

  <section id="discover" class="sec">
    <SpaceBand name="station" />
    <p class="sn">{n('discover')}</p>
    <h2>Discover</h2>
    <p>I used the main site and the online shop as a new customer who wants a cake. I checked each page against Nielsen’s ten usability rules.</p>
    <h3 class="sub">Nine problems, most serious first</h3>
    <p>Critical stops an order. High gives less reason to order. Medium adds effort or doubt. These ratings are my judgement.</p>
    <DataTable caption="Nine problems on the current Four Leaves websites, most serious first" head={['Problem', 'What I saw', 'Rule it breaks']} rows={findings} art={findingArt} tags={findingTags} />
    <div class="takeaway">
      <b>Critical: fix this first</b>
      <p>Cakes earn the most money, but ordering is the hardest thing to find. The other fixes only help people who can find the order.</p>
    </div>
  </section>

  <section id="fixes" class="sec">
    <p class="sn">{n('fixes')}</p>
    <h2>Problems and Fixes</h2>
    <p>The goal: more online cake orders and more members. Each fix solves one problem. The small picture is the old site, from October 2026.</p>
    <ChangeCards items={changes} />
  </section>

  <section id="ordering" class="sec">
    <p class="sn">{n('ordering')}</p>
    <h2>Ordering a Cake</h2>
    <p>Ordering now takes four steps, on one website.</p>
    <OrderSteps steps={orderSteps} img={stepsCake} alt="A strawberry cake with whole strawberries on top and cut strawberries around the side" cta={{ label: 'Try ordering a cake', href: `${liveSite}#cakes` }} />
    <h3 class="sub">Try the redesign here</h3>
    <figure class="embed">
      <div class="shot-frame">
        <div class="shot-frame-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <iframe src={liveSite} title="The redesigned Four Leaves website, live" loading="lazy"></iframe>
      </div>
      <figcaption>The live redesign. <a href={liveSite} target="_blank" rel="noopener">Open it in a new tab</a> for the full size.</figcaption>
    </figure>
  </section>

  <section id="measures" class="sec">
    <p class="sn">{n('measures')}</p>
    <h2>How I Would Measure It</h2>
    <p>After launch, I would track four numbers.</p>
    <DataTable caption="Measures to track after launch" head={['Measure', 'How it is counted', 'Why it matters']} rows={measures} art={measureArt} />
  </section>

  <section id="learnings" class="sec">
    <p class="sn">{n('learnings')}</p>
    <h2>Limits and Learnings</h2>
    <p>A concept shows thinking, not results.</p>
    <CardGrid items={limits} />
  </section>
</CaseStudy>

<style>
  .embed { margin: var(--space-3) 0 0; }
  .embed .shot-frame { background: #fff; }
  .embed iframe { display: block; width: 100%; height: min(78vh, 760px); border: 0; background: #fff; }
  .embed figcaption { font-size: 14px; color: var(--muted); margin-top: var(--space-1); }
</style>
