---
// Journey map rendered as real HTML instead of a flattened image.
// Desktop: a sideways scrolling table with sticky row labels and stage
// controls, so people can compare a row across stages.
// Mobile: each stage becomes its own card, read top to bottom.
import { Image } from 'astro:assets';
import { journeyStages } from '../data/esg-journey';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';

const pad = (index: number) => String(index + 1).padStart(2, '0');

// Row labels shared by the sticky column (desktop) and each card (mobile).
const rows: { key: string; label: string }[] = [
  { key: 'stage', label: 'Stage' },
  { key: 'desc', label: 'Description' },
  { key: 'actors', label: 'Actors' },
  { key: 'tools', label: 'Tools' },
  { key: 'pain', label: 'Pain points' },
  { key: 'opportunities', label: 'Opportunities' },
];
const labelOf = (key: string) => rows.find((row) => row.key === key)!;
const splitList = (value: string) => value.split(', ');

// One icon per tool, so every tag in the map reads the same way.
const toolIcons: Record<string, IconName> = {
  'Email': 'mail', 'In-app alerts': 'bell', 'Scheduling': 'calendar',
  'Surveys': 'clipboard', 'Assessments': 'listcog', 'External data': 'link',
  'ERP ESG module': 'layers', 'Input forms': 'text',
  'Validation tools': 'shield', 'Collaboration': 'users',
  'Reporting features': 'bars', 'Document review': 'docs', 'Meeting tools': 'video',
  'Report generation': 'docs', 'Formatting tools': 'tool',
  'Website': 'globe', 'Regulatory portals': 'building',
};
---
<div class="jm" data-journey>
  <div class="jm-bar">
    <p class="jm-hint">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 12h16m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Eight stages. Scroll sideways, or jump to a stage.
    </p>
    <div class="jm-controls">
      <ol class="jm-steps" aria-label="Jump to stage">
        {journeyStages.map((stage, index) => (
          <li>
            <button type="button" data-step={index} aria-label={`Stage ${pad(index)}, ${stage.name}`} title={stage.name}>{pad(index)}</button>
          </li>
        ))}
      </ol>
      <div class="jm-arrows">
        <button type="button" data-dir="-1" aria-label="Previous stages">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" data-dir="1" aria-label="Next stages">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="jm-scroll" tabindex="0" role="region" aria-label="Journey map, eight stages from planning to submission">
    <div class="jm-grid">
      <div class="jm-labels" aria-hidden="true">
        {rows.map((row) => (
          <div class:list={['lab', `lab-${row.key}`]}>
            {row.label}
          </div>
        ))}
      </div>

      {journeyStages.map((stage, index) => (
        <article class="stage" data-stage={index} aria-labelledby={`stage-${index}`}>
          <header class="cell head">
            <span class="num">{pad(index)}</span>
            <h3 id={`stage-${index}`}>{stage.name}</h3>
          </header>
          <div class="cell desc">
            <Image src={stage.image} alt="" widths={[200, 380]} sizes="200px" loading="lazy" />
            <p>{stage.description}</p>
          </div>
          <div class="cell">
            <h4 class="row-label">Actors</h4>
            <ul class="chips">{splitList(stage.actors).map((actor) => <li><Icon name="person" size={14} />{actor}</li>)}</ul>
          </div>
          <div class="cell">
            <h4 class="row-label">Tools</h4>
            <ul class="chips tools">{splitList(stage.tools).map((tool) => <li><Icon name={toolIcons[tool] ?? 'tool'} size={14} />{tool}</li>)}</ul>
          </div>
          <div class="cell pain">
            <h4 class="row-label">{labelOf('pain').label}</h4>
            <ul class="marks">{stage.painPoints.map((item) => <li><Icon name="alert" size={15} />{item}</li>)}</ul>
          </div>
          <div class="cell opp">
            <h4 class="row-label">{labelOf('opportunities').label}</h4>
            <ul class="marks">{stage.opportunities.map((item) => <li><Icon name="rise" size={15} />{item}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </div>
  <p class="jm-caption">Unified journey map across all departments, based on the present state.</p>
</div>

<style>
  .jm { --label-w: 116px; --col-w: 272px; --pain: var(--danger-soft); --pain-ink: var(--danger); --opp: var(--accent-soft); --opp-ink: var(--accent); margin-top: var(--space-3); }

  /* Controls */
  .jm-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .jm-hint { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--muted); }
  .jm-hint svg { color: var(--accent); }
  .jm-controls { display: flex; align-items: center; gap: 16px; }
  .jm-steps { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .jm-steps button, .jm-arrows button {
    font: inherit; cursor: pointer; border: 1px solid var(--line); background: var(--surface); color: var(--text-2);
    display: grid; place-items: center; transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .jm-steps button { width: 36px; height: 36px; border-radius: 999px; font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .jm-steps button.in-view { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .jm-steps button:hover:not(.in-view) { border-color: var(--text); color: var(--text); }
  .jm-arrows { display: flex; gap: 6px; }
  .jm-arrows button { width: 44px; height: 44px; border-radius: 999px; color: var(--text); }
  .jm-arrows button:hover:not(:disabled) { background: var(--text); color: var(--bg); border-color: var(--text); }
  .jm-arrows button:disabled { opacity: 0.35; cursor: default; }

  /* Scroller */
  .jm-scroll {
    position: relative;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--label-w);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    scrollbar-color: var(--line-2) transparent;
  }
  .jm[data-more-right] .jm-scroll { mask-image: linear-gradient(to right, #000 calc(100% - 72px), transparent); }

  .jm-grid {
    display: grid;
    grid-template-columns: var(--label-w) repeat(8, var(--col-w));
    grid-template-rows: repeat(6, auto);
    width: max-content;
  }

  /* Sticky row labels */
  .jm-labels {
    grid-row: 1 / span 6;
    display: grid; grid-template-rows: subgrid;
    position: sticky; left: 0; z-index: 2;
    background: var(--surface);
    border-right: 1px solid var(--line);
    box-shadow: 6px 0 12px -10px rgba(0, 0, 0, 0.4);
  }
  .lab {
    display: flex; align-items: flex-start; gap: 8px;
    padding: 18px 12px; border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: 10px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted);
    min-width: 0; overflow-wrap: anywhere;
  }
  .lab-stage { border-top: 0; align-items: center; }
  .lab-pain { color: var(--pain-ink); }
  .lab-opportunities { color: var(--opp-ink); }

  /* Stage columns */
  .stage { grid-row: 1 / span 6; display: grid; grid-template-rows: subgrid; scroll-snap-align: start; border-right: 1px solid var(--line); }
  .stage:last-child { border-right: 0; }
  .cell { padding: 18px 20px; border-top: 1px solid var(--line); font-size: 15px; line-height: 1.5; color: var(--text-2); }
  .row-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .head { border-top: 0; display: flex; align-items: center; gap: 12px; position: relative; padding-top: 20px; padding-bottom: 20px; }
  .head::after { content: ''; position: absolute; left: 56px; right: 0; top: 50%; height: 1px; background: var(--line); z-index: 0; }
  .num {
    flex: none; position: relative; z-index: 1;
    width: 32px; height: 32px; border-radius: 999px; display: grid; place-items: center;
    background: var(--accent); color: var(--on-accent); font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .head h3 { position: relative; z-index: 1; font-size: 19px; line-height: 1.2; color: var(--text); background: var(--surface); padding-right: 12px; }

  .desc { display: flex; flex-direction: column; gap: 12px; }
  .desc :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 6px; }
  .desc p { color: var(--text); }

  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; line-height: 1.3; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 4px 10px 4px 8px; color: var(--text); }
  .chips :global(svg) { color: var(--accent); }
  .chips.tools li { background: var(--surface-2); border-color: transparent; }
  .marks { list-style: none; padding: 0; display: grid; gap: 8px; }
  .marks li { display: grid; grid-template-columns: 15px minmax(0, 1fr); gap: 8px; align-items: start; }
  .marks :global(svg) { margin-top: 3px; }
  .pain .marks :global(svg) { color: var(--pain-ink); }
  .opp .marks :global(svg) { color: var(--opp-ink); }
  .cell ul { margin: 0; padding: 0; }
  .pain, .opp { color: var(--text); }

  .jm-caption { font-size: 14px; color: var(--muted); margin-top: 12px; }

  /* Mobile: stack the stages as cards, read top to bottom */
  @media (max-width: 700px) {
    .jm-bar { display: none; }
    .jm-scroll { overflow: visible; border: 0; background: none; mask-image: none !important; }
    .jm-grid { display: flex; flex-direction: column; gap: var(--gap-card); width: auto; }
    .jm-labels { display: none; }
    .stage { display: block; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
    .stage:last-child { border-right: 1px solid var(--line); }
    .head::after { display: none; }
    .desc { flex-direction: row; align-items: center; gap: 14px; border-top: 0; padding-top: 0; }
    .desc :global(img) { width: 88px; aspect-ratio: 1; flex: none; }
    .row-label {
      position: static; width: auto; height: auto; clip: auto; white-space: normal;
      font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--muted); margin-bottom: 8px; display: flex; align-items: center; gap: 6px;
    }
    .pain .row-label { color: var(--pain-ink); }
    .opp .row-label { color: var(--opp-ink); }
  }
</style>

<script>
  function setupJourneyMap(root: HTMLElement) {
    const scroller = root.querySelector<HTMLElement>('.jm-scroll');
    const labels = root.querySelector<HTMLElement>('.jm-labels');
    if (!scroller || !labels) return;
    const stages = Array.from(root.querySelectorAll<HTMLElement>('.stage'));
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-step]'));
    const [prev, next] = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dir]'));
    const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

    const scrollToStage = (index: number) => {
      const target = stages[Math.max(0, Math.min(index, stages.length - 1))];
      scroller.scrollTo({ left: target.offsetLeft - labels.offsetWidth, behavior: smooth });
    };

    // A stage counts as in view when at least half of it is visible.
    const visibleStages = () => {
      const left = scroller.scrollLeft + labels.offsetWidth;
      const right = scroller.scrollLeft + scroller.clientWidth;
      return stages
        .map((stage, index) => ({ index, start: stage.offsetLeft, end: stage.offsetLeft + stage.offsetWidth }))
        .filter((s) => Math.min(s.end, right) - Math.max(s.start, left) >= (s.end - s.start) / 2)
        .map((s) => s.index);
    };

    const update = () => {
      const inView = visibleStages();
      steps.forEach((step, index) => step.classList.toggle('in-view', inView.includes(index)));
      const atStart = scroller.scrollLeft <= 2;
      const atEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 2;
      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd;
      root.toggleAttribute('data-more-right', !atEnd);
    };

    steps.forEach((step, index) => step.addEventListener('click', () => scrollToStage(index)));
    [prev, next].forEach((button) => button?.addEventListener('click', () => {
      const inView = visibleStages();
      const direction = Number(button.dataset.dir);
      const first = inView[0] ?? 0;
      scrollToStage(direction > 0 ? first + Math.max(1, inView.length) : first - Math.max(1, inView.length));
    }));
    scroller.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  document.querySelectorAll<HTMLElement>('[data-journey]').forEach(setupJourneyMap);
</script>
