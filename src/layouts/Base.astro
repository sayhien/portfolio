---
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { site } from '../data/site';
import BeeGarden from '../components/BeeGarden.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = site.intro } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = base;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={home}><span class="brand-dot" aria-hidden="true"></span>{site.name}</a>
        <nav aria-label="Primary">
          <ul>
            <li><a href={`${home}#work`}>Case Studies</a></li>
            <li><a href={site.resume} target="_blank" rel="noopener">Resume</a></li>
            <li><a href={`mailto:${site.email}`}>Contact</a></li>
            <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          </ul>
        </nav>
      </div>
      <hr class="rule" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap"><hr class="rule" /></div>
      <BeeGarden>
        <p class="copyright">&copy; {year} {site.name}</p>
      </BeeGarden>
    </footer>
    <script>
      // Ghost loading: shimmer until each image arrives, then fade it in.
      document.querySelectorAll('img').forEach((img) => {
        if (img.complete && img.naturalWidth > 0) return;
        img.classList.add('is-loading');
        const done = () => {
          img.classList.remove('is-loading');
          img.classList.add('is-loaded');
        };
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', () => img.classList.remove('is-loading'), { once: true });
      });
    </script>
  </body>
</html>

<style>
  .site-header .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 88px;
    gap: 24px;
  }
  .brand {
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.02em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .brand-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-size: 15px;
    color: var(--text-2);
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 1px solid transparent;
  }
  nav a:hover { color: var(--text); border-bottom-color: var(--accent); }
  .site-header { position: relative; z-index: 2; }

  @media (max-width: 720px) {
    .site-header .bar { flex-direction: column; align-items: flex-start; gap: 4px; padding-top: 18px; padding-bottom: 10px; min-height: 0; }
    nav ul { gap: 20px; flex-wrap: wrap; }
    nav a { font-size: 14px; }
  }

  .site-footer { margin-top: 120px; }
  .copyright { font-size: 14px; color: var(--muted); }
</style>
