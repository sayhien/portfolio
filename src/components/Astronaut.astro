---
// The farewell astronaut, between the page and the footer garden. Scrolling
// through it tells a short story: a look into his helmet, the gold visor
// lowering to reflect the garden, a wave goodbye as space pulls him away, then
// a swoosh down to Earth that lands on the garden. It is purely decorative, so
// it is hidden from screen readers. Without graphics support it is removed.
---
<section class="farewell" data-farewell aria-hidden="true">
  <div class="farewell-sticky">
    <canvas data-farewell-canvas></canvas>
  </div>
</section>

<style>
  /* The tall block gives the story its scroll distance; the canvas stays pinned. */
  .farewell { position: relative; height: 320vh; }
  .farewell-sticky { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .farewell canvas { width: 100%; height: 100%; display: block; }
  @media (prefers-reduced-motion: reduce) {
    .farewell { height: 100vh; }
    .farewell-sticky { position: relative; }
  }
</style>

<script>
  import { startAstronaut } from './astronaut';

  const section = document.querySelector<HTMLElement>('[data-farewell]');
  const canvas = section?.querySelector<HTMLCanvasElement>('[data-farewell-canvas]');
  if (section && canvas && !startAstronaut(section, canvas)) section.remove();
</script>
