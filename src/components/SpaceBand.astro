---
// A short space film that opens a case study section, placed just above the
// section's number and title so it reads as that section's picture.
// Use as <SpaceBand name="station" />. It is purely decorative: the section
// below explains the idea in words.
import type { BandName } from './space-band';

interface Props {
  name: BandName;
}
const { name } = Astro.props;
---
<div class="band" data-space-band={name} aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .band { position: relative; height: 460px; margin: 0 0 var(--space-3); }
  canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none;
    /* all four edges melt into the page */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent), linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent), linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect;
  }
  .band.no-film { display: none; }
  @media (max-width: 760px) {
    .band { height: 340px; }
  }
</style>

<script>
  import { startSpaceBand } from './space-band';
  import type { BandName } from './space-band';

  document.querySelectorAll<HTMLElement>('[data-space-band]').forEach((band) => {
    const canvas = band.querySelector('canvas');
    // Without graphics support the film is left out; the section still reads fine.
    if (!canvas || !startSpaceBand(band, canvas, band.dataset.spaceBand as BandName)) band.classList.add('no-film');
  });
</script>
