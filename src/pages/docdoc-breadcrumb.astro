---
import CaseStudy from '../layouts/CaseStudy.astro';
import SpaceBand from '../components/SpaceBand.astro';
import CardGrid from '../components/CardGrid.astro';
import type { Card } from '../components/CardGrid.astro';
import StepList from '../components/StepList.astro';
import type { Step } from '../components/StepList.astro';
import Shot from '../components/Shot.astro';
import { caseLinks } from '../data/site';
import { framerImage } from '../data/framer-images';
import { sectionNumber } from '../layouts/sections';

const sections = [
  { id: 'introduction', title: 'Introduction' },
  { id: 'problem', title: 'Problem Statement' },
  { id: 'matrix', title: 'Impact Effort Matrix' },
  { id: 'considerations', title: 'Design Considerations' },
  { id: 'usability-test', title: 'Usability Test' },
  { id: 'challenges', title: 'Challenges and Learnings' },
];
const n = sectionNumber(sections);

const considerations: Step[] = [
  { title: 'Should the crumb be more specific?', text: 'Show the exact serial number, CL1000001, in place of a generic “Edit claim” crumb, for more accuracy.', img: framerImage('BZTm0j5WgEmigwastXcUUKuvH4U.png'), alt: 'A crumb with a generic label beside one with a specific serial number' },
  { title: 'Should the tab be more specific?', text: 'Add the tab label into the page title crumb, for more accuracy.', img: framerImage('0qseD3jR1QLI84AhEMGzB4fKQ.png'), alt: 'Page title crumb with and without the tab label' },
  { title: 'How to show many crumbs?', text: 'Three ideas: an ellipsis that expands every crumb when clicked, a menu that opens when clicked, and a horizontal scrollbar that appears when the user hovers over the trail.', img: framerImage('xkM0gvF4CuoGtV70JSEp1crAJs.png'), alt: 'Three ways to show a long trail of crumbs' },
  { title: 'Can the idea work on every layer?', text: 'The enterprise app can go eight layers deep, so I tested whether each idea still worked at the deepest one.', img: framerImage('XzhvuAMeMQbOuHgKJuCUiTiPXYA.png'), alt: 'The app’s hierarchy of layers' },
];

const options = [
  { title: 'Menu', badge: 'Participants’ favourite', text: 'Users click an ellipsis to open a menu of the hidden crumbs. Most participants liked it for looking clean and minimal. But Angular Material, which we follow, has no such pattern and no technical documentation for it, so engineering saw it as risky to build.', file: 'VGixQMbk72UrO2ylzmSKmCuGqKc.gif', alt: 'Animation of the menu idea: an ellipsis opens a list of hidden crumbs' },
  { title: 'Reveal trail', badge: 'Engineering’s favourite', chosen: true, text: 'Clicking an ellipsis reveals the hidden crumbs in place. This matched Atlassian’s documented pattern, so engineering could build it with confidence.', file: 'rUshRODZTWVCNwyDiOw1Tjc7OQ.gif', alt: 'Animation of the reveal trail idea: clicking the ellipsis shows the hidden crumbs inline' },
  { title: 'Horizontal scrollbar', text: 'Users click and drag a horizontal scrollbar to see crumbs hidden off to the right.', file: 'RX5i0jCxGWURojufS3anT61UfsU.gif', alt: 'Animation of the horizontal scrollbar idea' },
];

const learnings: Card[] = [
  { icon: 'code', title: 'From sketch to CTO pushback', text: 'Check technical limits before usability testing, or the option users love may not be one engineering can ship. Keep the design simple enough for developers to build quickly.' },
  { icon: 'users', title: 'From silos to reconnection', text: 'We usually work fast and apart, so product managers, designers and engineers rarely brainstorm or rank ideas together. Worried we were drifting, I invited everyone in. One morning in FigJam brought notes, debate and laughter, and we left feeling like one team again.' },
];

const next = caseLinks(['docdoc-library', 'esg-reporting-module']);
---
<CaseStudy
  title="DocDoc Breadcrumb, a UX case study by Loo Say Hien"
  kicker="Case study, DocDoc"
  heading="Land exactly where you meant to be."
  lede="Staff in our healthcare enterprise app couldn’t tell where they were or how pages connected. I led the search for a breadcrumb that keeps them oriented, then changed course when the favourite couldn’t be built well."
  meta={[
    { label: 'Role', value: 'UX Designer' },
    { label: 'Timeline', value: '3 weeks, Mar 2024' },
    { label: 'Responsibilities', value: 'Research, group facilitation and user interface design' },
    { label: 'Product', value: 'DocDoc enterprise healthcare app' },
  ]}
  sections={sections}
  next={next}
  heroSky="crumb"
>
  <section id="introduction" class="sec">
    <p class="sn">{n('introduction')}</p>
    <h2>Introduction</h2>
    <p class="big">Our healthcare enterprise app was confusing. Users couldn’t tell where they were, or how pages linked together.</p>
    <p>We added a breadcrumb trail and tested several designs. Users picked the cleanest one. We then reversed that choice when it fell short of engineering standards, and used an established, documented pattern instead.</p>
  </section>

  <section id="problem" class="sec">
    <p class="sn">{n('problem')}</p>
    <h2>Problem Statement</h2>
    <h3 class="sub">Lost inside DocDoc</h3>
    <p>In account management, every person or organisation has an account, and each account has its own hierarchy. One layer is “Edit procedure price”, but it wasn’t clear whether that page belonged to an organisation or a person. The same confusion showed up across the app, because the links between layers weren’t clear.</p>
    <Shot src={framerImage('C9n6BHo72cuEtcw4C5UWKAFoX1k.png')} alt="Sketch of account management splitting into person and organisation, asking which one the account belongs to" frame maxWidth={420} />
    <div class="takeaway">
      <b>Where am I?</b>
      <p>We summed up the problem in one line: “Make it crystal clear where I am in the hierarchy.”</p>
    </div>
  </section>

  <section id="matrix" class="sec">
    <SpaceBand name="clouds" />
    <p class="sn">{n('matrix')}</p>
    <h2>Impact Effort Matrix</h2>
    <p>We explored many ideas so we wouldn’t fall for the first one. After three days of brainstorming, we placed every idea in FigJam on an impact effort grid.</p>
    <p>Most of us kept coming back to a breadcrumb trail. Our hunch: users already expect a row of links, and the app was mature enough that breadcrumbs would feel natural, not tacked on.</p>
    <Shot src={framerImage('lsw1F0IFDv8YcUofeOZPaNgKjs.jpg')} alt="The team’s impact effort matrix in FigJam, with ideas placed by impact and effort" />
  </section>

  <section id="considerations" class="sec">
    <p class="sn">{n('considerations')}</p>
    <h2>Design Considerations</h2>
    <p>Four questions shaped the breadcrumb.</p>
    <StepList items={considerations} />
  </section>

  <section id="usability-test" class="sec">
    <p class="sn">{n('usability-test')}</p>
    <h2>Usability Test</h2>
    <p>I ran an unmoderated remote test with Google Forms. Participants from the claim operations team picked one of three options and said why. It is quick, and gives a fair view of what users prefer.</p>
    <ul class="options">
      {options.map((option) => (
        <li class:list={{ chosen: option.chosen }}>
          <img src={framerImage(option.file)} alt={option.alt} loading="lazy" decoding="async" />
          <div class="o-copy">
            <div class="o-head">
              <h3>{option.title}</h3>
              {option.badge && <p class="o-badge">{option.badge}</p>}
            </div>
            {option.chosen && <p class="o-chosen"><span aria-hidden="true">&#10003;</span> Chosen</p>}
            <p>{option.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="challenges" class="sec">
    <p class="sn">{n('challenges')}</p>
    <h2>Challenges and Learnings</h2>
    <CardGrid items={learnings} min={300} />
  </section>
</CaseStudy>

<style>
  .options { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; gap: var(--gap-card); }
  .options li { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-3); align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-3); }
  .options li.chosen { border-color: var(--accent-line); }
  .options img { width: 100%; height: auto; border-radius: 8px; background: var(--surface-2); }
  .o-copy { display: grid; gap: var(--space-1); }
  .o-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .o-head h3 { font-size: 24px; }
  .o-badge { font-size: 13px; font-weight: 600; color: var(--text); background: var(--surface-2); border: 1px solid var(--line-2); border-radius: 999px; padding: 4px 12px; }
  .o-chosen { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .o-copy > p:last-child { font-size: 16px; line-height: 1.6; color: var(--text-2); }

  @media (max-width: 760px) {
    .options li { grid-template-columns: minmax(0, 1fr); padding: var(--space-2); }
  }
</style>
