---
// Counted steps (1/5, 2/5 ...) on a mission trajectory rail, styled like OrderSteps: a line runs down the left with
// a glowing node for each step. As the reader scrolls, the line fills with the
// accent colour and each node lights up when its step is reached. On wide
// screens a step's picture sits beside its text, swapping sides each step.
// Without scripts, or with reduced motion, every node is simply lit.
//
// A rail can also be split into stages: a stage marker is a larger node with a
// heading, and the steps after it count within that stage. A step can carry a
// spot illustration (vignette), shown between the line and its text, or above
// the text on phones.
import SmartImage from './SmartImage.astro';
import type { ImageSource } from './SmartImage.astro';
import Vignette from './Vignette.astro';
import type { VignetteName } from './vignettes';

/** `tall` marks a portrait picture, such as a phone screen, so it is shown smaller. */
export type Step = { title: string; text: string; img?: ImageSource; alt?: string; tall?: boolean; vignette?: VignetteName };
export type Stage = { stage: string; text?: string };
interface Props {
  items: (Step | Stage)[];
  /** Pictures stack under the text instead of beside it (for wide diagrams). */
  stacked?: boolean;
}
const { items, stacked = false } = Astro.props;
const isStage = (item: Step | Stage): item is Stage => 'stage' in item;

// Count stages, and steps within each stage (or the whole rail when there are no stages).
const stageCount = items.filter(isStage).length;
const grouped = stageCount > 0;
let stageNumber = 0, stepNumber = 0, stepsInGroup = 0;
const rows = items.map((item, index) => {
  if (isStage(item)) {
    stageNumber += 1; stepNumber = 0;
    const next = items.slice(index + 1).findIndex(isStage);
    stepsInGroup = (next < 0 ? items.length : index + 1 + next) - index - 1;
    return { item, count: `${stageNumber}/${stageCount}` };
  }
  stepNumber += 1;
  return { item, count: `${stepNumber}/${grouped ? stepsInGroup : items.length}` };
});
const StepTitle = grouped ? 'h4' : 'h3';
---
<ol class:list={['rail', { stacked, grouped }]} data-rail>
  {rows.map(({ item, count }) => isStage(item) ? (
    <li class="step stage" data-rail-step>
      <span class="node" aria-hidden="true">{count}</span>
      <div class="body">
        <div class="copy">
          <h3>{item.stage}</h3>
          {item.text && <p>{item.text}</p>}
        </div>
      </div>
    </li>
  ) : ((step) => (
    <li class:list={['step', { 'has-img': !!step.img, 'has-vig': !!step.vignette }]} data-rail-step>
      <span class="node" aria-hidden="true">{count}</span>
      <div class="body">
        {step.vignette && <div class="vig"><Vignette name={step.vignette} /></div>}
        <div class="copy">
          <StepTitle>{step.title}</StepTitle>
          <p>{step.text}</p>
        </div>
        {step.img && (
          <div class:list={['pic', { tall: step.tall }]}>
            <SmartImage src={step.img} alt={step.alt ?? ''} sizes="(max-width: 760px) 100vw, 480px" />
          </div>
        )}
      </div>
    </li>
  ))(item as Step))}
</ol>

<style>
  .rail { --node: 36px; position: relative; list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: var(--space-5); }
  /* The dashed track is the rail's background; the solid fill (before) and the glowing craft at its tip (after)
     run from the first node's centre to the last one's. */
  .rail {
    background: repeating-linear-gradient(to bottom, var(--line-2) 0 6px, transparent 6px 12px) no-repeat;
    background-position: calc(var(--node) / 2 - 1px) calc(var(--node) / 2);
    background-size: 2px calc(100% - var(--node) / 2 - var(--track-end, 0px));
  }
  .rail::before {
    content: ''; position: absolute; left: calc(var(--node) / 2 - 1px); top: calc(var(--node) / 2); bottom: var(--track-end, 0px); width: 2px;
    background: var(--accent); transform-origin: top; transform: scaleY(var(--rail, 1));
  }
  .rail.is-live::after {
    content: ''; position: absolute; z-index: 0; left: calc(var(--node) / 2 - 6px); top: calc(var(--node) / 2 + var(--rail-px, 0px) - 6px);
    width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft), 0 0 18px var(--accent); pointer-events: none;
  }
  .step { position: relative; display: grid; grid-template-columns: var(--node) minmax(0, 1fr); column-gap: var(--space-3); align-items: start; }
  /* Nodes match OrderSteps: grey until reached, then solid accent. */
  .node {
    position: relative; z-index: 1; width: var(--node); height: var(--node); border-radius: 50%;
    display: grid; place-items: center; font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: -0.02em;
    color: var(--on-accent); background: var(--accent); border: 1px solid var(--accent);
    transition: background-color 0.4s, color 0.4s, border-color 0.4s;
  }
  .rail.is-live .step:not(.is-reached) .node { color: var(--text); background: var(--surface-2); border-color: var(--line-2); }
  .body { display: grid; gap: var(--space-3); align-items: center; padding-top: 6px; }
  .has-img .body { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
  .has-img:nth-child(even) .copy { order: 2; }
  .stacked .has-img .body { grid-template-columns: minmax(0, 1fr); }
  .stacked .has-img:nth-child(even) .copy { order: 0; }
  .copy { display: grid; gap: var(--space-1); align-content: start; }
  h3 { font-size: 22px; line-height: 1.3; }
  h4 { font-size: 20px; line-height: 1.3; }

  /* Stage markers: a larger node and a bigger heading, with no box around it. */
  .stage { --stage-node: 48px; }
  .stage .node { width: var(--stage-node); height: var(--stage-node); margin-left: calc((var(--node) - var(--stage-node)) / 2); font-size: 13px; }
  .stage h3 { font-size: clamp(24px, 2.4vw, 30px); }
  .stage .copy p { max-width: 600px; }
  .grouped .stage:not(:first-child) { margin-top: var(--space-4); }

  /* A step with a spot illustration: line, then picture, then text. */
  .has-vig .body { grid-template-columns: 240px minmax(0, 1fr); align-items: start; }
  .copy p { font-size: 16px; line-height: 1.6; color: var(--text-2); }
  .pic { border: 1px solid var(--line); border-radius: var(--radius); padding: 8px; background: var(--surface); }
  .pic.tall { justify-self: center; width: 100%; max-width: 260px; }
  .pic :global(img) { display: block; width: 100%; height: auto; border-radius: 8px; background: var(--surface-2); }

  @media (max-width: 760px) {
    .rail { --node: 32px; gap: var(--space-4); }
    .step { column-gap: var(--space-2); }
    .node { font-size: 10px; }
    .has-img .body { grid-template-columns: minmax(0, 1fr); }
    .has-img:nth-child(even) .copy { order: 0; }
    /* On phones the picture sits above its text */
    .has-vig .body { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .has-vig .vig { max-width: 320px; }
    .stage { --stage-node: 40px; }
  }
</style>

<script>
  import { prefersReducedMotion } from './motion';

  const REACH_AT = 0.62; // a step is reached when its node passes this far down the screen

  /** Fill the track down to the reader's eye line and light every node above it. */
  function update(rail: HTMLElement, steps: HTMLElement[], nodes: HTMLElement[]) {
    const eye = window.innerHeight * REACH_AT, first = nodes[0].getBoundingClientRect(), last = nodes[nodes.length - 1].getBoundingClientRect();
    const span = Math.max(1, last.top - first.top);
    const progress = Math.min(1, Math.max(0, (eye - first.top - first.height / 2) / span));
    rail.style.setProperty('--rail', String(progress));
    rail.style.setProperty('--rail-px', `${progress * span}px`);
    steps.forEach((step, index) => step.classList.toggle('is-reached', nodes[index].getBoundingClientRect().top + nodes[index].offsetHeight / 2 <= eye));
  }

  /** The track ends at the last node, however tall the last step is. */
  function fitTrack(rail: HTMLElement, nodes: HTMLElement[]) {
    const last = nodes[nodes.length - 1];
    const end = rail.getBoundingClientRect().bottom - last.getBoundingClientRect().top - last.offsetHeight / 2;
    rail.style.setProperty('--track-end', `${Math.max(0, end)}px`);
  }

  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const steps = Array.from(rail.querySelectorAll<HTMLElement>('[data-rail-step]'));
    const nodes = steps.map((step) => step.querySelector<HTMLElement>('.node')!).filter(Boolean);
    if (!nodes.length) return;
    fitTrack(rail, nodes);
    new ResizeObserver(() => fitTrack(rail, nodes)).observe(rail);
    if (prefersReducedMotion()) return; // every node stays lit and the track stays full
    rail.classList.add('is-live');
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(rail, steps, nodes); });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update(rail, steps, nodes);
  });
</script>
