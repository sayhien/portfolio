---
import CaseStudy from '../layouts/CaseStudy.astro';
import SpaceBand from '../components/SpaceBand.astro';
import CardGrid from '../components/CardGrid.astro';
import type { Card } from '../components/CardGrid.astro';
import StepList from '../components/StepList.astro';
import type { Step } from '../components/StepList.astro';
import Shot from '../components/Shot.astro';
import { caseLinks } from '../data/site';
import { framerImage } from '../data/framer-images';
import { sectionNumber } from '../layouts/sections';

const sections = [
  { id: 'introduction', title: 'Introduction' },
  { id: 'decision', title: 'Design System Decision' },
  { id: 'alignment', title: 'Company Documentation Alignment' },
  { id: 'expansion', title: 'Library Expansion Process' },
  { id: 'creation-criteria', title: 'Component Creation Criteria' },
  { id: 'card-criteria', title: 'Card Component: Criteria in Action' },
  { id: 'testing-criteria', title: 'Component Testing Criteria' },
  { id: 'core', title: 'The Core of the Library' },
  { id: 'impact', title: 'Impact' },
];
const n = sectionNumber(sections);

const reasons: Card[] = [
  { icon: 'badge', title: 'Widely used and reliable', text: 'Google supports it and many developers use it, so it is reliable and well maintained.' },
  { icon: 'book', title: 'Clear guidelines', text: 'Detailed documentation helps prevent problems with new components, so everything works smoothly.' },
  { icon: 'code', title: 'Open source', text: 'It is free to use and backed by Google, a trustworthy choice for big projects.' },
];

const specs: Card[] = [
  { title: 'User Interface Specification', text: 'A consistent approach to page types like lists, forms and dialogs, describing the components and how they behave.' },
  { title: 'Logical Data Model', text: 'A detailed picture of the platform’s data structure. Every component had to reflect it accurately.' },
  { title: 'Navigation Specification', text: 'The navigation structure of the product: page types and user flows. Components were designed to support them.' },
];

const expansion: Step[] = [
  { title: 'Logical Data Model', text: 'I studied the data model to find the attributes the policy function card and its details needed. The component had to match this structure.', img: framerImage('91Qgz8lIxNHqvblx45e0ex3U2Q.png'), alt: 'A section of the logical data model' },
  { title: 'Navigation Specification', text: 'Building on the data model, this spec set out how the policy function would show its summary and details.', img: framerImage('N0jpRP0vMk6b1EobQh07Ydmi4A.png'), alt: 'A section of the navigation specification' },
  { title: 'User Interface Specification', text: 'This set out how the summary and details would appear inside the card, keeping looks and behaviour consistent.', img: framerImage('ivG4ocYsbDxjz8k1ElPHtEsGw.png'), alt: 'A section of the user interface specification' },
  { title: 'Card variant creation', text: 'I created several card variants with their properties in the design library, then checked them against the testing criteria.', img: framerImage('tuYWn3kzqkleFtAZ1U1jHdBEShA.png'), alt: 'Card variants in the design library' },
  { title: 'Design integration and testing', text: 'I placed the card in the design flow and tested it with other components in different layouts. This showed where it could improve.', img: framerImage('jQi8RN4XfbyUVFSGzmZZAMb7vI.png'), alt: 'The card inside a full page layout' },
];

const creation: Card[] = [
  { icon: 'layers', title: 'Alignment', text: 'Does the component fit the DocDoc design system, both technically and visually?' },
  { icon: 'users', title: 'Audience', text: 'Who is it for, so we can shape it around their needs?' },
  { icon: 'compass', title: 'Responsiveness', text: 'Does it work well on screens of different sizes?' },
  { icon: 'tool', title: 'Functionality', text: 'What does it do, what can users do with it, and how does it fit the layout?' },
  { icon: 'bulb', title: 'Best practices', text: 'Which proven methods improve its design and how it works?' },
  { icon: 'person', title: 'Decision maker', text: 'Feedback from our CTO was key, as he made the final call on design changes.' },
];

const cardCriteria: Step[] = [
  { title: 'Alignment', text: 'The Material 2 card only held a title and a paragraph. We needed rows of labels and values, so we customised it.', img: framerImage('s7XmPUdhwojltjIhBdrhM6PnVo0.png'), alt: 'Angular Material logo' },
  { title: 'Target audience', text: 'Tables were an option, but cards were easier to scan in the member app. That suits healthcare users who need information fast.', img: framerImage('EOfXag1MF8MevIXHkrpWMv5cYU.png'), alt: 'Cards on a mobile screen', tall: true },
  { title: 'Responsiveness', text: 'Labels and values keep a 0.7 to 1 ratio on both mobile and desktop.', img: framerImage('jXMuIcfiN2rB7fmcwYcqLwYy8k.png'), alt: 'Mobile and desktop cards with the same label to value ratio' },
  { title: 'Functionality', text: 'Tapping the card opens more information on another page. An ellipsis button in the top right offers more options.', img: framerImage('LMU1Dhhb2PyIy3s5Yh55pwhgAc.png'), alt: 'The menu that opens from the card’s ellipsis button' },
  { title: 'Best practices', text: 'Text in both columns is left aligned for easier reading. On desktop, values stay within 50 to 75 characters to reduce eye strain. The layout was inspired by Amazon’s product details, which users already know.', img: framerImage('1EbW05taIKQb1piHgmlxL28dsw.png'), alt: 'Amazon product details used as inspiration' },
];

const testing = [
  { title: 'Width adjustability', text: 'Is the component’s width fixed, fill, or both?', file: '3yVbNvpLclVbOzyQzHXHT94tP4.png', alt: 'Cards keeping the same ratio across different screens' },
  { title: 'Element stability', text: 'Do elements keep their place when the size changes?', file: 'LhnRlp4t9ZWyxulNoQNF058wKN8.png', alt: 'The ellipsis staying in the same place at different card widths' },
  { title: 'Content consistency', text: 'Does the content stay the same across variants like default, hover and active?', file: 'fBnBssIs9xQktmxsvyXBsx73Cmg.png', alt: 'The same content in different card states' },
  { title: 'Contextual integration', text: 'Does it work with the other components around it?', file: 'H1bH4dearkDcFajjC2rnazalAP8.png', alt: 'The card with other components in a layout' },
  { title: 'Link consistency', text: 'Are components linked to the latest libraries, not old versions?', file: 'Los7MrYqNFYjomYaLCNukVUWArg.png', alt: 'Figma library links panel' },
  { title: 'Style link', text: 'Are colours, icons and fonts linked to the style guide?', file: 'Uh4p7bsdm8m8uTjNaBVxLsZMEFE.png', alt: 'Figma style panel' },
  { title: 'Dynamic sizing', text: 'Does the component resize itself to fit its content?', file: 'ZFdRq5K0MZsYBu9D7kpyRMEqnM.png', alt: 'A card growing taller as content is added' },
  { title: 'Layer toggling', text: 'Can layers be turned on or off as the context needs?', file: 'i8aeB4nz4igLO2et3n26kaTTa4.png', alt: 'Figma toggle menu for layers' },
  { title: 'Visibility and dimensions', text: 'When a layer is hidden, does its space disappear too?', file: 'sbID5gpX3W2hsEVRYNMIfVmCOg.png', alt: 'A card closing the gap when content is turned off' },
  { title: 'Layer naming', text: 'Are all layers named clearly for the team?', file: 'pXQF88Iul99ibpxht1abJ6zdo.png', alt: 'Figma layer panel with clearly named layers' },
];

const impact: Card[] = [
  { icon: 'check', title: 'Fewer change requests', text: 'People asked for fewer changes over time, a sign the components were complete and worked well.' },
  { icon: 'link', title: 'Seamless integration', text: 'Everything fits together smoothly, like good service you don’t notice. The system made the team’s work faster and easier.' },
  { icon: 'users', title: 'Team efficiency', text: 'Ready made, clear components let designers and developers focus on user problems instead of rebuilding buttons and menus.' },
  { icon: 'layers', title: 'Consistency at scale', text: 'As the product grew, new parts looked and worked like the rest, keeping the experience clear and unified.' },
];

const next = caseLinks(['docdoc-healthcare-report', 'docdoc-breadcrumb']);
---
<CaseStudy
  title="DocDoc Design Library, a UX case study by Loo Say Hien"
  kicker="Case study, DocDoc"
  heading="One source of truth, every product in its orbit."
  lede="How I built and looked after a design library on Angular Material for a healthcare platform, so the team spent less on upkeep and users got the same experience everywhere."
  meta={[
    { label: 'Role', value: 'UX Designer, leading the design library' },
    { label: 'Timeline', value: '2 years 3 months, Jan 2022 to Apr 2024' },
    { label: 'Responsibilities', value: 'Built and kept the library, co-maintained the UI specifications' },
    { label: 'Product', value: 'DocDoc enterprise healthcare platform' },
  ]}
  sections={sections}
  next={next}
  heroSky="library"
>
  <section id="introduction" class="sec">
    <p class="sn">{n('introduction')}</p>
    <h2>Introduction</h2>
    <p class="big">A comprehensive design library on Angular Material, made to cut maintenance costs and keep the experience consistent across a healthcare platform.</p>
    <p>Over two years and three months, I led the creation and upkeep of the library, co-maintained the UI specifications, and made sure every component matched the company documentation and Material Design principles.</p>
  </section>

  <section id="decision" class="sec">
    <p class="sn">{n('decision')}</p>
    <h2>Design System Decision</h2>
    <p>Our Chief Technology Officer (CTO) wanted a widely used, credible, open source design system. Custom patterns with no technical documentation had kept pushing maintenance costs up.</p>
    <CardGrid items={reasons} />
    <div class="takeaway">
      <b>Impact</b>
      <p>With Angular Material as the base, we got battle tested components and patterns. Development time and upkeep went down, so features shipped faster.</p>
    </div>
  </section>

  <section id="alignment" class="sec">
    <p class="sn">{n('alignment')}</p>
    <h2>Company Documentation Alignment</h2>
    <p>The library had to stay in line with three core specifications.</p>
    <CardGrid items={specs} numbered />
    <div class="takeaway">
      <b>Why alignment matters</b>
      <p>Every design decision was grounded in what engineering could build. That removed costly rework, shortened development cycles, and gave the whole product team one source of truth.</p>
    </div>
  </section>

  <section id="expansion" class="sec">
    <p class="sn">{n('expansion')}</p>
    <h2>Library Expansion Process</h2>
    <div class="side">
      <p>Our roadmap decided which functions we worked on, and new components often came out of that work. The card component shows how.</p>
      <Shot src={framerImage('SFbYDxZu9K5jNXgSH6M1d8Bjj9E.png')} alt="The card component used across different screens" />
    </div>
    <StepList items={expansion} />
  </section>

  <section id="creation-criteria" class="sec">
    <SpaceBand name="zodiac" />
    <p class="sn">{n('creation-criteria')}</p>
    <h2>Component Creation Criteria</h2>
    <p>I set up criteria so every new component was useful, efficient and consistent with the design system.</p>
    <CardGrid items={creation} columns={3} />
  </section>

  <section id="card-criteria" class="sec">
    <p class="sn">{n('card-criteria')}</p>
    <h2>Card Component: Criteria in Action</h2>
    <p>See how the criteria shaped the card component.</p>
    <StepList items={cardCriteria} />
  </section>

  <section id="testing-criteria" class="sec">
    <p class="sn">{n('testing-criteria')}</p>
    <h2>Component Testing Criteria</h2>
    <p>Before any component went out, it had to pass ten checks.</p>
    <ul class="checks">
      {testing.map((check) => (
        <li>
          <img src={framerImage(check.file)} alt={check.alt} loading="lazy" decoding="async" />
          <h3>{check.title}</h3>
          <p>{check.text}</p>
        </li>
      ))}
    </ul>
    <div class="takeaway">
      <b>Production ready components</b>
      <p>Every component the team received was ready for production, with fewer bugs and inconsistencies.</p>
    </div>
  </section>

  <section id="core" class="sec">
    <p class="sn">{n('core')}</p>
    <h2>The Core of the Library</h2>
    <p>Each component was built as variants for its different states, like default, hover and pressed, and conditions such as active and inactive.</p>
    <Shot src={framerImage('lHlJOPp11dQuYWAq5JnAWdxLXnc.png')} alt="Variants of the table elements in the library" />
    <div class="takeaway">
      <b>Why variants matter</b>
      <p>Designers and developers had every state at hand, without rebuilding or changing base components. Design time dropped and interactions stayed consistent.</p>
    </div>
  </section>

  <section id="impact" class="sec">
    <p class="sn">{n('impact')}</p>
    <h2>Impact</h2>
    <CardGrid items={impact} columns={2} />
  </section>
</CaseStudy>

<style>
  /* Intro text beside its picture, so the picture stays a supporting size. */
  .side { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-4); align-items: center; }
  .side p { color: var(--text-2); font-size: 18px; line-height: 1.7; }
  .side :global(figure) { margin-top: 0; }
  @media (max-width: 760px) { .side { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); } }

  /* Ten checks in two columns: picture on the left, question on the right. */
  .checks { list-style: none; margin: var(--space-3) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap-card); }
  .checks li { display: grid; grid-template-columns: 160px minmax(0, 1fr); grid-template-rows: auto 1fr; column-gap: var(--space-2); row-gap: 6px; align-content: start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-2); }
  .checks img { grid-row: 1 / span 2; width: 100%; aspect-ratio: 4 / 3; object-fit: contain; border-radius: 8px; background: var(--surface-2); }
  .checks h3 { font-size: 18px; align-self: end; }
  .checks p { font-size: 15px; line-height: 1.5; color: var(--text-2); }
  @media (max-width: 900px) { .checks { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .checks li { grid-template-columns: 112px minmax(0, 1fr); } }
</style>
