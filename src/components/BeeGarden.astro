---
// The footer meadow: a moonlit hillside drawn in specks of light, with a bee
// to say hello to. The canvas is decorative; the button gives keyboard and
// screen reader users the same little moment. The slot holds the copyright;
// `line` is the footer tagline, set in the night sky above the hills.
interface Props {
  line?: string;
}
const { line } = Astro.props;
---
<div class="garden-band">
  <div class="wrap garden-bar">
    <slot />
    <button type="button" class="garden-hello" data-garden-hello>Say hello to the bee</button>
  </div>
  <div class="garden" data-garden>
    <canvas aria-hidden="true"></canvas>
    {line && <p class="wrap garden-line">{line}</p>}
  </div>
</div>

<style>
  .garden-band { position: relative; }
  .garden-bar {
    position: relative; z-index: 1;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 4px 24px;
    padding-top: 12px; font-size: 14px; color: var(--muted);
  }
  .garden { position: relative; height: 560px; margin-top: -40px; }
  .garden canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: manipulation;
    /* the sky melts into the page */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 140px);
    mask-image: linear-gradient(to bottom, transparent 0, #000 140px);
  }
  .garden-line {
    position: absolute; z-index: 1; top: 96px; left: 0; right: 0;
    text-align: center; font-family: var(--display); font-size: clamp(22px, 2.6vw, 34px); line-height: 1.25; letter-spacing: -0.02em;
    color: var(--text); text-wrap: balance; max-width: 820px; pointer-events: none;
  }
  .garden.no-garden { display: none; }
  .garden-band:has(.no-garden) .garden-hello { display: none; }
  .garden-hello {
    font: inherit; color: var(--text-2); background: none; border: 0; cursor: pointer;
    min-height: 44px; padding: 0 2px; text-decoration: underline; text-underline-offset: 4px;
  }
  .garden-hello:hover { color: var(--accent); }
  @media (max-width: 700px) { .garden { height: 420px; } .garden-line { top: 64px; } }
</style>

<script>
  import { startBeeGarden } from './bee-garden';

  document.querySelectorAll<HTMLElement>('[data-garden]').forEach((host) => {
    const canvas = host.querySelector('canvas');
    const hello = host.parentElement?.querySelector<HTMLButtonElement>('[data-garden-hello]') ?? null;
    if (!canvas || !startBeeGarden(host, canvas, hello)) host.classList.add('no-garden');
  });
</script>
