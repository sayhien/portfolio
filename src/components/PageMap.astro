---
// The page structure table with a small sketch of the page beside it (a thin minimap on phones). The
// sketch has one block per section, drawn to hint at what the section holds.
// As the reader scrolls through the table, the row being read and
// its block in the sketch light up together. The sketch is decorative: the
// table carries all the meaning, so screen readers get the table only.
import DataTable from './DataTable.astro';
import type { RowArtName } from './row-art';

/** How each section is drawn in the sketch. */
export type Sketch = 'hero' | 'videos' | 'cards' | 'rows' | 'chat' | 'logos' | 'badges' | 'button';
interface Props {
  caption: string;
  head: string[];
  rows: string[][];
  art?: RowArtName[];
  /** One sketch per row, in the same order as the rows. */
  sketches: Sketch[];
}
const { caption, head, rows, art, sketches } = Astro.props;
if (sketches.length !== rows.length) throw new Error(`PageMap "${caption}" needs one sketch per row`);
---
<div class="map" data-page-map>
  <div class="sketch-wrap" aria-hidden="true">
    <div class="sketch">
      <div class="bar"><i></i><i></i><i></i></div>
      {sketches.map((kind, index) => (
        <div class={`block ${kind}`} data-block={index}>
          <span class="name">{rows[index][0]}</span>
          {kind === 'hero' && <><b class="line wide"></b><b class="line"></b><b class="pill"></b><b class="bot"></b></>}
          {kind === 'videos' && <div class="trio">{[0, 1, 2].map(() => <b class="video"></b>)}</div>}
          {kind === 'cards' && <div class="grid">{[0, 1, 2, 3, 4, 5].map(() => <b class="card"></b>)}</div>}
          {kind === 'rows' && <div class="grid-table">{[0, 1, 2, 3, 4, 5, 6, 7].map(() => <b class="cell"></b>)}</div>}
          {kind === 'chat' && <div class="sandbox"><b class="msg out"></b><b class="reply"></b><div class="chips"><b class="chip"></b><b class="chip"></b><b class="chip"></b></div></div>}
          {kind === 'logos' && <div class="trio">{[0, 1, 2, 3, 4].map(() => <b class="logo"></b>)}</div>}
          {kind === 'badges' && <div class="trio">{[0, 1, 2].map(() => <b class="badge"></b>)}</div>}
          {kind === 'button' && <b class="pill big"></b>}
        </div>
      ))}
    </div>
  </div>
  <div class="table">
    <DataTable caption={caption} head={head} rows={rows} art={art} />
  </div>
</div>

<style>
  .map { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: var(--space-4); align-items: start; margin-top: var(--space-3); }
  .map .table :global(.table-wrap) { margin-top: 0; }
  /* The sketch slides down the table so the lit block always sits level with its row. */
  .sketch-wrap { align-self: stretch; }
  .sketch { transform: translateY(var(--slide, 0px)); transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
  .sketch { display: grid; gap: 6px; padding: 10px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .bar { display: flex; gap: 4px; padding: 2px 2px 6px; }
  .bar i { width: 6px; height: 6px; border-radius: 50%; background: var(--line-2); }

  /* Each block is a tiny drawing of its section. The lit block gets the accent outline and its name. */
  .block { position: relative; display: grid; gap: 4px; align-content: center; padding: 18px 8px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2); transition: opacity 0.3s, border-color 0.3s, box-shadow 0.3s; }
  .map.has-active .block { opacity: 0.4; }
  .map.has-active .block.is-active { opacity: 1; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 0 18px rgba(110, 231, 183, 0.25); }
  .name { position: absolute; right: 6px; top: 4px; font-family: var(--mono); font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); opacity: 0; transition: opacity 0.3s; }
  .block.is-active .name { opacity: 1; }
  .block b { display: block; background: var(--line-2); border-radius: 3px; }
  .block.is-active b { background: rgba(110, 231, 183, 0.45); }
  .hero { min-height: 74px; position: relative; }
  .line { height: 7px; width: 55%; }
  .line.wide { width: 70%; height: 9px; }
  .pill { height: 10px; width: 34%; border-radius: 999px !important; margin-top: 4px; }
  .pill.big { width: 46%; height: 14px; justify-self: center; }
  .bot { position: absolute; right: 12px; bottom: 14px; width: 26px; height: 26px; border-radius: 50% !important; }
  .trio { display: flex; gap: 5px; justify-content: space-between; }
  .video { flex: 1; height: 24px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
  .card { height: 16px; }
  .grid-table { display: grid; grid-template-columns: 1fr 2fr; gap: 3px; }
  .cell { height: 6px; }
  /* Mirrors the Demo sandbox picture: a window, one filled message, a thin reply line, three outlined options. */
  .sandbox { display: grid; align-content: space-between; gap: 6px; height: 64px; box-sizing: border-box; padding: 7px; border-radius: 5px; border: 1px solid var(--line-2); }
  .block.is-active .sandbox { border-color: rgba(110, 231, 183, 0.6); }
  .msg { height: 14px; width: 55%; justify-self: end; border-radius: 5px !important; }
  .reply { height: 2px; width: 48%; }
  .chips { display: flex; gap: 4px; }
  .block .chip { flex: 1; height: 8px; border-radius: 999px !important; background: transparent; border: 1px solid var(--line-2); }
  .block.is-active .chip { background: transparent; border-color: rgba(110, 231, 183, 0.6); }
  .logo { width: 16px; height: 16px; border-radius: 50% !important; }
  .badge { width: 22px; height: 24px; margin-inline: auto; border-radius: 6px 6px 11px 11px !important; }
  .button { min-height: 34px; }

  /* The matching table row lights up too. */
  .map :global(tbody tr) { transition: background-color 0.25s; }
  .map :global(tbody tr.is-active) { background: var(--accent-soft); }

  /* On narrow screens the sketch shrinks to a thin minimap beside the table. It still slides to sit level with the row being read. */
  @media (max-width: 900px) {
    .map { grid-template-columns: 64px minmax(0, 1fr); gap: 10px; }
    .sketch { gap: 4px; padding: 5px; border-radius: 10px; }
    .bar, .name { display: none; }
    .block { gap: 3px; padding: 6px 4px; border-radius: 4px; }
    .hero { min-height: 38px; }
    .line { height: 4px; } .line.wide { height: 5px; }
    .pill { height: 5px; margin-top: 2px; } .pill.big { height: 8px; }
    .bot { right: 5px; bottom: 6px; width: 10px; height: 10px; }
    .trio { gap: 2px; }
    .video { height: 11px; }
    .grid { gap: 2px; } .card { height: 8px; }
    .grid-table { gap: 2px; } .cell { height: 3px; }
    .sandbox { height: 34px; gap: 3px; padding: 4px; }
    .msg { height: 7px; } .reply { height: 1px; }
    .chips { gap: 2px; } .block .chip { height: 4px; }
    .logo { width: 7px; height: 7px; }
    .badge { width: 9px; height: 10px; border-radius: 3px 3px 5px 5px !important; }
    .button { min-height: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .block, .name, .sketch, .map :global(tbody tr) { transition: none; }
  }
</style>

<script>
  // The row that crosses the reading line is the one lit, in the table and the sketch.
  // Only scrolling moves it, and only when the line enters another row, so it never flips back and forth.
  document.querySelectorAll<HTMLElement>('[data-page-map]').forEach((map) => {
    const rows = Array.from(map.querySelectorAll<HTMLElement>('tbody tr[data-row]'));
    const blocks = Array.from(map.querySelectorAll<HTMLElement>('[data-block]'));
    let active = -1;

    const sketch = map.querySelector<HTMLElement>('.sketch');

    // Slide the sketch so the lit block lines up with its row, without leaving the table's height.
    const alignSketch = () => {
      if (!sketch || active < 0) return;
      const row = rows[active].getBoundingClientRect(), block = blocks[active].getBoundingClientRect();
      const mapBox = map.getBoundingClientRect(), sketchBox = sketch.getBoundingClientRect();
      const current = sketchBox.top - mapBox.top;
      const wanted = current + (row.top + row.height / 2) - (block.top + block.height / 2);
      const slide = Math.max(0, Math.min(wanted, mapBox.height - sketchBox.height));
      sketch.style.setProperty('--slide', `${slide}px`);
    };

    const show = (index: number) => {
      if (index === active) return;
      active = index;
      alignSketch();
      map.classList.toggle('has-active', index >= 0);
      rows.forEach((row, i) => row.classList.toggle('is-active', i === index));
      blocks.forEach((block, i) => block.classList.toggle('is-active', i === index));
    };

    const readingLine = () => window.innerHeight * 0.45;
    const findActive = () => {
      const line = readingLine(), box = map.getBoundingClientRect();
      if (box.bottom < 0 || box.top > window.innerHeight) return -1;
      const crossing = rows.findIndex((row) => {
        const r = row.getBoundingClientRect();
        return r.top <= line && r.bottom > line;
      });
      if (crossing >= 0) return crossing;
      // Above the first row or below the last one, the nearest end stays lit.
      const first = rows[0].getBoundingClientRect(), last = rows[rows.length - 1].getBoundingClientRect();
      if (line < first.top) return 0;
      if (line >= last.bottom) return rows.length - 1;
      return active;
    };

    let queued = false;
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; show(findActive()); });
    }, { passive: true });
    show(findActive());
    new ResizeObserver(alignSketch).observe(map);
  });
</script>
