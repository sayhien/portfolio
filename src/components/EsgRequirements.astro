---
// Key requirements, each led by a small looping UI scene (see vignettes.ts),
// inking in one by one when the list scrolls in.
import Vignette from './Vignette.astro';
import type { VignetteName } from './vignettes';

const requirements: { text: string; vignette: VignetteName }[] = [
  { text: 'Support for both GRI and IFRS frameworks', vignette: 'frameworks' },
  { text: 'Ability to synchronise data from other ERP modules', vignette: 'dataSync' },
  { text: 'Task assignment with granular permission settings', vignette: 'assignTasks' },
  { text: 'Progress tracking and status management', vignette: 'trackProgress' },
  { text: 'Communication tools for collaborative reporting', vignette: 'teamChat' },
];
---
<ul class="req" data-requirements>
  {requirements.map((req, index) => (
    <li style={`--n:${index}`}>
      <Vignette name={req.vignette} />
      <span class="t">{req.text}</span>
    </li>
  ))}
</ul>

<style>
  .req { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); max-width: 760px; }
  .req li { display: grid; grid-template-columns: 136px minmax(0, 1fr); gap: 24px; align-items: center; padding: 6px 0; }
  .t { font-size: 17px; }

  /* The list inks in once when it scrolls in */
  .play .t { animation: ink 0.4s ease-out backwards; animation-delay: calc(var(--n) * 0.45s + 0.2s); }
  .play :global(.uv) { animation: rise 0.5s ease-out backwards; animation-delay: calc(var(--n) * 0.45s + 0.15s); }
  @keyframes ink { from { color: var(--muted); } }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }

  @media (max-width: 600px) {
    .req li { grid-template-columns: 112px minmax(0, 1fr); gap: 16px; }
    .t { font-size: 16px; }
  }
</style>

<script>
  import { onFirstView, restartClass } from './motion';
  document.querySelectorAll<HTMLElement>('[data-requirements]').forEach((list) => {
    onFirstView(list, () => restartClass(list));
  });
</script>
