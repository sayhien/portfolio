---
// Lightweight YouTube embed: shows a poster first and only loads the
// player when it scrolls into view, then autoplays muted on loop like a
// GIF, the same way the prototype videos behaved on the Framer site.
// Players far off screen are closed again to keep scrolling smooth.
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=1&loop=1&playlist=${id}&rel=0&modestbranding=1&playsinline=1&iv_load_policy=3`;
const watch = `https://www.youtube.com/watch?v=${id}`;
---
<figure class="yt">
  <div class="browser">
  <div class="chrome" aria-hidden="true"><span></span><span></span><span></span><b>{title}</b></div>
  <div class="frame" data-src={src} data-title={title}>
    <img
      class="poster"
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading="lazy"
      onerror="this.remove()"
    />
    <button type="button" class="play" aria-label={`Play video: ${title}`}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </button>
  </div>
  </div>
  <figcaption>
    {title}. <a href={watch} target="_blank" rel="noopener">Watch on YouTube</a>
  </figcaption>
</figure>

<style>
  .yt { margin: 0; }
  .browser { border-radius: 12px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.45); }
  .chrome { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
  .chrome span { width: 10px; height: 10px; border-radius: 999px; background: var(--line-2); }
  .chrome b { margin-left: 10px; flex: 1; min-width: 0; font-size: 12px; font-weight: 500; color: var(--muted); background: var(--surface); border-radius: 6px; padding: 3px 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--night);
    overflow: hidden;
  }
  .frame :global(iframe), .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .play {
    position: absolute; z-index: 1;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 0;
    background: var(--bg);
    color: var(--text);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
  .play:hover { background: #fff; }
  .play[hidden] { display: none; }
  figcaption { font-size: 14px; color: var(--muted); margin-top: 12px; }
  figcaption a { color: var(--text-2); }
</style>

<script>
  // Players load when they scroll near, and close again once far off screen,
  // so only one or two YouTube players are ever running at once.
  function load(frame: HTMLElement) {
    if (frame.querySelector('iframe')) return;
    const iframe = document.createElement('iframe');
    iframe.src = frame.dataset.src!;
    iframe.title = frame.dataset.title!;
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    frame.querySelector<HTMLElement>('.play')?.setAttribute('hidden', '');
    frame.appendChild(iframe);
  }
  function unload(frame: HTMLElement) {
    frame.querySelector('iframe')?.remove();
    frame.querySelector<HTMLElement>('.play')?.removeAttribute('hidden');
  }
  const frames = document.querySelectorAll<HTMLElement>('.yt .frame');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  frames.forEach((frame) => frame.querySelector('.play')?.addEventListener('click', () => load(frame)));
  if (!reduce && 'IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      (entries) => entries.forEach((entry) => { if (entry.isIntersecting) load(entry.target as HTMLElement); }),
      { rootMargin: '150px' },
    );
    const far = new IntersectionObserver(
      (entries) => entries.forEach((entry) => { if (!entry.isIntersecting) unload(entry.target as HTMLElement); }),
      { rootMargin: '800px' },
    );
    frames.forEach((frame) => { near.observe(frame); far.observe(frame); });
  }
</script>
