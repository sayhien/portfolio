---
import CaseStudy from '../layouts/CaseStudy.astro';
import SpaceBand from '../components/SpaceBand.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import DataTable from '../components/DataTable.astro';
import CardGrid from '../components/CardGrid.astro';
import StepList from '../components/StepList.astro';
import Shot from '../components/Shot.astro';
import type { Card } from '../components/CardGrid.astro';
import type { Step } from '../components/StepList.astro';
import type { RowArtName } from '../components/row-art';
import { caseLinks } from '../data/site';
import { sectionNumber } from '../layouts/sections';

import afterHome from '../assets/four-leaves/after-home.webp';
import afterSignature from '../assets/four-leaves/after-signature-cakes.webp';
import afterOrigin from '../assets/four-leaves/after-origin.webp';
import afterCakes from '../assets/four-leaves/after-cakes.webp';
import afterCake from '../assets/four-leaves/after-cake-page.webp';
import afterRewards from '../assets/four-leaves/after-rewards.webp';

const liveSite = 'https://sayhien.github.io/four-leaves-redesign/';

const sections = [
  { id: 'introduction', title: 'Introduction' },
  { id: 'discover', title: 'Discover' },
  { id: 'define', title: 'Define' },
  { id: 'develop', title: 'Develop' },
  { id: 'deliver', title: 'Deliver' },
  { id: 'before-after', title: 'Before and After' },
  { id: 'measures', title: 'How I Would Measure It' },
  { id: 'learnings', title: 'Honest Limits and Learnings' },
];
const n = sectionNumber(sections);

const findings: string[][] = [
  ['Two websites, two looks', 'Ordering lives on a separate shop with a different logo colour, a black top bar, other fonts and an older footer.', 'Consistency and standards'],
  ['Ordering is buried', '“Shop Online” is one of eight equal links split around the logo. There is no main button, and it opens a second website.', 'Aesthetic and minimalist design'],
  ['Text inside pictures', 'Promotions are posters. Prices and names cannot be read by a screen reader, searched or zoomed.', 'Accessibility'],
  ['Empty areas', 'The location page opens with a large blank space. The contact page says “Leave Us A Message” but shows no form.', 'Visibility of system status'],
  ['Small errors', 'Collection slots read “11:00am to 13:00pm”. The shop footer shows a garbled copyright symbol.', 'Error prevention'],
  ['Points are hard to value', '“$2 spent = 1 point” and “60 points = $5” make customers do the maths. Nothing says it is about 4 to 6% back.', 'Match with the real world'],
  ['Too many typefaces', 'A script face, a heavy display serif and two plain faces compete, so the brand feels busy instead of premium.', 'Consistency and standards'],
  ['Scrolling inside scrolling', 'On store pick up, a region map sits next to a list that scrolls inside the page (“1 out of 31”).', 'User control and freedom'],
  ['No reason to believe', 'Nothing explains where the strawberries, cream or flour come from, so cakes compete on price alone.', 'Beyond the ten rules: trust'],
];
const findingArt: RowArtName[] = ['twoSites', 'buriedOrder', 'textInPictures', 'emptyAreas', 'smallErrors', 'pointsValue', 'typefaces', 'nestedScroll', 'noProof'];

const consequences: Card[] = [
  { title: 'Fewer people reach the order', text: 'Every extra click and page change loses some customers. The cake path has the most of them.', label: 'Revenue' },
  { title: 'Trust drops at payment', text: 'The shop looks older than the main site. People are asked to pay on the page that feels least safe.', label: 'Trust' },
  { title: 'Cakes become a price check', text: 'Without a story, a cake is only a photo and a number, so cheaper shops win.', label: 'Value' },
  { title: 'Members are not won', text: 'Points are hard to read, so there is little reason to sign up or come back.', label: 'Loyalty' },
];

const howMightWe: Card[] = [
  { title: 'Order from anywhere', text: 'How might we put cake ordering one click from every page?' },
  { title: 'Prove the quality', text: 'How might we show the people and places behind the ingredients?' },
  { title: 'Make points plain', text: 'How might we show what points are worth in simple numbers, right when someone buys?' },
  { title: 'One calm brand', text: 'How might we make browsing and buying feel like the same shop?' },
];

const ideas: Card[] = [
  { title: 'One website', text: 'Browsing and ordering together, with an “Order cakes” button always in the header.', label: 'Structure' },
  { title: 'Four step ordering', text: 'Choose, personalise with a free message, pick an outlet and a two hour slot, then collect. An account is optional.', label: 'Flow' },
  { title: 'Origin stories', text: 'Short films and photos of the growers and farms. A story and a face make quality believable: storytelling, authority and social proof.', label: 'Persuasion' },
  { title: 'Points made concrete', text: '“Up to 6% back on every cake”, a table of what points are worth, and a worked example.', label: 'Value' },
  { title: 'A patisserie shop front', text: 'A cream page and a scalloped awning edge on the header, with one serif for headings.', label: 'Look' },
];

const orderingSteps: Step[] = [
  { title: 'Choose', text: 'Seven signature cakes with the price and size on the card. Picking a size changes the price at once, so there are no surprises later.', img: afterSignature, alt: 'Three cake cards on a cream page, each with sizes, prices and an Add to order button' },
  { title: 'Personalise', text: 'A free message on every cake, with a short hint about how many letters fit.', img: afterCake, alt: 'Chocolate Classico cake page with a photo gallery, three size options and a message field' },
  { title: 'Collection', text: 'Pick an outlet, a date and a two hour slot. Slots are written plainly, such as 11am to 1pm, so the old “13:00pm” mistake cannot happen.' },
  { title: 'Collect', text: 'Show up and collect. No account is needed, and members simply see their past orders.' },
];

const measures: string[][] = [
  ['Online cake orders', 'Count of completed orders per week', 'Ordering is the main revenue driver.'],
  ['Drop off before payment', 'Share of people who open a cake page but do not pay', 'Shows where the path still loses people.'],
  ['Membership sign ups', 'New members per week', 'Shows if the points explanation works.'],
  ['Time to order a cake', 'Seconds from the first page to the order confirmation', 'A shorter path should be a faster one.'],
];
const measureArt: RowArtName[] = ['cakeOrders', 'dropOff', 'signUps', 'orderTime'];

const limits: Card[] = [
  { title: 'No customer research', text: 'I did not interview or survey customers. The findings are an expert review against Nielsen’s ten usability rules, so they are my judgement, not proof.', label: 'Method' },
  { title: 'Most media is AI generated', text: 'Only the cake, career and company pictures are real. The films, grower portraits and the grower quote are AI generated and made up, to show the idea. Real photography would replace them.', label: 'Media' },
  { title: 'The old site is shown as redraws', text: 'The “before” pictures are simple redraws from my audit notes, not screenshots, and are labelled that way.', label: 'Evidence' },
  { title: 'Next step', text: 'Test with five customers: ask where they would order a cake, and time how long a first order takes.', label: 'Learning' },
];

const next = caseLinks(['ai-chatbot', 'esg-reporting-module']);
---
<CaseStudy
  title="Four Leaves Redesign, a UX case study by Loo Say Hien"
  kicker="Concept project, a bakery in Singapore"
  heading="A bakery that sells cakes, with ordering hidden on another website."
  lede="A self started redesign of the Four Leaves bakery website. I moved cake ordering to the front, told the story behind the ingredients, and made the points scheme easy to value."
  meta={[
    { label: 'Role', value: 'UX Designer, sole designer on the project' },
    { label: 'Type', value: 'Self started concept redesign' },
    { label: 'Method', value: 'Double Diamond and Nielsen’s ten usability rules' },
    { label: 'Result', value: 'A working website you can try' },
  ]}
  sections={sections}
  next={next}
  heroSky="chatbot"
>
  <section id="introduction" class="sec">
    <p class="sn">{n('introduction')}</p>
    <h2>Introduction</h2>
    <p class="big">Four Leaves has baked in Singapore since 1981. Most of its sales come from cakes, yet to order one you have to leave the main website for a second, older shop.</p>
    <p>I redesigned the website to fix that. I worked backwards from the finished design, using the Double Diamond to explain each step: <b>Discover</b> the problems, <b>Define</b> the one to solve, <b>Develop</b> ideas, and <b>Deliver</b> the result.</p>
    <p>This is a concept. I have no link with the company, and I did not talk to customers. The last section is open about what that means.</p>
    <p><a href={liveSite} target="_blank" rel="noopener">Try the redesigned website</a></p>
    <Shot src={afterHome} alt="The redesigned Four Leaves home page: a green header with a scalloped edge, a baker’s film behind the words A Singapore bakery since 1981, and an Order a cake button" caption="The redesigned home page. The Order cakes button sits in the header on every page." frame />
  </section>

  <section id="discover" class="sec">
    <SpaceBand name="station" />
    <p class="sn">{n('discover')}</p>
    <h2>Discover</h2>
    <p>I walked through the current main site and the separate online shop as a first time customer who wants to order a cake. I judged every page against Nielsen’s ten usability rules, which are common checks for a clear interface.</p>
    <h3 class="sub">Nine problems, and the rule each one breaks</h3>
    <DataTable caption="Nine problems found on the current Four Leaves websites" head={['Problem', 'What I saw', 'Rule it breaks']} rows={findings} art={findingArt} />
    <div class="takeaway">
      <b>The biggest one</b>
      <p>Ordering a cake is the main way the business earns money, and it is the hardest thing to find.</p>
    </div>
    <h3 class="sub">What a buried order costs</h3>
    <p>I had no sales data, so this is reasoning and not measured loss. Each effect makes the next one worse.</p>
    <CardGrid items={consequences} />
  </section>

  <section id="define" class="sec">
    <p class="sn">{n('define')}</p>
    <h2>Define</h2>
    <p class="big">Busy customers who want a celebration cake cannot order it in one smooth path, and nothing on the site shows why the cakes are worth the price.</p>
    <p>The business goal is to grow online cake orders and membership sign ups. I turned the problem into four questions to guide the ideas.</p>
    <CardGrid items={howMightWe} numbered />
  </section>

  <section id="develop" class="sec">
    <p class="sn">{n('develop')}</p>
    <h2>Develop</h2>
    <p>Each idea answers one of the four questions. The origin stories came from marketing psychology: people trust quality they can see, and a face and a place make it easier to believe.</p>
    <CardGrid items={ideas} />
  </section>

  <section id="deliver" class="sec">
    <p class="sn">{n('deliver')}</p>
    <h2>Deliver</h2>
    <p>The redesign covers the home page, the cake catalogue, a page for each cake, rewards, outlets, careers and promotions, all in one calm system. Ordering takes four steps.</p>
    <StepList items={orderingSteps} />
    <h3 class="sub">Filters that match how people choose a cake</h3>
    <p>People first think “how many people am I feeding?”, so the catalogue filters by that, then flavour and shape.</p>
    <Shot src={afterCakes} alt="The Order a cake page with filters for number of people, flavour and shape, above a row of three cakes" caption="The catalogue. Seven cakes, three filters, prices from $35." frame />
    <h3 class="sub">Something I found while redesigning</h3>
    <p>The membership terms say 120 points for a $20 voucher, but the rewards page says 160. The banner says “up to 6%”, yet the top tier returns 6.25%. I would flag both to the client before launch.</p>
  </section>

  <section id="before-after" class="sec">
    <p class="sn">{n('before-after')}</p>
    <h2>Before and After</h2>
    <p>Four changes that matter most. The “before” side is a simple redraw of the old site from my audit notes.</p>

    <BeforeAfter
      title="Ordering moves to the front"
      rule="Aesthetic and minimalist design"
      beforeAlt="Redraw of the old header: eight equal links around the logo, one of them Shop Online, which leads to a second website"
      beforeNote="Eight equal links. Shop Online is one of them and opens a second website."
      afterImg={afterHome}
      afterAlt="The new header with the Order cakes button on the right and a main button in the page"
      afterNote="One main button, Order cakes, always in the header."
    >
      <div slot="before" class="wf">
        <div class="wf-nav">
          <i class="wf-bar"></i><i class="wf-bar"></i><i class="wf-bar"></i><i class="wf-bar"></i>
          <b class="wf-logo">Logo</b>
          <i class="wf-bar"></i><i class="wf-bar"></i><i class="wf-bar"></i><span class="wf-hot">Shop Online</span>
        </div>
        <p class="wf-arrow">Opens a second website with a different look</p>
      </div>
    </BeforeAfter>

    <BeforeAfter
      title="One website, from browse to pay"
      rule="Consistency and standards"
      beforeAlt="Redraw of the old path: main website, then a link, then a second shop website with a different logo colour, a black top bar and an older footer"
      beforeNote="Browse on one site, pay on another that looks older."
      afterImg={afterCake}
      afterAlt="A cake page with a photo gallery, three size options with prices, and a message field"
      afterNote="Sizes, prices and the message are on the cake page itself."
    >
      <div slot="before" class="wf">
        <div class="wf-flow">
          <div class="wf-box"><b>Main website</b><span>Cream and green</span></div>
          <span class="wf-go" aria-hidden="true">&rarr;</span>
          <div class="wf-box wf-dark"><b>Second shop</b><span>Black top bar, older footer</span></div>
        </div>
        <p class="wf-arrow">Two looks and two logins at the moment of payment</p>
      </div>
    </BeforeAfter>

    <BeforeAfter
      title="Points that explain themselves"
      rule="Match with the real world"
      beforeAlt="Redraw of the old points text: two dollars spent equals one point, sixty points equals five dollars"
      beforeNote="Two small rules. The customer has to work out that it is about 4 to 6% back."
      afterImg={afterRewards}
      afterAlt="The Rewards page showing what points are worth: $5 off for 60 points, $10 off for 100 points and $20 off for 160 points, each with the percentage returned"
      afterNote="Each voucher shows its points and the percentage it returns."
    >
      <div slot="before" class="wf">
        <p class="wf-line">$2 spent = 1 point</p>
        <p class="wf-line">60 points = $5</p>
        <p class="wf-arrow">What is that worth?</p>
      </div>
    </BeforeAfter>

    <BeforeAfter
      title="A reason to believe the cake"
      rule="Beyond the ten rules: trust"
      beforeAlt="Redraw of an old cake card: a photo and a name only, with no word about where the ingredients come from"
      beforeNote="A photo and a name. Nothing about where the strawberries or cream come from."
      afterImg={afterOrigin}
      afterAlt="The Where it begins section: A cake is only as good as the hands it passes through, with two films of a strawberry greenhouse and a peach grower"
      afterNote="Films and photos of the growers and places. These are AI generated for the concept."
    >
      <div slot="before" class="wf">
        <div class="wf-photo">Cake photo</div>
        <p class="wf-line">Cake name</p>
        <p class="wf-arrow">No story, no source</p>
      </div>
    </BeforeAfter>
  </section>

  <section id="measures" class="sec">
    <p class="sn">{n('measures')}</p>
    <h2>How I Would Measure It</h2>
    <p>After launch I would watch four numbers. The first two show if ordering got easier. The last two show if the story and the points are working.</p>
    <DataTable caption="Measures to track after launch" head={['Measure', 'How it is counted', 'Why it matters']} rows={measures} art={measureArt} />
  </section>

  <section id="learnings" class="sec">
    <p class="sn">{n('learnings')}</p>
    <h2>Honest Limits and Learnings</h2>
    <p>A concept can show good thinking, but it cannot show results. Here is what to keep in mind.</p>
    <CardGrid items={limits} />
  </section>
</CaseStudy>

<style>
  /* Simple redraws of the old site, built from plain blocks. */
  .wf { display: grid; gap: 14px; justify-items: center; font-size: 14px; color: var(--text); }
  .wf-nav { display: grid; grid-auto-flow: column; align-items: center; gap: 8px; width: 100%; background: var(--surface); border: 1px solid var(--line-2); border-radius: 8px; padding: 10px; }
  .wf-bar { display: block; height: 8px; border-radius: 4px; background: var(--line-2); }
  .wf-logo { font-family: var(--display); font-size: 15px; text-align: center; padding: 0 6px; }
  .wf-hot { font-family: var(--mono); font-size: 11px; color: var(--accent); border: 1px solid var(--accent-line); border-radius: 4px; padding: 2px 4px; white-space: nowrap; text-align: center; }
  .wf-arrow { font-family: var(--mono); font-size: 12px; color: var(--muted); text-align: center; }
  .wf-flow { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; width: 100%; }
  .wf-box { display: grid; gap: 4px; justify-items: center; text-align: center; padding: 14px 8px; background: var(--surface); border: 1px solid var(--line-2); border-radius: 8px; }
  .wf-box span { font-size: 12px; color: var(--muted); }
  .wf-dark { background: #0c0e11; border-color: var(--muted); }
  .wf-go { font-size: 22px; color: var(--accent); }
  .wf-line { font-family: var(--mono); font-size: 15px; background: var(--surface); border: 1px solid var(--line-2); border-radius: 6px; padding: 8px 14px; }
  .wf-photo { width: 70%; aspect-ratio: 16 / 9; display: grid; place-items: center; font-size: 12px; color: var(--muted); background: var(--line); border-radius: 8px; }
</style>
