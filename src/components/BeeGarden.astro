---
// A green, engraved style landscape across the foot of every page, with a
// bee to say hello to. The canvas is decorative; the button gives keyboard
// and screen reader users the same little moment.
---
<div class="garden-band">
  <p class="wrap garden-hint">
    Tap the bee, or <button type="button" class="garden-hello" data-garden-hello>say hello to the bee</button>
  </p>
  <div class="garden" data-garden>
    <canvas aria-hidden="true"></canvas>
  </div>
</div>

<style>
  .garden-band { position: relative; }
  .garden { position: relative; height: 480px; }
  .garden canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: manipulation;
    /* the sky melts into the page */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 12%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 12%);
  }
  .garden.no-garden { display: none; }
  .garden-hint { position: relative; z-index: 1; font-size: 14px; color: var(--muted); }
  .garden-band:has(.no-garden) .garden-hint { display: none; }
  .garden-hello {
    font: inherit; color: var(--text-2); background: none; border: 0; cursor: pointer;
    padding: 12px 2px; margin: -12px 0; text-decoration: underline; text-underline-offset: 3px;
  }
  .garden-hello:hover { color: var(--accent); }
  @media (max-width: 700px) { .garden { height: 320px; } }
</style>

<script>
  import { startBeeGarden } from './bee-garden';

  document.querySelectorAll<HTMLElement>('[data-garden]').forEach((host) => {
    const canvas = host.querySelector('canvas');
    const hello = host.parentElement?.querySelector<HTMLButtonElement>('[data-garden-hello]') ?? null;
    if (!canvas || !startBeeGarden(host, canvas, hello)) host.classList.add('no-garden');
  });
</script>
