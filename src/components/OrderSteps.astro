---
// A short flow told as numbered steps on a line. Picking a step shows its
// screen on the right. Built as tabs, so arrow keys move between steps.
import SmartImage from './SmartImage.astro';
import type { ImageSource } from './SmartImage.astro';

export type OrderStep = { title: string; text: string; img: ImageSource; alt: string };
interface Props {
  steps: OrderStep[];
  cta: { label: string; href: string };
}
const { steps, cta } = Astro.props;
const id = 'order-steps';
---
<div class="order" data-order-steps>
  <div class="o-copy">
    <div class="o-steps" role="tablist" aria-orientation="vertical" aria-label="Steps to order a cake">
      {steps.map((s, i) => (
        <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="o-step">
          <span class="o-num" aria-hidden="true">{i + 1}</span>
          <span class="o-title">{s.title}</span>
          <span class="o-text">{s.text}</span>
        </button>
      ))}
    </div>
    <a class="o-cta" href={cta.href} target="_blank" rel="noopener">{cta.label}<span aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="o-screens">
    {steps.map((s, i) => (
      <div role="tabpanel" id={`${id}-panel-${i}`} aria-labelledby={`${id}-tab-${i}`} hidden={i > 0} class="o-panel">
        <SmartImage src={s.img} alt={s.alt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 92vw, 620px" />
      </div>
    ))}
  </div>
</div>

<style>
  .order { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-4); align-items: start; margin-top: var(--space-3); padding: var(--space-4); border-radius: var(--radius); border: 1px solid var(--line); background: radial-gradient(120% 90% at 85% 50%, rgba(110, 231, 183, 0.1), transparent 60%), var(--surface); }
  .o-copy { display: grid; gap: var(--space-3); justify-items: start; }

  /* A line runs down the left, through the step numbers, to show the order. */
  .o-steps { position: relative; display: grid; gap: 10px; width: 100%; padding-left: 44px; }
  .o-steps::before { content: ''; position: absolute; left: 13px; top: 12px; bottom: 12px; width: 2px; background: var(--accent-line); }
  .o-step { position: relative; display: grid; gap: 2px; text-align: left; width: 100%; min-height: 44px; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.03); color: var(--text); font: inherit; cursor: pointer; }
  .o-step:hover { border-color: var(--line-2); background: rgba(255, 255, 255, 0.06); }
  .o-step[aria-selected='true'] { border-color: var(--accent); background: var(--accent-soft); }
  .o-num { position: absolute; left: -44px; top: 50%; translate: 0 -50%; width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-family: var(--mono); font-size: 13px; font-weight: 600; color: var(--text); background: var(--surface-2); border: 1px solid var(--line-2); }
  .o-step[aria-selected='true'] .o-num { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  .o-title { font-family: var(--display); font-size: 18px; font-weight: 600; }
  .o-text { font-size: 15px; line-height: 1.5; color: var(--text-2); }

  .o-cta { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 8px 0 22px; border-radius: 999px; background: var(--text); color: var(--bg); font-weight: 600; text-decoration: none; }
  .o-cta span { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--on-accent); }
  .o-cta:hover span { translate: 3px 0; }

  .o-screens { position: sticky; top: 96px; }
  .o-panel[hidden] { display: none; }
  .o-panel :global(img) { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top center; border-radius: var(--radius); border: 1px solid var(--line-2); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35); }

  @media (max-width: 860px) {
    .order { grid-template-columns: minmax(0, 1fr); padding: var(--space-3); }
    .o-screens { position: static; order: -1; }
  }
  @media (prefers-reduced-motion: no-preference) { .o-cta span { transition: translate 0.2s; } }
</style>

<script>
  // Tabs: click or arrow keys pick a step; only the chosen step's screen shows.
  document.querySelectorAll<HTMLElement>('[data-order-steps]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const moves: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
        if (event.key in moves) { event.preventDefault(); select((i + moves[event.key] + tabs.length) % tabs.length, true); }
        if (event.key === 'Home') { event.preventDefault(); select(0, true); }
        if (event.key === 'End') { event.preventDefault(); select(tabs.length - 1, true); }
      });
    });
  });
</script>
