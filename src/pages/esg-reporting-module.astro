---
import { Image } from 'astro:assets';
import CaseStudy from '../layouts/CaseStudy.astro';
import type { NextLink } from '../layouts/CaseStudy.astro';
import YouTube from '../components/YouTube.astro';
import JourneyMap from '../components/JourneyMap.astro';
import EsgHierarchy from '../components/EsgHierarchy.astro';
import Icon from '../components/Icon.astro';
import EsgProblemList from '../components/EsgProblemList.astro';
import EsgRequirements from '../components/EsgRequirements.astro';
import EsgPainPoints from '../components/EsgPainPoints.astro';
import EsgQuestions from '../components/EsgQuestions.astro';
import EsgFeatureList from '../components/EsgFeatureList.astro';
import type { Feature } from '../components/EsgFeatureList.astro';
import EsgFrameworkTabs from '../components/EsgFrameworkTabs.astro';
import type { Framework } from '../components/EsgFrameworkTabs.astro';
import EsgDashboardTour from '../components/EsgDashboardTour.astro';
import EarthScene from '../components/EarthScene.astro';
import type { Hotspot } from '../components/EsgDashboardTour.astro';
import type { Question } from '../components/EsgQuestions.astro';
import type { PainPoint } from '../components/EsgPainPoints.astro';
import { onFirstView, restartClass } from '../components/motion';
import type { IconName } from '../components/Icon.astro';

import ifrs from '../assets/esg/ifrs-logo.png';
import gri from '../assets/esg/gri-logo.png';
import dashboard from '../assets/esg/dashboard.png';
import helen from '../assets/esg/persona-helen.png';
import laura from '../assets/esg/persona-laura.png';
import sarah from '../assets/esg/persona-sarah.png';
import oliver from '../assets/esg/persona-oliver.png';
import sam from '../assets/esg/persona-sam.png';
import cluck from '../assets/esg/persona-cluck.png';
import raj from '../assets/esg/persona-raj.png';

const sections = [
  { id: 'introduction', title: 'Introduction' },
  { id: 'problem', title: 'Problem Statement' },
  { id: 'discovery', title: 'Discovery and Requirements Gathering' },
  { id: 'personas', title: 'Personas' },
  { id: 'journey-map', title: 'Journey Map' },
  { id: 'information-architecture', title: 'Information Architecture' },
  { id: 'dashboard', title: 'Dashboard' },
  { id: 'user-assignment', title: 'User Assignment' },
  { id: 'data-synchronisation', title: 'Data Synchronisation' },
  { id: 'frameworks', title: 'GRI and IFRS Reporting' },
  { id: 'progress-tracking', title: 'Progress Tracking' },
  { id: 'collaborative-review', title: 'Collaborative Review' },
  { id: 'challenges', title: 'Challenges and Learnings' },
];
const n = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');

const personas = [
  { img: helen, name: 'Helen', quote: 'I need diversity and well-being numbers without chasing five spreadsheets.',  role: 'HR Manager', goals: ['Ensure compliance with labor laws', 'Promote diversity', 'Track employee well-being'] },
  { img: laura, name: 'Laura', quote: 'Tell me early when something puts us out of compliance.',  role: 'Compliance Officer', goals: ['Ensure regulatory compliance', 'Manage ESG risks'] },
  { img: sarah, name: 'Sarah', quote: 'Clients ask about our ESG record. I need proof I can share.',  role: 'Business Development Manager', goals: ['Understand ESG for market demands', 'Communicate achievements', 'Sales focuses on procurement practices and market presence'] },
  { img: oliver, name: 'Oliver', quote: 'Energy and waste data lives on the factory floor, not in reports.',  role: 'Operations Manager', goals: ['Reduce energy and waste', 'Implement sustainable practices', 'Report environmental performance'] },
  { img: sam, name: 'Sam', quote: 'I can’t vouch for suppliers I can’t measure.',  role: 'Supply Chain Analyst', goals: ['Assess supplier sustainability', 'Reduce supply chain environmental impact'] },
  { img: cluck, name: 'Cluck', quote: 'ESG has to tie back to the numbers I already report.',  role: 'Financial Controller', goals: ['Integrate ESG into financial planning', 'Report on expenditures', 'Report on economic performance and tax governance'] },
  { img: raj, name: 'Raj Patel', quote: 'Every new data source is another privacy risk to manage.',  role: 'IT Specialist', goals: ['Integrate ESG data from multiple sources into the ERP system', 'Protect customer privacy', 'Act against breaches of customer privacy and data losses'] },
];

const painPoints: PainPoint[] = [
  { pain: 'Lack of clear communication about roles and responsibilities.', fix: 'Created user assignment to control who does what.', to: 'user-assignment', linkLabel: 'See user assignment', widget: 'assign' },
  { pain: 'Time consuming manual data collection processes.', fix: 'Created data synchronisation to automatically pull data from other modules.', to: 'data-synchronisation', linkLabel: 'See data synchronisation', widget: 'sync' },
  { pain: 'Lack of communication between reviewers and data providers.', fix: 'Created chat for the manager to communicate flagged for review answers with the assigned user.', to: 'collaborative-review', linkLabel: 'See collaborative review', widget: 'chat' },
];

const assignmentFeatures: Feature[] = [
  { icon: 'layers', text: 'Selecting specific standards, down to disclosures and requirements, for assignment' },
  { icon: 'userplus', text: 'Assigning users by name or email' },
  { icon: 'key', text: 'Setting permission levels' },
  { icon: 'listcog', text: 'Viewing and managing existing assignments' },
];
const syncFeatures: Feature[] = [
  { icon: 'sync', text: 'Real time data from other modules ensures precise ESG metrics' },
  { icon: 'bolt', text: 'Automated data collection reduces manual workload' },
  { icon: 'link', text: 'Data stays aligned across modules' },
  { icon: 'clock', text: 'No redundant data entry, so teams can focus on analysis and reporting' },
];
const frameworkFeatures: Feature[] = [
  { icon: 'bars', text: 'Progress tracker' },
  { icon: 'table', text: 'Content entry fields and tables' },
  { icon: 'book', text: 'Clear display of requirements and guidance' },
];
const frameworks: Framework[] = [
  { key: 'gri', label: 'GRI', intro: 'The Global Reporting Initiative (GRI) standards address broad environmental, social, and governance impacts. The main reporting interface provides context and guidance for each standard’s specific requirements.', videoId: 'LXmsCW7xVis', videoTitle: 'GRI reporting interface prototype' },
  { key: 'ifrs', label: 'IFRS', intro: 'The International Financial Reporting Standards (IFRS) address financial implications. The interface mirrors the GRI module, so users learn one pattern for both frameworks.', videoId: '-1cucdJdtoA', videoTitle: 'IFRS reporting interface prototype' },
];
const trackingFeatures: Feature[] = [
  { icon: 'checkcircle', text: 'Completed disclosures' },
  { icon: 'alert', text: 'Disclosures with issues (a standard contains disclosures)' },
  { icon: 'flag', text: 'Requirements affected by issues (a disclosure contains requirements)' },
  { icon: 'compass', text: 'Navigation to any disclosure' },
];
const statuses = [
  { label: 'Not attempted', tone: 'grey', shape: 'ring' },
  { label: 'Current location', tone: 'blue', shape: 'target' },
  { label: 'Completed', tone: 'green', shape: 'check' },
  { label: 'Multiple issues', tone: 'red', shape: 'alert' },
  { label: 'Empty fields', tone: 'amber', shape: 'dash' },
  { label: 'Flagged for review', tone: 'orange', shape: 'flag' },
  { label: 'Omission', tone: 'grey', shape: 'slash' },
];
const reviewFeatures: Feature[] = [
  { icon: 'flag', text: 'Flag items for further review' },
  { icon: 'chat', text: 'Discuss specific reporting items in context' },
  { icon: 'clock', text: 'Keep time stamped communications' },
  { icon: 'badge', text: 'Identify users for accountability' },
];
const dashboardSpots: Hotspot[] = [
  { x: 1.6, y: 6.6, title: 'Reporting cycle', text: 'Deadline, standards in scope and overall progress for the quarter, at a glance.' },
  { x: 28.4, y: 15.3, title: 'Status cards', text: 'Completed, in progress and not done counts, each with a filter to drill in.' },
  { x: 82.8, y: 15.3, title: 'Status distribution', text: 'The same split as one donut, so the balance is clear in a second.' },
  { x: 1.6, y: 37.1, title: 'Compliance confidence', text: 'A readiness score built from completion rate, data quality and review status.' },
  { x: 33.9, y: 37.1, title: 'Upcoming deadlines', text: 'The next due standards, with urgent dates in red.' },
  { x: 66.2, y: 37.1, title: 'User workload', text: 'Who is overloaded or overdue, with a shortcut to reassign tasks.' },
  { x: 1.6, y: 53.2, title: 'Progress tracker', text: 'Every standard with its status, owner and permissions. Synchronise data and Assign user start here.' },
];

const dashboardQuestions: Question[] = [
  { question: 'How far along are we?', principle: 'Progress Transparency', text: 'View task completion quickly to stay on top of progress.' },
  { question: 'What could go wrong?', principle: 'Risk Intelligence', text: 'Find issues early to keep standards running smoothly.' },
  { question: 'Who owns this, and when?', principle: 'Team Accountability', text: 'Know who owns what, and when it’s due.' },
];

type Challenge = {
  title: string;
  icon: IconName;
  status: { label: string; note?: string; tone: 'good' | 'warn' | 'info' | 'accent' };
  challenge: string;
  solution: string;
  result: string;
};

const challenges: Challenge[] = [
  {
    title: 'Complex Reporting Standards',
    icon: 'docs',
    status: { label: 'Delivered', tone: 'good' },
    challenge: 'GRI and IFRS frameworks include hundreds of standards, with about 1,500 pages of documentation, multiple disclosures, and varied data input methods.',
    solution: 'Prioritised core reporting workflows and developed a design library with autolayout components for rapid design iteration.',
    result: 'Designs for the core workflows, such as synchronising data, filling out data for both standards, progress tracking and managerial review, were done.',
  },
  {
    title: 'Limited Development Resources',
    icon: 'code',
    status: { label: 'Build pending', tone: 'warn' },
    challenge: 'A small team of mostly junior engineers had to implement complex technical work such as data synchronisation.',
    solution: 'Created reusable UI patterns across the app, and designed user flows for future hires to understand.',
    result: 'Implementation is still pending as the designs are still in the backlog.',
  },
  {
    title: 'Compressed Timeline',
    icon: 'clock',
    status: { label: 'Delivered', note: 'More to refine', tone: 'info' },
    challenge: '1.5 months to fulfil the business requirements.',
    solution: 'Prioritised core reporting workflows and developed a design library with autolayout components for rapid design iteration.',
    result: 'While those were done, more iterations would have been helpful to refine their usability.',
  },
  {
    title: 'No User Testing',
    icon: 'flask',
    status: { label: 'Key learning', tone: 'accent' },
    challenge: 'No access to end users for testing.',
    solution: 'Designed familiar patterns (e.g., forms, tables) for intuitive use, and used Grok AI to discuss various design ideas.',
    result: 'Despite the constructive back and forth with AI, it would still have been better to have users test the designs. Another constraint was my short contract period, which meant I had to prioritise UIs.',
  },
];

const framer = 'https://sayhien.framer.website';
const next: NextLink[] = [
  { title: 'AI Chatbot Service', blurb: 'Designed a chatbot page into a clear journey where prospects can test and understand without needing sales.', href: `${framer}/ai-chatbot`, icon: 'chat' },
  { title: 'Swipe Remittance', blurb: 'Redesigned a high dropoff remittance flow into a simple, intuitive experience users actually want to complete.', href: `${framer}/swipe-remittance-app`, icon: 'remit' },
];
---
<CaseStudy
  title="ESG Reporting Module, a UX case study by Loo Say Hien"
  kicker="Case study, Tomie Technologies"
  heading="ESG Reporting Reimagined: Building an Efficient MVP in Record Time"
  lede="Embedded an ESG module into an established ERP SaaS platform to streamline data collection, minimise manual effort, and foster accountability."
  meta={[
    { label: 'Role', value: 'UX Designer, sole designer on the project' },
    { label: 'Timeline', value: '1.5 months, Feb to Apr 2025' },
    { label: 'Responsibilities', value: 'User research and user interface design' },
    { label: 'Product', value: 'Tomie Technologies ERP, ESG module' },
  ]}
  sections={sections}
  next={next}
  heroScene="globe"
>

  <section id="introduction" class="sec">
    <p class="sn">{n('introduction')}</p>
    <h2>Introduction</h2>
    <p class="big">
      In a focused six week design sprint as the project’s only UX designer, I handled user research and interface design to embed an Environmental, Social, and Governance (ESG) module into an established ERP SaaS platform. The goal was to streamline data collection against international standards, minimise manual effort, and foster accountability to attract investors and stakeholders.
    </p>
  </section>

  <section id="problem" class="sec">
    <p class="sn">{n('problem')}</p>
    <h2>Problem Statement</h2>
    <p>
      Companies face increasing pressure from stakeholders to provide transparent reporting on their environmental, social, and governance impacts. However, the complexity of ESG reporting standards, such as GRI (Global Reporting Initiative) and IFRS (International Financial Reporting Standards), coupled with the volume of data required from across the business, makes this process challenging and time consuming.
    </p>
    <h3 class="sub">Existing solutions often…</h3>
    <EsgProblemList answer="We needed an integrated solution that would simplify ESG reporting by connecting directly to existing ERP data and providing an intuitive interface for managing the reporting process." />
  </section>

  <section id="discovery" class="sec">
    <p class="sn">{n('discovery')}</p>
    <h2>Discovery and Requirements Gathering</h2>
    <p>
      The initial phase involved getting the business requirements from the entrepreneur, and understanding the complex reporting frameworks (GRI and IFRS) and how they would integrate with the existing ERP system.
    </p>
    <ul class="logos">
      <li><span class="logo-tile"><Image src={gri} alt="" widths={[240]} sizes="120px" /></span><p><b>GRI</b> covers broad environmental, social and governance impacts.</p></li>
      <li><span class="logo-tile"><Image src={ifrs} alt="" widths={[240]} sizes="120px" /></span><p><b>IFRS</b> covers the financial side of sustainability.</p></li>
    </ul>
    <h3 class="sub">Key requirements identified</h3>
    <EsgRequirements />
  </section>

  <section id="personas" class="sec">
    <p class="sn">{n('personas')}</p>
    <h2>Personas</h2>
    <p>
      Due to time constraints, and as the sole designer, I used AI to generate these personas to guide the design process. The system needed to serve both managers overseeing the entire reporting process and subject matter experts contributing specific data.
    </p>
    <ul class="personas">
      {personas.map((p) => (
        <li class="persona">
          <Image src={p.img} alt={`Portrait of ${p.name}, ${p.role}`} widths={[240, 400]} sizes="(max-width: 600px) 96px, 160px" />
          <div class="p-body">
            <h3>{p.name}</h3>
            <p class="p-role">{p.role}</p>
            <p class="p-quote">“{p.quote}”</p>
            <ul>{p.goals.map((g) => <li>{g}</li>)}</ul>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section id="journey-map" class="sec">
    <p class="sn">{n('journey-map')}</p>
    <h2>Journey Map</h2>
    <p>
      While I developed extensive personas and journey maps with AI to guide the ESG module design, I prioritised my boss’s requirements as the primary framework. Even so, the pain points surfaced by the AI deliverables were matched by the solutions in his business requirements.
    </p>
    <JourneyMap />
    <h3 class="sub">Top pain points, and how the design answers them</h3>
    <EsgPainPoints items={painPoints} />
  </section>

  <section id="information-architecture" class="sec">
    <p class="sn">{n('information-architecture')}</p>
    <h2>Information Architecture</h2>
    <blockquote>Given the complexity of the reporting frameworks, creating a clear, logical structure was crucial to create a common reporting template.</blockquote>
    <p>
      The design unified GRI and IFRS by mapping their hierarchical layers, where “Standard” in GRI corresponds to “Disclosure” in IFRS, enabling a shared interface despite different terminology.
    </p>
    <EsgHierarchy />
  </section>

  <EarthScene mode="arcs" class="chapter-band">
    <div class="chapter">
      <p class="chapter-eyebrow">From research to product</p>
      <p class="chapter-line">Requirements set. Now the product takes shape.</p>
    </div>
  </EarthScene>

  <section id="dashboard" class="sec">
    <p class="sn">{n('dashboard')}</p>
    <h2>Dashboard</h2>
    <p class="big">The Dashboard is the nerve center for ESG managers, built around three core principles.</p>
    <EsgQuestions items={dashboardQuestions} />
    <EsgDashboardTour
      image={dashboard}
      alt="ESG dashboard for the Q2 2025 reporting cycle, with completed, in progress and not done counts, a status distribution donut, compliance confidence of 82 percent, upcoming deadlines, user workload and the GRI Standards Progress Tracker table"
      spots={dashboardSpots}
    />
    <p class="hint">Tap a number to see what that part of the dashboard does.</p>
  </section>

  <section id="user-assignment" class="sec">
    <p class="sn">{n('user-assignment')}</p>
    <h2>User Assignment</h2>
    <p>Managers assign specific reporting standards to team members with appropriate permission levels. This established accountability and ownership for reporting tasks, while ensuring specialised knowledge is applied to relevant areas.</p>
    <div class="feature-row">
      <div><EsgFeatureList items={assignmentFeatures} /></div>
      <YouTube id="d7-WI0sSvRE" title="User assignment prototype workflow" />
    </div>
  </section>

  <section id="data-synchronisation" class="sec">
    <p class="sn">{n('data-synchronisation')}</p>
    <h2>Data Synchronisation</h2>
    <p>
      Data synchronisation integrates information from other modules, such as HR and Finance, into the ESG module. This ensures ESG reporting reflects the latest data across departments, streamlining compliance with frameworks like GRI and IFRS.
    </p>
    <div class="feature-row flip">
      <div><EsgFeatureList items={syncFeatures} /></div>
      <YouTube id="2UIcLZA6ojM" title="Data synchronisation prototype" />
    </div>
  </section>

  <section id="frameworks" class="sec">
    <p class="sn">{n('frameworks')}</p>
    <h2>GRI and IFRS Reporting</h2>
    <p>The system supports both frameworks through one reporting interface. Switch between them to see each prototype.</p>
    <EsgFrameworkTabs frameworks={frameworks} features={frameworkFeatures} />
  </section>

  <section id="progress-tracking" class="sec">
    <p class="sn">{n('progress-tracking')}</p>
    <h2>Progress Tracking</h2>
    <p>The status tracking system provides visibility into reporting progress for a standard. The interface highlights:</p>
    <div class="feature-row flip">
      <div><EsgFeatureList items={trackingFeatures} /></div>
      <YouTube id="-_-ZWn_tVnE" title="Progress tracking prototype" />
    </div>
    <h3 class="sub">Seven statuses, one glance</h3>
    <ul class="status-legend">
      {statuses.map((st) => (
        <li class={`st st-${st.tone}`}>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            {st.shape === 'ring' && <circle cx="8" cy="8" r="5.5" />}
            {st.shape === 'target' && <><circle cx="8" cy="8" r="5.5" /><circle cx="8" cy="8" r="2" class="fill" /></>}
            {st.shape === 'check' && <><circle cx="8" cy="8" r="6.5" class="fill" /><path d="m5 8.3 2 2 4-4.3" class="on-fill" /></>}
            {st.shape === 'alert' && <><circle cx="8" cy="8" r="6.5" class="fill" /><path d="M8 4.8v3.6M8 11v.1" class="on-fill" /></>}
            {st.shape === 'dash' && <><circle cx="8" cy="8" r="5.5" stroke-dasharray="2.5 2" /></>}
            {st.shape === 'flag' && <path d="M4 14V2.5M4 3h7l-1.5 2.5L11 8H4" />}
            {st.shape === 'slash' && <><circle cx="8" cy="8" r="5.5" /><path d="m4.2 11.8 7.6-7.6" /></>}
          </svg>
          {st.label}
        </li>
      ))}
    </ul>
  </section>

  <section id="collaborative-review" class="sec">
    <p class="sn">{n('collaborative-review')}</p>
    <h2>Collaborative Review</h2>
    <p>The system includes communication tools for collaborative reporting. The chat feature allows users to:</p>
    <div class="feature-row">
      <div><EsgFeatureList items={reviewFeatures} /></div>
      <YouTube id="s0F4ljXiGm0" title="Collaborative review prototype" />
    </div>
  </section>

  <section id="challenges" class="sec learn-sec">
    <div class="learn-head">
      <p class="sn">{n('challenges')}</p>
      <h2>Challenges and Learnings</h2>
      <p class="learn-sub">What worked, what didn’t, and what goes back into the loop next time.</p>
    </div>
    <ol class="challenges" data-challenges>
      {challenges.map((c) => (
        <li>
          <div class="ch-head">
            <h3><span class="ch-icon"><Icon name={c.icon} size={22} /></span>{c.title}</h3>
            <p class:list={['stamp', `tone-${c.status.tone}`]}>
              <span class="visually-hidden">Status: </span>{c.status.label}{c.status.note && <small>{c.status.note}</small>}
            </p>
          </div>
          <dl class="flow">
            <div><dt><Icon name="alert" size={14} />Challenge</dt><dd>{c.challenge}</dd></div>
            <div><dt><Icon name="bulb" size={14} />Solution</dt><dd>{c.solution}</dd></div>
            <div><dt><Icon name="target" size={14} />Result</dt><dd>{c.result}</dd></div>
          </dl>
        </li>
      ))}
    </ol>
  </section>
</CaseStudy>

<script>
  import { onFirstView, restartClass } from '../components/motion';
  // Stamps slam onto the challenge results when the list scrolls in.
  document.querySelectorAll<HTMLElement>('[data-challenges] > li').forEach((card) => onFirstView(card, () => restartClass(card), 0.5));
</script>

<style>
  .sec { padding: 72px 0; border-top: 1px solid var(--line); scroll-margin-top: 24px; }
  .sec:first-child { border-top: 0; padding-top: 0; }
  .sn { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.08em; color: var(--accent); margin-bottom: 14px; }
  .sec h2 { font-size: clamp(32px, 3.4vw, 46px); margin-bottom: 24px; }
  .sec > p { color: var(--text-2); font-size: 18px; line-height: 1.7; max-width: 700px; }
  .sec > p + p { margin-top: 20px; }
  .sec > p.big { font-family: var(--display); font-size: clamp(22px, 2vw, 27px); line-height: 1.45; color: var(--text); max-width: 780px; letter-spacing: -0.01em; }
  .sub { font-size: 24px; margin: 48px 0 20px; }






  figure { margin: 36px 0 0; }
  figcaption { font-size: 14px; color: var(--muted); margin-top: 12px; }


  blockquote { margin: 0 0 24px; font-family: var(--display); font-size: clamp(22px, 2vw, 27px); line-height: 1.45; max-width: 760px; padding-left: 24px; border-left: 2px solid var(--accent-line); letter-spacing: -0.01em; }




  .logos { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .logos li { display: flex; align-items: center; gap: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; }
  .logo-tile { flex: none; width: 112px; background: #fff; border-radius: 8px; padding: 8px 10px; } /* logos are drawn for white */
  .logos :global(img) { width: 100%; height: auto; }
  .logos p { font-size: 15px; line-height: 1.45; color: var(--text-2); }
  .logos b { color: var(--text); }

  .personas { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .persona { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 20px; align-items: start; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }
  .persona :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; }
  .p-body { display: grid; gap: 6px; }
  .persona h3 { font-size: 22px; }
  .p-role { font-size: 13px; color: var(--accent); font-weight: 600; letter-spacing: 0.02em; }
  .p-quote { font-family: var(--display); font-style: italic; font-size: 17px; line-height: 1.4; color: var(--text); margin: 4px 0 6px; padding-left: 12px; border-left: 2px solid var(--accent-line); }
  .persona ul { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.5; color: var(--text-2); }
  .persona li + li { margin-top: 3px; }

  .hint { font-size: 14px; color: var(--muted); margin-top: 12px; }

  .status-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .st { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px 6px 10px; }
  .st svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; color: var(--tone); }
  .st .fill { fill: var(--tone); stroke: none; }
  .st .on-fill { stroke: var(--on-accent); stroke-width: 1.8; }
