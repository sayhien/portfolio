---
// A larger animated picture for a table row. It explains the row at a glance
// and is decorative, because the row text says the same in words. The picture
// only moves while it is on screen, and rests still with reduced motion.
import { rowArt } from './row-art';
import type { RowArtName } from './row-art';

interface Props { name: RowArtName }
const { name } = Astro.props;
---
<span class="row-art" data-row-art aria-hidden="true">
  <svg viewBox="0 0 48 48" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={rowArt[name]} />
</span>

<style is:global>
  .row-art { flex: none; width: 76px; height: 76px; border-radius: 16px; display: grid; place-items: center; color: var(--accent); background: radial-gradient(circle at 30% 25%, rgba(110, 231, 183, 0.16), var(--accent-soft) 70%); border: 1px solid rgba(110, 231, 183, 0.18); }
  .row-art svg { overflow: visible; }
  .row-art .d { stroke: var(--muted); }
  .row-art .f { fill: rgba(110, 231, 183, 0.2); }
  .row-art .s { fill: currentColor; stroke: none; }

  /* Everything waits until the picture is on screen, then loops slowly. Offset with --i inside a scene and --n between rows. */
  .row-art [class*='a-'] { animation-duration: 4.800s; animation-iteration-count: infinite; animation-timing-function: ease-in-out; animation-play-state: paused; animation-delay: calc(var(--i, 0) * 0.5s); transform-box: fill-box; transform-origin: center; }
  .row-art.is-live [class*='a-'] { animation-play-state: running; }
  .row-art .a-orbit { animation-name: art-orbit; animation-duration: 14s; animation-timing-function: linear; transform-box: view-box; transform-origin: 24px 24px; }
  .row-art .a-dot { animation-name: art-blink; animation-duration: 1.800s; }
  .row-art .a-packet { animation-name: art-packet; animation-duration: 3s; }
  .row-art .a-progress { animation-name: art-progress; stroke-dasharray: 1 1; }
  .row-art .a-blink { animation-name: art-blink; }
  .row-art .a-bob { animation-name: art-bob; animation-duration: 2.400s; }
  .row-art .a-flow { animation-name: art-flow; animation-duration: 1.200s; animation-timing-function: linear; }
  .row-art .a-scan { animation-name: art-scan; }
  .row-art .a-press { animation-name: art-press; animation-duration: 3s; }
  .row-art .a-lit { animation-name: art-lit; animation-duration: 4.500s; }
  .row-art .a-tag { animation-name: art-tag; }
  .row-art .a-open { animation-name: art-open; transform-origin: top; }
  .row-art .a-shift { animation-name: art-shift; }
  .row-art .a-rows { animation-name: art-rows; animation-timing-function: steps(3, jump-none); }
  .row-art .a-msg { animation-name: art-msg; }
  .row-art .a-chip { animation-name: art-chip; animation-duration: 4.500s; }
  .row-art .a-glow { animation-name: art-glow; }
  .row-art .a-check { animation-name: art-progress; stroke-dasharray: 1 1; }
  .row-art .a-spin { animation-name: art-orbit; animation-duration: 8s; animation-timing-function: linear; transform-box: view-box; transform-origin: 24px 24px; }
  .row-art .a-ping { animation-name: art-ping; animation-duration: 2.800s; animation-timing-function: ease-out; }
  .row-art .a-nudge { animation-name: art-nudge; animation-duration: 1.800s; }
  .row-art .a-ring { animation-name: art-ring; stroke-dasharray: 1 1; stroke-width: 3; }
  .row-art .a-card { animation-name: art-card; animation-duration: 3.600s; }
  .row-art .a-click { animation-name: art-click; animation-duration: 3.600s; }
  .row-art .a-cursor { animation-name: art-cursor; animation-duration: 3.600s; transform-box: view-box; transform-origin: 0 0; }
  .row-art .a-hand { animation-name: art-sweep; transform-box: view-box; transform-origin: 24px 24px; animation-timing-function: linear; animation-duration: 6s; }
  .row-art .a-bar { animation-name: art-bar; transform-origin: bottom; }
  .row-art .a-exit { animation-name: art-exit; animation-duration: 2.400s; }

  @keyframes art-orbit { to { transform: rotate(360deg); } }
  @keyframes art-blink { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
  @keyframes art-packet { 0% { transform: translateX(0); opacity: 0; } 15% { opacity: 1; } 70% { transform: translateX(11px); opacity: 1; } 100% { transform: translateX(12px); opacity: 0; } }
  @keyframes art-progress { 0% { stroke-dashoffset: 1; } 60%, 90% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -1; } }
  @keyframes art-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }
  @keyframes art-flow { to { stroke-dashoffset: -5; } }
  @keyframes art-scan { 0% { transform: translateY(0); } 33% { transform: translateY(7px); } 66% { transform: translateY(14px); } 100% { transform: translateY(21px); } }
  @keyframes art-press { 0%, 55%, 100% { transform: scale(1); } 65% { transform: scale(0.88); } 80% { transform: scale(1.06); } }
  @keyframes art-lit { 0%, 100% { opacity: 0.25; } 25%, 50% { opacity: 1; } }
  @keyframes art-tag { 0%, 100% { transform: translateX(-10px); opacity: 0; } 30%, 70% { transform: translateX(0); opacity: 1; } }
  @keyframes art-open { 0%, 15% { transform: scaleY(0.05); opacity: 0; } 40%, 85% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(0.05); opacity: 0; } }
  @keyframes art-shift { 0%, 15%, 100% { transform: translateY(-9px); } 40%, 85% { transform: translateY(0); } }
  @keyframes art-rows { 0% { transform: translateY(0); } 100% { transform: translateY(17px); } }
  @keyframes art-msg { 0%, 20% { opacity: 0; transform: translateY(4px); } 40%, 85% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; } }
  @keyframes art-chip { 0%, 100% { fill: transparent; stroke: var(--muted); } 15%, 40% { fill: rgba(110, 231, 183, 0.35); stroke: var(--accent); } 55% { fill: transparent; stroke: var(--muted); } }
  @keyframes art-glow { 0%, 100% { fill: rgba(110, 231, 183, 0.1); } 50% { fill: rgba(110, 231, 183, 0.32); } }
  @keyframes art-ping { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.3, 1.9); opacity: 0; } }
  @keyframes art-nudge { 0%, 100% { transform: translateX(-1px); } 50% { transform: translateX(3px); } }
  @keyframes art-ring { 0% { stroke-dashoffset: 1; } 55%, 90% { stroke-dashoffset: 0.6; } 100% { stroke-dashoffset: 1; } }
  @keyframes art-card { 0%, 40%, 100% { fill: transparent; stroke: var(--muted); } 50%, 85% { fill: rgba(110, 231, 183, 0.3); stroke: var(--accent); } }
  @keyframes art-click { 0%, 40% { transform: scale(0.3); opacity: 0; } 45% { opacity: 1; } 75%, 100% { transform: scale(2.8); opacity: 0; } }
  @keyframes art-cursor { 0%, 8% { transform: translate(34px, 40px); } 38%, 55% { transform: translate(22px, 20px); } 100% { transform: translate(34px, 40px); } }
  @keyframes art-sweep { to { transform: rotate(360deg); } }
  @keyframes art-bar { 0%, 15% { transform: scaleY(1); } 55%, 85% { transform: scaleY(0.64); } 100% { transform: scaleY(1); } }
  @keyframes art-exit { 0%, 100% { transform: translateX(0); opacity: 1; } 60% { transform: translateX(3px); opacity: 0.4; } }

  /* With reduced motion every scene rests in a state that still reads. */
  @media (prefers-reduced-motion: reduce) {
    .row-art [class*='a-'] { animation: none !important; }
    .row-art .a-progress, .row-art .a-check { stroke-dasharray: none; }
    .row-art .a-ring { stroke-dasharray: 0.4 1; }
  }
</style>

<script>
  // Pictures only move while they are on screen.
  const pictures = document.querySelectorAll<HTMLElement>('[data-row-art]');
  const watcher = new IntersectionObserver((entries) => {
    entries.forEach((entry) => entry.target.classList.toggle('is-live', entry.isIntersecting));
  }, { rootMargin: '60px' });
  pictures.forEach((picture) => watcher.observe(picture));
</script>
