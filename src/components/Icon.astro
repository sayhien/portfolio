---
// Shared line icons (24px grid, stroke based) so every section uses one
// consistent icon style. Decorative by default; pass a label to expose it.
export const iconPaths = {
  alert: 'M12 3.5 2.5 20h19ZM12 10v4.5M12 17.2v.1',
  bulb: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z',
  check: 'm5 12.5 4.5 4.5L19 7.5',
  docs: 'M7 3.5h7.5L19 8v12.5H7ZM14.5 3.5V8H19M10 12h6M10 15.5h6M4.5 6.5v15h11',
  code: 'm8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14',
  clock: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM12 7.5V12l3 2',
  flask: 'M9.5 3.5h5M10.5 3.5v6L5 19a1.5 1.5 0 0 0 1.3 2h11.4A1.5 1.5 0 0 0 19 19l-5.5-9.5v-6M7.5 15h9',
  pending: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17ZM8 12h.1M12 12h.1M16 12h.1',
  spark: 'M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6',
  person: 'M12 11.5a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5ZM5 20a7 7 0 0 1 14 0',
  tool: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5 2.5-2.5Z',
  calendar: 'M5 6h14v14H5zM5 10h14M9 3v4M15 3v4',
  flag: 'M5 21V4M5 4h11l-2 4 2 4H5',
  text: 'M5 6h14M5 10h14M5 14h9M5 18h6',
  rise: 'M5 17 10 12l3 3 6-7M14 8h5v5',
} as const;

export type IconName = keyof typeof iconPaths;

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className } = Astro.props;
---
<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
><path d={iconPaths[name]} /></svg>
