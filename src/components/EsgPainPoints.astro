---
// Top pain points, each paired with a live miniature of the feature that
// solves it. The miniatures are decorative (aria-hidden); the written
// pain point and solution carry the meaning for every reader.
export type PainPoint = {
  pain: string;
  fix: string;
  to: string;
  linkLabel: string;
  widget: 'assign' | 'sync' | 'chat';
};
interface Props {
  items: PainPoint[];
}
const { items } = Astro.props;
---
<ol class="c1" data-painpoints>
  {items.map((item) => (
    <li>
      <div class="copy">
        <div class="pain">
          <span class="lbl"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 2.5 20h19ZM12 10v4.5M12 17.2v.1" /></svg>Pain point</span>
          <p>{item.pain}</p>
        </div>
        <div class="fix">
          <span class="lbl"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z" /></svg>Solution</span>
          <p>{item.fix}</p>
          <a href={`#${item.to}`}>{item.linkLabel} <span aria-hidden="true">&darr;</span></a>
        </div>
      </div>
      {item.widget === 'assign' && (
        <div class="widget" aria-hidden="true" data-widget="assign">
          <div class="wtitle"><span>GRI 2 assignees</span><span>Permission</span></div>
        </div>
      )}
      {item.widget === 'sync' && (
        <div class="widget" aria-hidden="true" data-widget="sync">
          <div class="wtitle"><span>Synchronise data</span><span class="sync-ic"><svg viewBox="0 0 24 24"><path d="M4.5 11a7.5 7.5 0 0 1 13.2-4.3L20 9M20 4v5h-5M19.5 13a7.5 7.5 0 0 1-13.2 4.3L4 15M4 20v-5h5" /></svg></span></div>
          <div class="depts"></div>
          <div class="fields"></div>
          <span class="sample">Sample values</span>
        </div>
      )}
      {item.widget === 'chat' && (
        <div class="widget" aria-hidden="true" data-widget="chat">
          <div class="wtitle"><span>Disclosure 2-1, legal name</span><span class="pill p-acc chat-status">Flagged</span></div>
          <div class="chat"></div>
        </div>
      )}
    </li>
  ))}
</ol>

<style>
  .c1 { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--gap-card); }
  .c1 > li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 32px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; }
  .copy { display: grid; gap: 20px; }
  .pain, .fix { display: grid; gap: 8px; }
  .lbl { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  .lbl svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .pain .lbl { color: var(--danger); }
  .fix .lbl { color: var(--accent); }
  .copy p { font-size: 17px; line-height: 1.5; color: var(--text); }
  .fix a { font-size: 14px; font-weight: 600; color: var(--accent); }

  .widget { background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 12px; font-size: 12px; display: grid; gap: 8px; color: var(--text-2); min-width: 0; }
  .wtitle { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .widget :global(.av) { width: 24px; height: 24px; border-radius: 999px; display: grid; place-items: center; font-size: 10px; font-weight: 700; color: var(--on-accent); flex: none; }
  .widget :global(.pill) { display: inline-block; font-size: 11px; font-weight: 700; border-radius: 999px; padding: 2px 9px; white-space: nowrap; letter-spacing: 0; text-transform: none; }
  .widget :global(.p-good) { background: var(--accent-soft); color: var(--accent); }
  .widget :global(.p-info) { background: var(--info-soft); color: var(--info); }
  .widget :global(.p-warn) { background: var(--warn-soft); color: var(--warn); }
  .widget :global(.p-acc) { background: var(--accent-soft); color: var(--accent); }
  .widget :global(.arow) { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 4px 0; }
  .widget :global(.who) { display: flex; align-items: center; gap: 8px; min-width: 0; font-weight: 500; color: var(--text); }
  .widget :global(.who small) { display: block; font-weight: 400; color: var(--muted); font-size: 11px; }
  .widget :global(.flip) { animation: flip 0.45s ease-out; }
  @keyframes flip { 50% { transform: rotateX(90deg); } }

  .depts { display: flex; flex-wrap: wrap; gap: 5px; }
  .widget :global(.dept) { border: 1px solid var(--line-2); border-radius: 999px; padding: 3px 9px; font-weight: 600; font-size: 11px; color: var(--muted); transition: background 0.3s, color 0.3s, border-color 0.3s, box-shadow 0.3s; }
  .widget :global(.dept.on) { background: var(--accent); border-color: var(--accent); color: var(--on-accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .widget :global(.chat-status) { min-width: 76px; text-align: center; } /* same width for Flagged and Resolved, so the title never rewraps */
  .sync-ic { display: inline-flex; color: var(--accent); }
  .sync-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sync-ic:global(.spin) svg { animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .fields { display: grid; gap: 5px; }
  /* Each row keeps room for a two line label, so the box never grows as departments change */
  .widget :global(.field) { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 8px; align-items: center; min-height: 32px; }
  .widget :global(.field span) { line-height: 1.3; }
  .widget :global(.field span) { font-size: 11px; color: var(--text-2); }
  .widget :global(.field b) { display: block; min-height: 24px; border: 1px solid var(--line-2); border-radius: 6px; padding: 3px 8px; background: var(--surface); font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text); font-size: 12px; transition: border-color 0.3s, background 0.3s; }
  .widget :global(.field b.typing) { border-color: var(--accent); }
  .widget :global(.field b.done) { background: var(--accent-soft); border-color: transparent; }
  .sample { font-size: 10px; color: var(--muted); }

  /* Fixed height: new messages push old ones out the top instead of growing the box */
  .chat { display: grid; gap: 6px; align-content: end; height: 220px; overflow: hidden; }
  .widget :global(.msg) { display: flex; gap: 6px; align-items: flex-end; max-width: 88%; animation: msg-in 0.3s ease-out; }
  .widget :global(.msg.me) { justify-self: end; flex-direction: row-reverse; }
  .widget :global(.bub) { background: var(--surface-2); border-radius: 10px 10px 10px 3px; padding: 6px 9px; color: var(--text); line-height: 1.35; }
  .widget :global(.msg.me .bub) { background: var(--accent-soft); border-radius: 10px 10px 3px 10px; }
  .widget :global(.msg .av) { width: 20px; height: 20px; font-size: 8px; }
  .widget :global(.dots) { display: inline-flex; gap: 3px; padding: 3px 0; }
  .widget :global(.dots i) { width: 5px; height: 5px; border-radius: 999px; background: var(--muted); animation: blink 1s infinite; }
  .widget :global(.dots i:nth-child(2)) { animation-delay: 0.15s; }
  .widget :global(.dots i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes blink { 0%, 100% { opacity: 0.25; } 40% { opacity: 1; } }
  @keyframes msg-in { from { opacity: 0; transform: translateY(6px); } }

  @media (max-width: 1000px) {
    .c1 > li { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
  @media (max-width: 600px) {
    .c1 > li { padding: 20px; }
  }
</style>

<script>
  import { prefersReducedMotion, restartClass, sleepWhileActive, trackVisibility } from './motion';

  type State = { visible: boolean };

  // Permissions in the assignment widget change every 2 seconds.
  function setupAssign(widget: HTMLElement, state: State) {
    const statuses = [['Edit', 'p-info'], ['Review', 'p-good'], ['Read only', 'p-warn'], ['Approve', 'p-acc']];
    const people = [
      { name: 'Emily Carter', role: 'Compliance', color: '#b4a3ff', status: 0 },
      { name: 'Raj Patel', role: 'IT', color: 'var(--accent)', status: 1 },
      { name: "Michael O'Connor", role: 'Sustainability', color: '#f6a46b', status: 2 },
    ];
    const pills = people.map((person) => {
      const row = document.createElement('div');
      row.className = 'arow';
      const initials = person.name.split(' ').map((word) => word[0]).join('').slice(0, 2);
      row.innerHTML = `<span class="who"><span class="av" style="background:${person.color}">${initials}</span><span>${person.name}<small>${person.role}</small></span></span><span class="pill"></span>`;
      widget.appendChild(row);
      return row.querySelector<HTMLElement>('.pill')!;
    });
    const render = (index: number) => {
      const [label, tone] = statuses[people[index].status];
      pills[index].className = `pill ${tone}`;
      pills[index].textContent = label;
    };
    people.forEach((_, index) => render(index));
    return async () => {
      while (true) {
        await sleepWhileActive(2000, state);
        for (let index = 0; index < people.length; index++) {
          people[index].status = (people[index].status + 1) % statuses.length;
          render(index);
          restartClass(pills[index], 'flip');
          await sleepWhileActive(250, state);
        }
      }
    };
  }

  // Departments take turns: the badge lights up, then its fields fill in.
  function setupSync(widget: HTMLElement, state: State) {
    const departments = [
      { name: 'HR', fields: [['Total employees', '1,248'], ['Women in workforce', '46%'], ['Training hours per employee', '32 h'], ['Employee turnover', '11.4%'], ['Work related injuries', '3']] },
      { name: 'Finance', fields: [['Revenue', 'SGD 84.2M'], ['Taxes paid', 'SGD 6.1M'], ['Community investment', 'SGD 420K'], ['Green capital spend', 'SGD 2.3M'], ['Payments to suppliers', 'SGD 31.5M']] },
      { name: 'Supply chain', fields: [['Suppliers screened', '78%'], ['Local supplier spend', '64%'], ['Supplier audits', '41'], ['High risk suppliers', '6'], ['Scope 3 emissions', '12,400 tCO2e']] },
      { name: 'Operations', fields: [['Energy used', '18,600 MWh'], ['Renewable energy', '27%'], ['Water withdrawn', '52,000 m3'], ['Waste diverted', '71%'], ['Scope 1 and 2', '8,950 tCO2e']] },
    ];
    const deptBox = widget.querySelector('.depts')!;
    const fieldBox = widget.querySelector('.fields')!;
    const icon = widget.querySelector('.sync-ic')!;
    const badges = departments.map((dept) => {
      const badge = document.createElement('span');
      badge.className = 'dept';
      badge.textContent = dept.name;
      deptBox.appendChild(badge);
      return badge;
    });
    const rows = Array.from({ length: 5 }, () => {
      const row = document.createElement('div');
      row.className = 'field';
      row.innerHTML = '<span></span><b></b>';
      fieldBox.appendChild(row);
      return { label: row.querySelector('span')!, value: row.querySelector('b')! };
    });
    const show = (deptIndex: number, filled: boolean) => {
      badges.forEach((badge, index) => badge.classList.toggle('on', index === deptIndex));
      departments[deptIndex].fields.forEach(([label, value], index) => {
        rows[index].label.textContent = label;
        rows[index].value.textContent = filled ? value : '';
        rows[index].value.className = filled ? 'done' : '';
      });
    };
    show(0, true);
    return async () => {
      let deptIndex = 0;
      while (true) {
        await sleepWhileActive(1800, state);
        deptIndex = (deptIndex + 1) % departments.length;
        show(deptIndex, false);
        icon.classList.add('spin');
        await sleepWhileActive(600, state);
        for (let index = 0; index < rows.length; index++) {
          const value = rows[index].value;
          value.className = 'typing';
          for (const char of departments[deptIndex].fields[index][1]) {
            value.textContent += char;
            await sleepWhileActive(45, state);
          }
          value.className = 'done';
          await sleepWhileActive(120, state);
        }
        icon.classList.remove('spin');
      }
    };
  }

  // A review conversation between the manager and the data provider.
  function setupChat(widget: HTMLElement, state: State) {
    const script = [
      { me: true, text: 'Legal name is flagged. Is "Tomie" the full registered name?' },
      { me: false, text: 'Good catch. It should be Tomie Technologies Inc.' },
      { me: true, text: 'Thanks. Does the HQ address need the suite number too?' },
      { me: false, text: 'Yes, adding it now. Updated both fields.' },
      { me: true, text: 'Looks right. Marking this as resolved.' },
    ];
    const chat = widget.querySelector<HTMLElement>('.chat')!;
    const status = widget.querySelector<HTMLElement>('.chat-status')!;
    const addBubble = (message: { me: boolean }, html: string) => {
      const row = document.createElement('div');
      row.className = message.me ? 'msg me' : 'msg';
      const avatar = message.me
        ? '<span class="av" style="background:var(--text)">EM</span>'
        : '<span class="av" style="background:var(--accent)">RP</span>';
      row.innerHTML = `${avatar}<span class="bub">${html}</span>`;
      chat.appendChild(row);
      while (chat.children.length > 4) chat.firstElementChild?.remove();
      return row;
    };
    const setResolved = (resolved: boolean) => {
      status.textContent = resolved ? 'Resolved' : 'Flagged';
      status.className = `pill chat-status ${resolved ? 'p-good' : 'p-acc'}`;
    };
    script.slice(0, 2).forEach((message) => addBubble(message, message.text));
    return async () => {
      while (true) {
        await sleepWhileActive(1200, state);
        chat.innerHTML = '';
        setResolved(false);
        for (const message of script) {
          const row = addBubble(message, '<span class="dots"><i></i><i></i><i></i></span>');
          await sleepWhileActive(1100, state);
          row.querySelector('.bub')!.textContent = message.text;
          await sleepWhileActive(1300, state);
        }
        setResolved(true);
        await sleepWhileActive(1800, state);
      }
    };
  }

  const setups = { assign: setupAssign, sync: setupSync, chat: setupChat };
  document.querySelectorAll<HTMLElement>('[data-painpoints]').forEach((list) => {
    const state = prefersReducedMotion() ? { visible: false } : trackVisibility(list);
    list.querySelectorAll<HTMLElement>('[data-widget]').forEach((widget) => {
      const kind = widget.dataset.widget as keyof typeof setups;
      const run = setups[kind](widget, state);
      if (!prefersReducedMotion()) run();
    });
  });
</script>
