---
import Base from '../layouts/Base.astro';
import ProjectTile from '../components/ProjectTile.astro';
import SpaceHero from '../components/SpaceHero.astro';
import { site, projects } from '../data/site';

const left = projects.filter((_, i) => i % 2 === 0);
const right = projects.filter((_, i) => i % 2 === 1);
---
<Base title={`${site.name}, UI/UX Designer`}>
  <SpaceHero eyebrow={site.role} heading={site.heroLine} intro={site.intro} />

  <section class="wrap work" id="work" aria-labelledby="work-title">
    <div class="work-head">
      <h2 id="work-title">Selected work</h2>
      <p>{projects.length} case studies</p>
    </div>
    <div class="masonry">
      <div class="col">
        {left.map((p) => <ProjectTile project={p} index={projects.indexOf(p)} />)}
      </div>
      <div class="col">
        {right.map((p) => <ProjectTile project={p} index={projects.indexOf(p)} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  /* The work rises over the tail of the swoosh, so there is no empty sky to scroll through */
  .work { position: relative; z-index: 1; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.space-hero:not(.no-space)) ~ .work { margin-top: -45vh; }
  }
  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .work-head h2 { font-size: 40px; }
  .work-head p { font-size: 14px; color: var(--muted); }

  /* Two staggered columns, kept to 70% of the full width and centred */
  .masonry {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 45px;
    align-items: start;
    max-width: 1300px; /* two columns of about 630px */
    margin: 0 auto;
  }
  .col { display: flex; flex-direction: column; gap: 40px; }
  .col:nth-child(2) { padding-top: 96px; }

  @media (max-width: 900px) {
    .masonry { display: flex; flex-direction: column; gap: 24px; max-width: none; }
    .col { display: contents; }
    .col:nth-child(2) { padding-top: 0; }
    .work-head h2 { font-size: 32px; }
  }
</style>
