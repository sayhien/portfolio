---
// "Existing solutions often…" list. Each problem has a mini illustration
// that loops: it shows the problem, then turns into the fix the module
// delivered. Illustrations are decorative; the text carries the meaning.
interface Props {
  answer: string;
}
const { answer } = Astro.props;
---
<div class="problems" data-problems>
  <ul class="plist">
    <li>
      <div class="vig" aria-hidden="true">
        <span class="badge"><svg viewBox="0 0 12 12"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5" /></svg></span>
        <svg class="ill" viewBox="0 0 160 120">
          <g class="prob">
            <rect class="vf" x="44" y="72" width="72" height="13" rx="3" />
            <rect class="vf" x="36" y="57" width="88" height="13" rx="3" />
            <rect class="vf" x="46" y="42" width="68" height="13" rx="3" />
            <rect class="vf" x="40" y="27" width="80" height="13" rx="3" />
            <text class="vtb" x="80" y="103" text-anchor="middle">1,500 pages</text>
          </g>
          <g class="fix">
            <rect class="vw" x="40" y="26" width="80" height="62" rx="6" />
            <rect class="vf" x="50" y="38" width="42" height="6" rx="3" />
            <rect class="vw" x="50" y="50" width="60" height="10" rx="3" />
            <rect class="vw" x="50" y="66" width="60" height="10" rx="3" />
            <circle class="vgf" cx="118" cy="28" r="10" />
            <path class="tick" d="m113 28 3.5 3.5 6-7" />
            <text class="vtg" x="80" y="104" text-anchor="middle">Guided form</text>
          </g>
        </svg>
      </div>
      <p>Require specialised knowledge of ESG frameworks</p>
    </li>
    <li>
      <div class="vig" aria-hidden="true">
        <span class="badge"><svg viewBox="0 0 12 12"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5" /></svg></span>
        <svg class="ill" viewBox="0 0 160 120">
          <circle class="vf" cx="34" cy="48" r="12" /><path class="vf" d="M14 88a20 20 0 0 1 40 0Z" />
          <circle class="vf" cx="126" cy="48" r="12" /><path class="vf" d="M106 88a20 20 0 0 1 40 0Z" />
          <g class="prob">
            <path class="vs" d="M56 56h48" />
            <circle cx="80" cy="56" r="10" class="vbg" />
            <path class="va" d="m75 51 10 10M85 51l-10 10" />
          </g>
          <g class="fix">
            <path class="vg" d="M56 60h48" />
            <rect class="vgs" x="58" y="22" width="44" height="24" rx="8" />
            <path class="vgf" d="M70 46l-4 7 9-7Z" />
            <path class="vgl" d="M66 31h28M66 37h18" />
          </g>
        </svg>
      </div>
      <p>Lack intuitive interfaces for collaborative reporting</p>
    </li>
    <li>
      <div class="vig" aria-hidden="true">
        <span class="badge"><svg viewBox="0 0 12 12"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5" /></svg></span>
        <svg class="ill" viewBox="0 0 160 120">
          <g class="prob">
            <rect class="vf" x="20" y="58" width="120" height="14" rx="7" />
            <rect class="vstall" x="20" y="58" width="41" height="14" rx="7" />
            <text class="vq" x="104" y="48" text-anchor="middle">?</text>
          </g>
          <g class="fix">
            <rect x="20" y="58" width="18" height="14" rx="4" class="vgf" />
            <rect x="40" y="58" width="42" height="14" rx="4" class="vif" />
            <rect x="84" y="58" width="56" height="14" rx="4" class="vaf" />
            <text class="vtx" x="29" y="88" text-anchor="middle">15%</text>
            <text class="vtx" x="61" y="88" text-anchor="middle">35%</text>
            <text class="vtx" x="112" y="88" text-anchor="middle">50%</text>
            <text class="vtg" x="80" y="44" text-anchor="middle">Status at a glance</text>
          </g>
        </svg>
      </div>
      <p>Provide limited visibility into reporting progress</p>
    </li>
    <li>
      <div class="vig" aria-hidden="true">
        <span class="badge"><svg viewBox="0 0 12 12"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5" /></svg></span>
        <svg class="ill" viewBox="0 0 160 120">
          <g class="boxl"><rect class="vf" x="14" y="38" width="50" height="40" rx="6" /><text class="vtx" x="39" y="62" text-anchor="middle">ERP</text></g>
          <g class="boxr"><rect class="vf" x="96" y="38" width="50" height="40" rx="6" /><text class="vtx" x="121" y="62" text-anchor="middle">ESG tool</text></g>
          <g class="prob">
            <circle cx="80" cy="58" r="10" class="vbg" />
            <path class="va" d="m75 53 10 10M85 53l-10 10" />
          </g>
          <g class="fix">
            <rect x="54" y="52" width="52" height="12" rx="6" class="vgf" />
            <text class="vwhite" x="80" y="61" text-anchor="middle">CONNECTED</text>
            <text class="vtg" x="80" y="100" text-anchor="middle">ESG inside the ERP</text>
          </g>
        </svg>
      </div>
      <p>Exist as standalone systems, disconnected from operational data</p>
    </li>
  </ul>
  <p class="answer">
    <span class="answer-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
    {answer}
  </p>
</div>

<style>
  .problems { display: grid; gap: 20px; margin-top: 28px; max-width: 760px; }
  .plist { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .plist li { display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 24px; align-items: center; }
  .plist p { font-size: 17px; color: var(--text-2); }
  .vig { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); padding: 4px; }
  .badge { position: absolute; right: -6px; top: -6px; width: 22px; height: 22px; border-radius: 999px; background: var(--accent); border: 2px solid var(--bg); display: grid; place-items: center; }
  .badge svg { width: 12px; height: 12px; stroke: var(--on-accent); stroke-width: 2.4; fill: none; stroke-linecap: round; }
  .ill { width: 100%; height: 100%; display: block; overflow: visible; }
  .ill :global(*) { transform-box: fill-box; transform-origin: center; }

  .vf { fill: var(--surface-2); stroke: var(--line-2); stroke-width: 1.5; }
  .vw { fill: var(--surface); stroke: var(--line-2); stroke-width: 1.5; }
  .vbg { fill: var(--surface); }
  .vs { fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; }
  .va { fill: none; stroke: var(--accent); stroke-width: 2.6; stroke-linecap: round; }
  .vg { fill: none; stroke: var(--accent); stroke-width: 2.6; stroke-linecap: round; }
  .vgl { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; }
  .vgf { fill: var(--accent); }
  .vgs { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .vaf { fill: var(--accent); }
  .vif { fill: var(--info); }
  .vstall { fill: var(--line-2); }
  .tick { fill: none; stroke: var(--on-accent); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .vtx { font-family: var(--sans); font-size: 10px; fill: var(--muted); }
  .vtb { font-family: var(--sans); font-size: 11px; font-weight: 700; fill: var(--accent); }
  .vtg { font-family: var(--sans); font-size: 10px; font-weight: 700; fill: var(--accent); }
  .vwhite { font-family: var(--sans); font-size: 8px; font-weight: 700; fill: var(--surface); }
  .vq { font-family: var(--display); font-size: 28px; font-weight: 600; fill: var(--accent); }

  /* At rest (and for reduced motion) the problem state shows. */
  .fix { opacity: 0; }
  /* Problem, then fix: loops only while on screen. */
  .is-live .prob { animation: prob-phase 6s ease-in-out infinite; }
  .is-live .fix { animation: fix-phase 6s ease-in-out infinite; }
  .is-live .boxl { animation: merge-left 6s ease-in-out infinite; }
  .is-live .boxr { animation: merge-right 6s ease-in-out infinite; }
  @keyframes prob-phase { 0%, 42% { opacity: 1; transform: none; } 50%, 92% { opacity: 0; transform: scale(0.85); } 100% { opacity: 1; transform: none; } }
  @keyframes fix-phase { 0%, 46% { opacity: 0; transform: scale(0.85); } 54%, 92% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes merge-left { 0%, 42% { transform: none; } 52%, 92% { transform: translateX(22px); } 100% { transform: none; } }
  @keyframes merge-right { 0%, 42% { transform: none; } 52%, 92% { transform: translateX(-22px); } 100% { transform: none; } }

  .answer { display: flex; gap: 14px; align-items: center; background: var(--accent-soft); color: var(--text); border-radius: var(--radius); padding: 16px 18px; font-weight: 600; line-height: 1.5; }
  .answer-icon { width: 40px; height: 40px; border-radius: 999px; background: var(--accent); display: grid; place-items: center; flex: none; }
  .answer-icon svg { width: 22px; height: 22px; fill: none; stroke: var(--on-accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 600px) {
    .plist li { grid-template-columns: 120px minmax(0, 1fr); gap: 14px; }
    .plist p { font-size: 15px; }
  }
</style>

<script>
  import { trackVisibility } from './motion';
  document.querySelectorAll<HTMLElement>('[data-problems]').forEach((el) => trackVisibility(el));
</script>
