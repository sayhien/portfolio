---
// Small animated badge that hints at what a case study is about.
// Decorative only; the card title carries the meaning.
export type CaseIconKind = 'chat' | 'remit' | 'report' | 'library' | 'crumb' | 'globe' | 'cake';
interface Props {
  kind: CaseIconKind;
}
const { kind } = Astro.props;
---
<span class:list={['case-icon', `k-${kind}`]} aria-hidden="true">
  {kind === 'chat' && (
    <svg viewBox="0 0 48 48">
      <path class="bubble" d="M9 12h30a3 3 0 0 1 3 3v15a3 3 0 0 1-3 3H21l-8 7v-7H9a3 3 0 0 1-3-3V15a3 3 0 0 1 3-3Z" />
      <circle class="dot d1" cx="17" cy="22.5" r="2.4" />
      <circle class="dot d2" cx="24" cy="22.5" r="2.4" />
      <circle class="dot d3" cx="31" cy="22.5" r="2.4" />
    </svg>
  )}
  {kind === 'remit' && (
    <svg viewBox="0 0 48 48">
      <rect class="phone" x="6" y="9" width="16" height="30" rx="3" />
      <path class="track" d="M24 24h14" />
      <path class="home" d="M33 22 40 16l7 6v11H33Z" />
      <circle class="coin" cx="22" cy="24" r="4.2" />
      <path class="coin-mark" d="M22 21.6v4.8" />
    </svg>
  )}
  {kind === 'report' && (
    <svg viewBox="0 0 48 48">
      <rect class="sheet" x="10" y="7" width="28" height="34" rx="3" />
      <rect class="bar b1" x="16" y="26" width="4" height="9" rx="1" />
      <rect class="bar b2" x="22" y="20" width="4" height="15" rx="1" />
      <rect class="bar b3" x="28" y="15" width="4" height="20" rx="1" />
    </svg>
  )}
  {kind === 'library' && (
    <svg viewBox="0 0 48 48">
      <rect class="block" x="8" y="28" width="14" height="12" rx="2" />
      <rect class="block" x="26" y="28" width="14" height="12" rx="2" />
      <rect class="block drop" x="17" y="9" width="14" height="12" rx="2" />
    </svg>
  )}
  {kind === 'crumb' && (
    <svg viewBox="0 0 48 48">
      <path class="chev" d="M15 19l5 5-5 5M29 19l5 5-5 5" />
      <circle class="crumb c1" cx="8" cy="24" r="3.4" />
      <circle class="crumb c2" cx="24" cy="24" r="3.4" />
      <circle class="crumb c3" cx="40" cy="24" r="3.4" />
    </svg>
  )}
  {kind === 'cake' && (
    <svg viewBox="0 0 48 48">
      <rect class="sheet" x="9" y="28" width="30" height="12" rx="2" />
      <rect class="sheet" x="14" y="19" width="20" height="9" rx="2" />
      <path class="candle" d="M24 12v7" />
      <path class="flame" d="M24 4c2.2 2.6 2.4 4.6 0 6.4-2.4-1.8-2.2-3.8 0-6.4Z" />
      <circle class="berry" cx="18" cy="17.5" r="2.6" />
      <circle class="berry b-2" cx="30" cy="17.5" r="2.6" />
    </svg>
  )}
  {kind === 'globe' && (
    <svg viewBox="0 0 48 48">
      <circle class="sheet" cx="24" cy="24" r="16" />
      <path class="meridian" d="M24 8c-6 5-6 27 0 32M24 8c6 5 6 27 0 32M9 19h30M9 29h30" />
    </svg>
  )}
</span>

<style>
  .case-icon { width: 52px; height: 52px; flex: none; border-radius: 14px; background: var(--accent-soft); display: grid; place-items: center; }
  .case-icon svg { width: 36px; height: 36px; overflow: visible; }
  .case-icon :global(*) { transform-box: fill-box; transform-origin: center; }

  .bubble, .phone, .home, .sheet { fill: var(--surface); stroke: var(--accent); stroke-width: 2.2; stroke-linejoin: round; }
  .dot { fill: var(--accent); animation: typing 1.4s ease-in-out infinite; }
  .d2 { animation-delay: 0.18s; } .d3 { animation-delay: 0.36s; }
  @keyframes typing { 0%, 60%, 100% { transform: translateY(0); opacity: 0.45; } 30% { transform: translateY(-4px); opacity: 1; } }

  .track { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 2 4; stroke-linecap: round; }
  .coin { fill: var(--accent); animation: send 2.4s ease-in-out infinite; }
  .coin-mark { stroke: var(--on-accent); stroke-width: 1.6; stroke-linecap: round; animation: send 2.4s ease-in-out infinite; }
  .home { animation: receive 2.4s ease-in-out infinite; }
  @keyframes send { 0%, 10% { transform: translateX(0); opacity: 0; } 20% { opacity: 1; } 70% { transform: translateX(16px); opacity: 1; } 80%, 100% { transform: translateX(16px); opacity: 0; } }
  @keyframes receive { 0%, 68% { transform: none; } 76% { transform: scale(1.12); } 86%, 100% { transform: none; } }

  .bar { fill: var(--accent); transform-origin: bottom; animation: grow 2.6s ease-in-out infinite; }
  .b2 { animation-delay: 0.2s; } .b3 { animation-delay: 0.4s; }
  @keyframes grow { 0%, 100% { transform: scaleY(0.4); } 40%, 70% { transform: scaleY(1); } }


  .block { fill: var(--surface); stroke: var(--accent); stroke-width: 2.2; }
  .drop { fill: var(--accent); animation: snap 2.6s ease-in-out infinite; }
  @keyframes snap { 0%, 15% { transform: translateY(-6px); opacity: 0; } 40%, 85% { transform: translateY(0); opacity: 1; } 100% { opacity: 0; } }

  .chev { fill: none; stroke: var(--line-2); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .crumb { fill: var(--surface); stroke: var(--accent); stroke-width: 2; animation: here 2.4s ease-in-out infinite; }
  .c2 { animation-delay: 0.4s; } .c3 { animation-delay: 0.8s; }
  @keyframes here { 0%, 100% { fill: var(--surface); } 20%, 40% { fill: var(--accent); } }

  .meridian { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; animation: turn 6s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }

  .candle { fill: none; stroke: var(--accent); stroke-width: 2.2; stroke-linecap: round; }
  .flame { fill: var(--warn); transform-origin: bottom; animation: flicker 1.2s ease-in-out infinite; }
  .berry { fill: var(--accent); animation: drop 3s ease-in-out infinite; }
  .b-2 { animation-delay: 0.5s; }
  @keyframes flicker { 0%, 100% { transform: scale(1, 1); } 50% { transform: scale(0.85, 1.15); } }
  @keyframes drop { 0%, 10% { transform: translateY(-10px); opacity: 0; } 30%, 85% { transform: translateY(0); opacity: 1; } 100% { opacity: 0; } }

  /* Lift slightly when its card is hovered */
  .case-icon { transition: transform 0.3s; }
  :global(a:hover) .case-icon { transform: rotate(-6deg) scale(1.06); }
</style>
